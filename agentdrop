def main() -> None:
    if len(sys.argv) > 1 and sys.argv[1] in COMMANDS:
        _console_safe()
        sys.exit(COMMANDS[sys.argv[1]](sys.argv[2:]))
    parser = argparse.ArgumentParser(
        description="Deploy shared AI-agent rules without overwriting harness-specific instructions."
    )
    parser.add_argument("target", nargs="?", help="Project directory, or one of: sync, edit")
    parser.add_argument("--install", action="store_true", help="Install agentdrop command and sync global rules")
    parser.add_argument("--dry-run", action="store_true", help="Show what would change")
    parser.add_argument("--docs", choices=DOCS_MODES,
                        help="Where project docs live: track (in the code repo), separate (local "
                             ".git-docs in the same folder) or local (ignored, no history). "
                             "Saved per repo; asked on the first run if omitted")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--research", dest="research", action="store_true", default=None,
                      help="Turn on research mode: asks, hypotheses and claims registries, skeptic")
    mode.add_argument("--no-research", dest="research", action="store_false",
                      help="Turn research mode off (keeps its files)")
    args = parser.parse_args()
    _console_safe()

    if args.install:
        install_self(dry=args.dry_run)
        return

    if args.target in ("sync", "global"):
        sync_globals(dry=args.dry_run)
        return

    if args.target in ("edit", "common"):
        open_common()
        return

    if not args.target:
        cwd = Path.cwd().resolve()

        # `agentdrop --dry-run` is deliberately non-interactive and previews CWD.
        if args.dry_run:
            bootstrap_project(cwd, dry=True, docs=args.docs, research=args.research)
            return

        print(f"\nAgentDrop will bootstrap/sync the current directory:\n  {cwd}\n")
        print("It will:")
        print("  - preserve existing harness/project instructions")
        print("  - put the docs charter into AGENTS.md (shared rules stay global)")
        print("  - add/update harness bridges without overwriting their own instructions")
        print("  - create missing docs/ skeleton, review-intake skill and docs guard (~/.agentdrop/kit)")
        print("  - on first setup, ask whether this is a research project (--research / --no-research)")
        print("  - back up any existing file before AgentDrop changes it")
        print("  - ask whether the docs go into this repo, a local .git-docs, or nowhere (git repos only)")
        print("\nIt will NOT initialize the project's Git, commit automatically, or overwrite project memory.")

        try:
            answer = input("\nProceed? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nCancelled.")
            return

        if answer not in {"y", "yes"}:
            print("Cancelled.")
            return

        bootstrap_project(cwd, dry=False, docs=args.docs, research=args.research)
        return

    bootstrap_project(Path(args.target), dry=args.dry_run, docs=args.docs, research=args.research)


if __name__ == "__main__":
    main()
