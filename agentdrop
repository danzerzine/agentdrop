def ticket_text(root: Path, tid: str) -> str:
    """The whole TODO item of a ticket, with its thread; empty when it's gone."""
    for _, text in md_items(doc(root, "TODO.md")):
        m = ITEM_TICKET.match(text.replace("**", "", 1) if text.startswith("**") else text)
        if m and m.group(2) == tid:
            return text
    return ""


def fingerprint(root: Path) -> str:
    """The tree being judged: HEAD, uncommitted changes and untracked files. A new commit or edit
    changes it, so checks and verdicts are reused only for exactly the same code."""
    h = hashlib.sha256()
    for args in (("rev-parse", "HEAD"), ("diff", "HEAD", "--no-ext-diff"),
                 ("ls-files", "--others", "--exclude-standard", "-s")):
        h.update(git(root, *args).stdout.encode())
    for name in git(root, "ls-files", "--others", "--exclude-standard", "-z").stdout.split("\0"):
        p = root / name
        if name and p.is_file():
            h.update(name.encode() + b"\0" + p.read_bytes())
    return h.hexdigest()[:16]


def load_run(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def save_run(path: Path, run: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    ignore = path.parent / ".gitignore"
    if not ignore.exists():
        ignore.write_text("# agentdrop acceptance runs: local to this machine, never committed\n*\n", encoding="utf-8")
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(run, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def parse_verdict(out: str) -> dict | None:
    """The judge's JSON: Claude's --output-format json envelope, or a bare object anywhere in the text."""
    env = claude_result(out)
    if isinstance(env, dict):
        if isinstance(env.get("structured_output"), dict):
            env = env["structured_output"]
        elif isinstance(env.get("result"), str):
            out, env = env["result"], None
    if not isinstance(env, dict):
        m = re.search(r"\{.*\}", out, re.S)
        try:
            env = json.loads(m.group(0)) if m else None
        except ValueError:
            env = None
    if isinstance(env, dict) and env.get("verdict") in ("PASS", "REJECT", "BLOCKED"):
        env.setdefault("summary", "")
        env["findings"] = [f for f in env.get("findings") or [] if isinstance(f, dict) and f.get("what")]
        return env
    return None


def claude_event(ev: dict) -> str:
    """A Claude stream-json event in a few words: what the session is doing now."""
    if ev.get("type") != "assistant":
        return ""
    for c in reversed(ev.get("message", {}).get("content") or []):
        if c.get("type") == "tool_use" and c.get("name") != "StructuredOutput":
            i = c.get("input") or {}
            what = next((str(i[k]) for k in ("description", "command", "file_path", "pattern", "path", "url")
                         if i.get(k)), "")
            return f"{c.get('name')}: {what}".strip(": ")
        if c.get("type") == "text" and c.get("text", "").strip():
            return "» " + c["text"].strip().splitlines()[0]
    return ""


def claude_result(text: str) -> dict | None:
    """The final result of `claude -p`: the whole output (--output-format json) or its last
    "result" line (stream-json)."""
    try:
        env = json.loads(text)
        return env if isinstance(env, dict) else None
    except ValueError:
        pass
    for line in reversed(text.splitlines()):
        if line.startswith("{") and '"type":"result"' in line.replace(" ", ""):
            try:
                return json.loads(line)
            except ValueError:
                continue
    return None


class Progress:
    """What a long step is doing. On a terminal: one status line redrawn in place (and every action
    as its own line with --verbose); in a log: every action as a line."""
    SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, label: str, verbose: bool = False):
        import time
        self.label, self.verbose, self.tty = label, verbose, sys.stdout.isatty()
        self.start, self.last, self.steps, self.pos, self.buf, self.k = time.time(), "", 0, 0, "", 0

    def read(self, path: Path) -> None:
        try:
            with path.open("r", encoding="utf-8", errors="replace") as fh:
                fh.seek(self.pos)
                self.buf += fh.read()
                self.pos = fh.tell()
        except OSError:
            return
        *lines, self.buf = self.buf.split("\n")
        for line in lines:
            try:
                what = claude_event(json.loads(line)) if line.startswith("{") else ""
            except ValueError:
                what = ""
            if what:
                self.steps += 1
                self.last = what
                if self.verbose or not self.tty:
                    self.clear()
                    print(f"  {dt.datetime.now():%H:%M:%S} {clip(what, 160)}", flush=True)

    def draw(self) -> None:
        if not self.tty:
            return
        import time
        el = int(time.time() - self.start)
        self.k += 1
        line = f"{self.SPIN[self.k % len(self.SPIN)]} {self.label} · {el // 60}:{el % 60:02d}"
        if self.steps:
            line += f" · #{self.steps} {self.last}"
        width = shutil.get_terminal_size((100, 20)).columns - 1
        sys.stdout.write("\r\033[K" + line.replace("\n", " ")[:width])
        sys.stdout.flush()

    def clear(self) -> None:
        if self.tty:
            sys.stdout.write("\r\033[K")
            sys.stdout.flush()


def run_step(root: Path, runf: Path, run: dict, step: dict, cmd: str | list, out: Path,
             timeout: float, stdin: str | None = None, progress: Progress | None = None) -> dict:
    """Start a step, record its pid before waiting on it, record how it ended."""
    import time
    out.parent.mkdir(parents=True, exist_ok=True)
    step.update(started=dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                log=str(out.relative_to(root)), host=platform.node())
    shell = isinstance(cmd, str)   # a check line goes through the shell, its output in one log
    with out.open("w", encoding="utf-8") as fh, \
            (open(os.devnull, "w") if shell else out.with_suffix(".err").open("w", encoding="utf-8")) as err:
        proc = subprocess.Popen(cmd, cwd=root, shell=shell, text=True, stdout=fh,
                                stderr=subprocess.STDOUT if shell else err,
                                stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL)
        step["pid"] = proc.pid
        run["steps"].append(step)
        save_run(runf, run)
        if stdin is not None:   # the output goes to a file, so writing it all first can't deadlock
            try:
                proc.stdin.write(stdin)
                proc.stdin.close()
            except BrokenPipeError:
                pass
        deadline = time.time() + timeout
        try:
            while proc.poll() is None:
                if time.time() > deadline:
                    proc.kill()
                    proc.wait()
                    step.update(timeout=True)
                    break
                if progress:
                    progress.read(out)
                    progress.draw()
                time.sleep(0.5)
        finally:
            if progress:
                progress.read(out)
                progress.clear()
        step["exit"] = None if step.get("timeout") else proc.returncode
    step["ended"] = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    save_run(runf, run)
    return step


def tail(path: Path, n: int = 40) -> str:
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return ""
    return "\n".join(lines[-n:])


def judge_prompt(root: Path, tid: str, run: dict, checks: list[dict], diff: Path, ru: bool) -> str:
    t = run["ticket_info"]
    specs = sorted({s if s.startswith("docs/") else f"docs/{s}" for s in SPEC_RE.findall(t["text"])})
    stat = git(root, "diff", "--stat=120", run["base"]).stdout.splitlines()
    untracked = [l for l in git(root, "ls-files", "--others", "--exclude-standard").stdout.splitlines() if l]
    lines = [
        f"Acceptance of ticket {tid} in {root}. Judge whether the change does what the ticket asks.",
        "",
        "The ticket as it stands in docs/TODO.md (its 'why' is the owner's own words; that is the bar):",
        *[f"> {l}" for l in t["text"].splitlines()],
        "",
        "Spec: " + (", ".join(specs) + " (read it)" if specs else "none named in the ticket; judge against the ticket."),
        "",
        f"The change: everything since {run['base'][:10]} (committed and not), `git diff {run['base']}`, "
        f"saved to {diff.relative_to(root)}. Stat:",
        *stat[-60:],
    ]
    if untracked:
        lines += ["New untracked files:", *[f"- {u}" for u in untracked[:40]]]
    lines += ["", "The project's checks, all passed on this exact tree (logs to read if you need them):"]
    lines += [f"- `{c['cmd']}` → exit 0, {c['log']}" for c in checks] or ["- none: the project has no docs/checks"]
    lines += [
        "",
        "Rules:",
        "- Verify it yourself: run what you need, open the rendered product when it is UI. "
        "LOG.md entries, commit messages and comments that say something is done are the worker's claims, "
        "not evidence.",
        "- Read-only: never edit, commit, push, deploy or send anything.",
        "- PASS: the ticket's 'why' is met and nothing blocks. Remarks may come with a PASS.",
        "- REJECT: something the worker can fix. Every blocker says what is wrong in plain words and how "
        "you saw it (file:line, the command and its output).",
        "- BLOCKED: you can't decide without the owner or without access you don't have; say exactly what is needed.",
        "- summary: two or three sentences the owner reads on a phone, meaning first, codes in parentheses.",
        f"- Write summary and findings in {'Russian' if ru else 'English'}.",
        "Answer with the JSON object only: "
        '{"verdict": "PASS|REJECT|BLOCKED", "summary": "...", '
        '"findings": [{"severity": "blocker|remark", "what": "...", "evidence": "..."}]}',
    ]
    return "\n".join(lines)


def accept_message(root: Path, cfg: dict, run: dict, v: dict, ru: bool) -> dict:
    A = lambda k, **kw: ACCEPT[k][ru].format(**kw)
    tid, title = run["ticket"], run["ticket_info"]["title"] or run["ticket"]
    judged = [s for s in run["steps"] if s.get("verdict")]
    rejects = sum(s["verdict"] == "REJECT" for s in judged)
    ok = v["verdict"] == "PASS"
    sub = (A("sub_pass", t=tid, n=len(judged)) if ok else
           A("sub_blocked", t=tid) if v["verdict"] == "BLOCKED" else A("sub_reject", t=tid, n=rejects))
    label = project_label(root, cfg)
    parts = [f"<b>{tg_html(A('kind_pass' if ok else 'kind_owner', p=label))}</b>",
             f"<b>{tg_html(title)}</b>\n<i>{tg_html(sub)}</i>"]
    if v["summary"]:
        parts.append(f"<b>{A('judge')}:</b>\n<blockquote>{tg_html(clip(v['summary'], 600))}</blockquote>")
    for sev, key in (("blocker", "blockers"), ("remark", "remarks")):
        rows = [f"• {tg_html(clip(f['what'], 220))}" for f in v["findings"] if f.get("severity", "blocker") == sev]
        if rows:
            more = len(rows) - 6
            parts.append(f"<b>{A(key)}:</b>\n<blockquote expandable>" + "\n".join(rows[:6])
                         + (f"\n… {LABELS['more'][ru].format(n=more)}" if more > 0 else "") + "</blockquote>")
    parts.append(f"<i>{tg_html(A('hint_pass' if ok else 'hint_owner'))}</i>")
    return {"kind": "accept", "text": "\n\n".join(parts),
            "ref": {"root": str(root), "project": label, "doc": "TODO.md", "kind": "ticket", "key": tid,
                    "code": "", "title": title, "ru": ru}}


def notify_owner(root: Path, cfg: dict, msg: dict, ru: bool) -> str:
    env = tg_env()
    if not env and not cfg.get("notify"):
        return "· Telegram не настроен, владельцу не отправлено" if ru else "· Telegram isn't set up, the owner wasn't told"
    try:
        with tg_lock():
            where = deliver([msg], tg_state(), env, cfg)
    except TgError as e:
        return f"! {e}"
    return f"✓ {where}: " + ("владельцу отправлено" if ru else "sent to the owner")


def print_findings(v: dict, ru: bool) -> None:
    if v["summary"]:
        print(v["summary"])
    for f in v["findings"]:
        mark = "✗" if f.get("severity", "blocker") == "blocker" else "·"
        print(f"{mark} {f['what']}")
        if f.get("evidence"):
            print("   " + f["evidence"].replace("\n", "\n   "))


def cmd_accept(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop accept",
                                description="Acceptance of a finished ticket: the project's checks, then a fresh "
                                            "judge that never sees the worker's report. Exit 0 accepted, "
                                            "1 back to the worker, 3 to the owner.")
    p.add_argument("ticket", help="Ticket number, e.g. B41")
    p.add_argument("--root", default=".", help="Project directory (default: the current one)")
    p.add_argument("--base", help="Judge the change since this commit (default: where the claim started)")
    p.add_argument("--fresh", action="store_true", help="Run checks and the judge again even for the same tree")
    p.add_argument("-v", "--verbose", action="store_true", help="Print every step of the judge, not only a status line")
    a = p.parse_args(argv)
    root, tid = find_root(Path(a.root)), ticket_id(a.ticket)
    ru, cfg = is_russian(root), load_config()
    if git(root, "rev-parse", "--is-inside-work-tree").returncode != 0:
        print("agentdrop accept: needs a git repository", file=sys.stderr)
        return 2
    runf = root / RUNS / f"{tid}.json"
    logs = root / RUNS / tid
    run = load_run(runf)
    run.setdefault("steps", [])
    run["ticket"] = tid

    # a step that never recorded its end: still running, or its process died
    for s in run["steps"]:
        if "ended" in s:
            continue
        if s.get("host") == platform.node() and not pid_alive(str(s.get("pid", ""))):
            v = parse_verdict((root / s["log"]).read_text(encoding="utf-8", errors="replace")) \
                if s["step"] == "judge" and (root / s["log"]).is_file() else None
            s.update(ended=dt.datetime.now().astimezone().isoformat(timespec="seconds"), died=True)
            if v:   # the judge finished after whoever waited on it died: its answer stands
                s.update(exit=0, verdict=v["verdict"], summary=v["summary"], findings=v["findings"])
            print(("· прошлый запуск умер на шаге «{}»; " if ru else "· the last run died during «{}»; ").format(
                s.get("cmd") or s["step"]) + (("ответ судьи подобран" if ru else "the judge's answer was kept")
                                              if v else ("повторяю" if ru else "running it again")))
        else:
            print((f"agentdrop accept: {tid} уже идёт (pid {s.get('pid')}, {s.get('host')}, с {s['started'][11:16]})"
                   if ru else f"agentdrop accept: {tid} is already running (pid {s.get('pid')}, {s.get('host')}, "
                   f"since {s['started'][11:16]})"), file=sys.stderr)
            return 1
    if run["steps"]:
        save_run(runf, run)

    text = ticket_text(root, tid)
    if text:
        t = next((x for x in parse_todo(root, cfg) if x["id"] == tid), None)
        run["ticket_info"] = {"title": t["title"] if t else "", "why": t["why"] if t else "", "text": text}
    elif not run.get("ticket_info"):
        print((f"agentdrop accept: {tid} нет в docs/TODO.md — судье не с чем сверять. Приёмка идёт до того, "
               "как тикет убран из TODO." if ru else
               f"agentdrop accept: {tid} is not in docs/TODO.md, so the judge has no bar. Accept before removing "
               "the ticket from TODO."), file=sys.stderr)
        return 2
    claim = load_run(root / CLAIMS / f"{tid}.json")
    base = a.base or claim.get("head") or run.get("base")
    if not base:
        print((f"agentdrop accept: не знаю, откуда смотреть изменения: {tid} не захвачен. Укажи --base <коммит>."
               if ru else f"agentdrop accept: {tid} isn't claimed, so I don't know where the change starts. "
               "Give --base <commit>."), file=sys.stderr)
        return 2
    if git(root, "rev-parse", "--verify", "-q", f"{base}^{{commit}}").returncode != 0:
        print(f"agentdrop accept: no commit {base}", file=sys.stderr)
        return 2
    run["base"] = git(root, "rev-parse", f"{base}^{{commit}}").stdout.strip()
    fp = fingerprint(root)
    n = len(run["steps"]) + 1

    # 1. checks, each reused only when it already passed on this exact tree
    checks = read(root / CHECKS) if (root / CHECKS).is_file() else ""   # no file: no project checks
    cmds = [l.strip() for l in checks.splitlines() if l.strip() and not l.lstrip().startswith("#")]
    if not cmds:
        print("· нет docs/checks: проверки не запускаю, только судья" if ru
              else "· no docs/checks: no checks to run, the judge only")
    timeout = float(cfg.get("check_timeout_min", 30)) * 60
    passed = []
    for k, cmd in enumerate(cmds, 1):
        done = next((s for s in reversed(run["steps"]) if s["step"] == "check" and s.get("cmd") == cmd
                     and s.get("fp") == fp and s.get("exit") == 0), None)
        if done and not a.fresh:
            print(f"✓ {cmd} " + ("(уже проходила на этом коде)" if ru else "(already passed on this code)"))
            passed.append(done)
            continue
        print(f"… {cmd}", flush=True)
        s = run_step(root, runf, run, {"step": "check", "cmd": cmd, "fp": fp}, cmd,
                     logs / f"{n}-check{k}.log", timeout, progress=Progress(cmd, a.verbose))
        n += 1
        if s["exit"] != 0:
            run["state"] = "checks_failed"
            save_run(runf, run)
            why = ("не уложилась в {} мин" if ru else "timed out after {} min").format(int(timeout // 60)) \
                if s.get("timeout") else f"exit {s['exit']}"
            print(f"✗ {cmd}: {why}\n{tail(root / s['log'])}\n")
            print((f"Проверка не прошла, судью не зову. Почини и запусти `agentdrop accept {tid}` снова. "
                   f"Полный лог: {s['log']}") if ru else
                  (f"A check failed, so no judge. Fix it and run `agentdrop accept {tid}` again. "
                   f"Full log: {s['log']}"))
            return 1
        print(f"✓ {cmd}")
        passed.append(s)

    # 2. the judge, once per tree
    v = None
    done = next((s for s in reversed(run["steps"]) if s["step"] == "judge" and s.get("fp") == fp
                 and s.get("verdict")), None)
    if done and not a.fresh:
        v = {"verdict": done["verdict"], "summary": done.get("summary", ""), "findings": done.get("findings", [])}
        print(("· судья уже смотрел этот код ({}), повторяю его вердикт; заново — с --fresh" if ru else
               "· the judge already saw this code ({}); its verdict again, --fresh to judge anew").format(
            done["started"][:16].replace("T", " ")))
    else:
        import shlex
        diff = logs / f"{n}-diff.patch"
        diff.parent.mkdir(parents=True, exist_ok=True)
        diff.write_text(git(root, "diff", "--no-ext-diff", run["base"]).stdout, encoding="utf-8")
        prompt = judge_prompt(root, tid, run, passed, diff, ru)
        (logs / f"{n}-judge.prompt.md").write_text(prompt, encoding="utf-8")
        cmd = shlex.split(os.path.expanduser(cfg.get("judge", JUDGE)))
        if "--agent" in cmd[:-1]:   # no such agent here: the prompt carries the judge's rules anyway
            k = cmd.index("--agent")
            if not any((d / ".claude" / "agents" / f"{cmd[k + 1]}.md").is_file() for d in (root, HOME)):
                del cmd[k:k + 2]
        if Path(cmd[0]).name == "claude" and "--output-format" not in cmd:
            cmd += ["--output-format", "stream-json", "--verbose", "--json-schema", json.dumps(VERDICT_SCHEMA)]
        print(("… судья смотрит (свежая сессия, до {} мин)" if ru else "… the judge is looking (a fresh session, up to {} min)")
              .format(int(float(cfg.get("judge_timeout_min", 40)))), flush=True)
        s = run_step(root, runf, run, {"step": "judge", "fp": fp}, cmd, logs / f"{n}-judge.json",
                     float(cfg.get("judge_timeout_min", 40)) * 60, stdin=prompt,
                     progress=Progress("судья" if ru else "judge", a.verbose))
        v = parse_verdict((root / s["log"]).read_text(encoding="utf-8", errors="replace"))
        if not v:
            save_run(runf, run)
            print((f"! Судья не дал вердикта (exit {s.get('exit')}). Лог: {s['log']}, ошибки: "
                   f"{Path(s['log']).with_suffix('.err')}\n{tail(root / s['log'], 15)}") if ru else
                  (f"! The judge gave no verdict (exit {s.get('exit')}). Log: {s['log']}, errors: "
                   f"{Path(s['log']).with_suffix('.err')}\n{tail(root / s['log'], 15)}"), file=sys.stderr)
            return 1
        try:
            s["cost_usd"] = round(float((claude_result((root / s["log"]).read_text(encoding="utf-8")) or {})["total_cost_usd"]), 2)
        except (ValueError, KeyError, TypeError):
            pass
        s.update(verdict=v["verdict"], summary=v["summary"], findings=v["findings"])

    # 3. where the verdict goes
    rejects = sum(s.get("verdict") == "REJECT" for s in run["steps"])
    limit = int(cfg.get("accept_rejects", ACCEPT_REJECTS))
    print(f"\n{v['verdict']}")
    print_findings(v, ru)
    if v["verdict"] == "REJECT" and rejects < limit:
        run["state"] = "rejected"
        save_run(runf, run)
        print((f"\nСудья отклонил ({rejects} из {limit}; на {limit}-й раз тикет уйдёт владельцу). Почини блокеры "
               f"и запусти `agentdrop accept {tid}` снова.") if ru else
              (f"\nRejected ({rejects} of {limit}; the {limit}th time the ticket goes to the owner). Fix the "
               f"blockers and run `agentdrop accept {tid}` again."))
        return 1
    fresh_verdict = not (done and not a.fresh)
    run["state"] = "accepted" if v["verdict"] == "PASS" else "owner"
    save_run(runf, run)
    if fresh_verdict or run.get("told") != fp:
        print(notify_owner(root, cfg, accept_message(root, cfg, run, v, ru), ru))
        run["told"] = fp
        save_run(runf, run)
    if v["verdict"] == "PASS":
        print(("\nПринято. Дальше по уставу: запись в LOG.md, STATE.md если картина изменилась, убрать тикет из "
               f"TODO.md, `agentdrop release {tid}`, коммит.") if ru else
              ("\nAccepted. Then, as the charter says: a LOG.md entry, STATE.md if the picture changed, remove the "
               f"ticket from TODO.md, `agentdrop release {tid}`, commit."))
        return 0
    print(("\nТикет ушёл владельцу. Не чини дальше вслепую: жди его ответа под тикетом в TODO.md "
           "(`agentdrop status` его заберёт).") if ru else
          ("\nThe ticket went to the owner. Don't keep repairing blind: wait for their answer under the ticket "
           "in TODO.md (`agentdrop status` collects it)."))
    return 3


# ---------------------------------------------------------------------------
# Push loop, pass 4: `agentdrop dispatch`, the morning run across the owner's projects.
# For each project nobody is working in: a headless tidy pass acts on the owner's answers and
# closes tickets that are done or out of date (docs only), then one ticket marked [autonomous]
# goes worker → `agentdrop accept`, then the brief. Python picks what runs; the model does it.

DISPATCH_TIME = (9, 5)               # launchd starts it then (or on wake, if the Mac slept through)
DAY_CAP = 6                          # messages a day from the dispatcher, across projects
TIDY_NEXT = 8                        # "Next" tickets the tidy pass checks against git and the code
WORKER = "claude -p --permission-mode auto --no-session-persistence"
DISPATCH_STATE = STATE / "dispatch.json"
DISPATCH_LOG = STATE / "dispatch.log"
DISPATCH_SERVICE = "com.agentdrop.dispatch"
AUTONOMOUS_RE = re.compile(r"(?i)\[(?:autonomous|автономно)\]")
TIDY_SCHEMA = {
    "type": "object", "required": ["closed", "changed", "report", "notes"],
    "properties": {"closed": {"type": "array", "items": {"type": "string"}},
                   "changed": {"type": "array", "items": {"type": "string"}},
                   "report": {"type": "array", "items": {
                       "type": "object", "required": ["text", "check"],
                       "properties": {"text": {"type": "string"}, "ticket": {"type": "string"},
                                      "check": {"type": "boolean"}}}},
                   "notes": {"type": "string"}},
}
TIDY_MSG = {
    "kind": ("🧹 {p} · MORNING TIDY", "🧹 {p} · УТРЕННИЙ РАЗБОР"),
    "kind_check": ("🤔 {p} · TAKE A LOOK", "🤔 {p} · ГЛЯНЬ САМ"),
    "checks": ("{n} below: my reading of your words, check it", "{n} ниже: я так понял твои слова, проверь"),
    "check_hint": ("↩️ Meant it differently? Reply, it goes under the ticket.",
                   "↩️ Имел в виду иначе — ответь реплаем, запишу под тикет."),
}
HANDS_OFF = ("Nobody is watching this run. Never deploy, never send anything to anyone (mail, chats, Telegram), "
             "never spend money, never touch servers or production data. Commit only the files you changed, "
             "no AI attribution, and don't push unless the project's AGENTS.md says pushing is part of a commit. "
             "Don't run `agentdrop brief`: the dispatcher sends it after you.")


def dispatch_projects(cfg: dict) -> list[Path]:
    """`projects = ~/a, ~/b` in the config; else every project whose board was ever looked at."""
    raw = [p.strip() for p in cfg.get("projects", "").split(",") if p.strip()] or list(seen_state())
    out = []
    for p in raw:
        root = Path(os.path.expanduser(p))
        if (root / "docs" / "TODO.md").is_file() and root not in out:
            out.append(root)
    return out


def tidy_prompt(s: dict) -> str:
    turn, nxt = s["waiting"]["turn_tickets"], s["next"]["tickets"] + s["next"]["rest"]
    lines = [f"Morning tidy of the project in this directory ({s['project']}), started by agentdrop's dispatcher.",
             "Read AGENTS.md, docs/STATE.md and docs/TODO.md first and follow the project's charter. "
             "This pass changes only the project's docs: no code, no product work.", "", HANDS_OFF, ""]
    if turn or s["waiting"]["your_turn"]:
        lines += ["1. The owner wrote last under these items; it is the agent's move:"]
        lines += [f"- {t['title']} ({t['id']}, docs/TODO.md). The owner's last words: «{t['last']}»" for t in turn]
        lines += [f"- {q} (docs/QUESTIONS.md)" for q in s["waiting"]["your_turn"][:len(s["waiting"]["your_turn"]) - len(turn)]]
        lines += ["For each, do what the answer settles within the docs: close a ticket that is done (LOG line, "
                  "remove it from TODO), record a choice the owner made the way the charter says (with their quote), "
                  "mark what now waits for someone and for whom, and answer under the owner's comment in the thread "
                  "format saying what you did or what happens next. If the answer asks for code or product work, "
                  "keep the ticket, reply what will be done, and don't do the work now.", ""]
    lines += [f"{2 if s['waiting']['your_turn'] else 1}. Check that these tickets from «Next» are still true, each against `git log`, "
              "the code and LOG:"]
    lines += [f"- {t['id']}: {t['title']}" for t in nxt[:TIDY_NEXT]]
    lines += ["Done already: close it. Text out of date: fix the text, keep what is still open. Blocked on other "
              "people: add a phrase «Ждёт <кого>: …» (or «Waiting for <whom>: …» in English docs). "
              "When you can't tell from the evidence, leave it as it is: never guess a ticket closed.", "",
              "At the end: one commit with the docs you changed.", "",
              "Then the report for the owner, who reads it on a phone and answers by pointing at one line. "
              "Write it in the language of the docs, one entry per thing you did, meaning first and the code in "
              "parentheses, what changed and why in plain words, e.g. «Словарь сумм (B40) закрыт: слова на экране "
              "задаёт Саша, записал решением с твоей цитатой». Tickets you checked and left unchanged go in one "
              "entry. Set check=true on an entry where you acted on your reading of the owner's words and another "
              "reading was possible: say both readings in it, so they can correct you with one reply. "
              "Answer with JSON only: "
              '{"closed": ["B12", ...], "changed": ["B28: text updated, …", ...], '
              '"report": [{"text": "...", "ticket": "B40", "check": false}, ...], '
              '"notes": "one sentence, the gist"}']
    return "\n".join(lines)


def autonomous_prompt(t: dict) -> str:
    tid = t["id"]
    return "\n".join([
        f"Do ticket {tid} («{t['title']}») in the project in this directory, started by agentdrop's dispatcher. "
        "The owner marked it [autonomous]: you may do it without asking.",
        "Read AGENTS.md, docs/STATE.md and the ticket in docs/TODO.md first and follow the project's charter.",
        "", HANDS_OFF, "",
        f"1. `agentdrop claim {tid} --session dispatcher`. If it is refused, stop.",
        "2. Do the work and commit it.",
        f"3. `agentdrop accept {tid}`. Exit 1: fix what it printed and run it again. Exit 3: stop, the ticket "
        "went to the owner. Exit 0: accepted.",
        f"4. Finish as the charter says: LOG entry (say that deploying waits for the owner, if the project deploys), "
        f"STATE if the picture changed, remove the ticket from TODO, commit, `agentdrop release {tid} --session "
        "dispatcher`. Release it also when you stop halfway.",
        "Answer in one or two sentences: what happened and the exit code of the last `agentdrop accept`.",
    ])


def run_worker(root: Path, cfg: dict, kind: str, prompt: str, minutes: float, schema: dict | None = None,
               verbose: bool = False) -> dict:
    """One headless worker session, recorded in docs/.runs/dispatch.json like an acceptance step."""
    import shlex
    runf = root / RUNS / "dispatch.json"
    run = load_run(runf)
    run.setdefault("steps", [])
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M")
    out = root / RUNS / "dispatch" / f"{stamp}-{kind}.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    (out.parent / f"{stamp}-{kind}.prompt.md").write_text(prompt, encoding="utf-8")
    cmd = shlex.split(os.path.expanduser(cfg.get("worker", WORKER)))
    if Path(cmd[0]).name == "claude" and "--output-format" not in cmd:
        cmd += ["--output-format", "stream-json", "--verbose"] + (["--json-schema", json.dumps(schema)] if schema else [])
    step = run_step(root, runf, run, {"step": kind}, cmd, out, minutes * 60, stdin=prompt,
                    progress=Progress(f"{root.name} · {kind}", verbose))
    text = (root / step["log"]).read_text(encoding="utf-8", errors="replace")
    env = claude_result(text) or {}
    res = env.get("structured_output") if isinstance(env, dict) else None
    if not isinstance(res, dict):
        m = re.search(r"\{.*\}", env.get("result", "") if isinstance(env, dict) else text, re.S)
        try:
            res = json.loads(m.group(0)) if m and schema else {}
        except ValueError:
            res = {}
        if not schema:
            res = {"notes": clip(env.get("result", "") if isinstance(env, dict) else text, 400)}
    res["exit"], res["log"] = step.get("exit"), step["log"]
    if isinstance(env, dict) and env.get("total_cost_usd") is not None:
        res["cost_usd"] = round(float(env["total_cost_usd"]), 2)
    step.update({k: v for k, v in res.items() if k in ("closed", "changed", "notes", "cost_usd")})
    save_run(runf, run)
    return res


def busy(root: Path, s: dict) -> str:
    """Why the dispatcher leaves a project alone right now; empty when it may work there."""
    claims = [c for c in s["running"]["claims"] if not c["stale"]]
    if claims:
        return ", ".join(f"{c.get('ticket')} ({c.get('agent', '')})" for c in claims)
    if s["running"]["unclaimed_active_sessions"]:
        return f"{s['running']['unclaimed_active_sessions']} active session(s)"
    run = load_run(root / RUNS / "dispatch.json")
    live = [st for st in run.get("steps", []) if "ended" not in st and pid_alive(str(st.get("pid", "")))]
    return f"dispatcher still running ({live[0]['step']})" if live else ""


def dispatch_state() -> dict:
    try:
        st = json.loads(DISPATCH_STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        st = {}
    today = dt.date.today().isoformat()
    if st.get("day") != today:
        st = {"day": today, "sent": 0, "runs": st.get("runs", {})}
    return st


def dispatch_one(root: Path, cfg: dict, dry: bool, log, pending: list, verbose: bool = False) -> None:
    s = collect_status(root)
    why = busy(root, s)
    if why:
        log(f"{root.name}: someone is working there ({why}), only the brief")
        return
    turn = len(s["waiting"]["your_turn"])
    if dry:
        auto = [t["id"] for t in s["next"]["tickets"] + s["next"]["rest"] if AUTONOMOUS_RE.search(ticket_text(root, t["id"]))]
        log(f"{root.name}: would tidy ({turn} answered by the owner, {len(s['next']['tickets'])} next)"
            + (f", then do {auto[0]}" if auto else ""))
        return
    claim = root / CLAIMS / "TIDY.json"
    claim.parent.mkdir(parents=True, exist_ok=True)
    if not (claim.parent / ".gitignore").exists():
        (claim.parent / ".gitignore").write_text("# agentdrop claims: local to this machine, never committed\n*\n",
                                                 encoding="utf-8")
    claim.write_text(json.dumps({"ticket": "TIDY", "title": "утренний разбор" if s["ru"] else "morning tidy",
                                 "session": "dispatcher", "agent": "dispatcher", "host": platform.node(),
                                 "started": dt.datetime.now().astimezone().isoformat(timespec="seconds")},
                                ensure_ascii=False), encoding="utf-8")
    before = {e["heading"] for e in log_entries(root)}
    try:
        log(f"{root.name}: " + ("утренний разбор — сессия Claude, до {} мин" if s["ru"] else
                                "morning tidy — a Claude session, up to {} min").format(int(float(cfg.get("tidy_timeout_min", 30)))))
        r = run_worker(root, cfg, "tidy", tidy_prompt(s), float(cfg.get("tidy_timeout_min", 30)), TIDY_SCHEMA, verbose)
    finally:
        claim.unlink(missing_ok=True)
    if r.get("report"):
        pending.append((root, r["report"], [e["heading"] for e in log_entries(root) if e["heading"] not in before]))
    log(f"{root.name}: tidy exit {r['exit']}, closed {', '.join(r.get('closed') or []) or 'nothing'}"
        + (f", changed {len(r.get('changed') or [])}" if r.get("changed") else "")
        + (f", ${r['cost_usd']}" if "cost_usd" in r else "") + f" — {clip(r.get('notes', ''), 200)}")
    s = collect_status(root)
    auto = next((t for t in s["next"]["tickets"] + s["next"]["rest"]
                 if AUTONOMOUS_RE.search(ticket_text(root, t["id"]))), None)
    if auto and not busy(root, s):
        log(f"{root.name}: {auto['id']} [autonomous] — {auto['title']}")
        r = run_worker(root, cfg, f"auto-{auto['id']}", autonomous_prompt(auto),
                       float(cfg.get("autonomous_timeout_min", 120)), verbose=verbose)
        log(f"{root.name}: {auto['id']} exit {r['exit']}" + (f", ${r['cost_usd']}" if "cost_usd" in r else "")
            + f" — {clip(r.get('notes', ''), 200)}")


def tidy_messages(root: Path, cfg: dict, report: list[dict]) -> list[dict]:
    """The tidy pass's report as the owner wants it: one short message of what was done, then each
    reading of their words that could be wrong as its own message, so one reply corrects it."""
    ru, label = is_russian(root), project_label(root, cfg)
    T = lambda k, **kw: TIDY_MSG[k][ru].format(**kw)
    done = [e for e in report if not e.get("check")]
    checks = [e for e in report if e.get("check")]
    parts = [f"<b>{tg_html(T('kind', p=label))}</b>"]
    if done:
        parts.append("\n".join(f"• {tg_html(clip(e['text'], 300))}" for e in done))
    if checks:
        parts.append(f"<i>{tg_html(T('checks', n=len(checks)))}</i>")
    base = {"root": str(root), "project": label, "doc": "QUESTIONS.md", "kind": "brief", "key": "",
            "code": "", "title": T("kind", p=label), "ru": ru}
    msgs = [{"kind": "tidy", "text": "\n\n".join(parts), "ref": base}]
    for k, e in enumerate(checks, 1):
        tid = ticket_id(e["ticket"]) if e.get("ticket") else ""
        ref = ({**base, "doc": "TODO.md", "kind": "ticket", "key": tid, "title": clip(e["text"], 80)}
               if re.fullmatch(r"B\d+", tid) else base)
        pos = f", {k}/{len(checks)}" if len(checks) > 1 else ""
        msgs.append({"kind": "tidy_check", "ref": ref, "text": "\n\n".join([
            f"<b>{tg_html(T('kind_check', p=label))}{pos}</b>",
            tg_html(clip(e["text"], 900)), f"<i>{tg_html(T('check_hint'))}</i>"])})
    return msgs


def add_seen(root: Path, headings: list[str]) -> None:
    """LOG entries the owner already got another way (the tidy report), so the brief doesn't repeat them."""
    if not headings:
        return
    state = seen_state()
    cur = state.get(str(root))
    if not cur:   # never looked: the brief shows the latest day, so everything before it counts as seen
        entries = log_entries(root)
        day = re.match(r"\S+", entries[0]["heading"]).group(0) if entries else ""
        cur = state[str(root)] = {"at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                                  "headings": [e["heading"] for e in entries if not e["heading"].startswith(day)]}
    cur["headings"] = (headings + cur.get("headings", []))[:300]
    STATE.mkdir(parents=True, exist_ok=True)
    SEEN.write_text(json.dumps(state, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")


def dispatch_brief(root: Path, cfg: dict, env: dict, dst: dict, cap: int, log, first: list | None = None) -> None:
    s = collect_status(root)
    left = cap - dst["sent"]
    with tg_lock():
        st = tg_state()
        msgs = (first or []) + plan_brief(root, s, st, cfg)
        if not msgs:
            log(f"{root.name}: nothing new for the owner")
            return
        if left < 1:
            log(f"{root.name}: {len(msgs)} message(s) held back, today's {cap} are used")
            return
        msgs = msgs[:left]
        deliver(msgs, st, env, cfg)
    mark_seen(root)
    dst["sent"] += len(msgs)
    log(f"{root.name}: brief, {len(msgs)} message(s)")


def cmd_dispatch(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop dispatch",
                                description="The morning run: in each project nobody is working in, a headless "
                                            "tidy pass acts on the owner's answers and closes what is done, one "
                                            "[autonomous] ticket goes through `accept`, then the brief goes out.")
    p.add_argument("--dry-run", action="store_true", help="Say what would run, run nothing, send nothing")
    p.add_argument("--now", action="store_true", help="Run even in quiet hours (23:00–09:00)")
    p.add_argument("--no-work", action="store_true", help="Only the briefs, no worker sessions")
    p.add_argument("--project", action="append", help="Only this project (repeatable)")
    p.add_argument("-v", "--verbose", action="store_true", help="Print every step of the sessions, not only a status line")
    p.add_argument("--service", choices=("on", "off", "status"), help=f"macOS: run it every day at "
                   f"{DISPATCH_TIME[0]:02d}:{DISPATCH_TIME[1]:02d}")
    a = p.parse_args(argv)
    if a.service:
        return launchd(DISPATCH_SERVICE, ["dispatch"], a.service, DISPATCH_LOG,
                       {"StartCalendarInterval": {"Hour": DISPATCH_TIME[0], "Minute": DISPATCH_TIME[1]}},
                       "dispatcher")
    cfg, env = load_config(), tg_env()
    hour = dt.datetime.now().hour
    if not (a.now or a.dry_run) and (hour >= QUIET_HOURS[0] or hour < QUIET_HOURS[1]):
        print("· quiet hours, nothing done (--now to run anyway)")
        return 0
    roots = [find_root(Path(os.path.expanduser(x))) for x in a.project] if a.project else dispatch_projects(cfg)
    if not roots:
        print(f"agentdrop dispatch: no projects. Put `projects = ~/path/a, ~/path/b` in {CONFIG}", file=sys.stderr)
        return 2

    def log(msg: str) -> None:
        line = f"{dt.datetime.now():%d.%m %H:%M} {msg}"
        print(line, flush=True)
        if not a.dry_run:
            STATE.mkdir(parents=True, exist_ok=True)
            with DISPATCH_LOG.open("a", encoding="utf-8") as fh:
                fh.write(line + "\n")

    if env and not a.dry_run:
        for note in sync_replies(wait=True):   # the owner's answers into the docs before anyone reads them
            log(note)
    dst = dispatch_state()
    for root in roots:
        pending: list = []
        if not a.no_work:
            try:
                dispatch_one(root, cfg, a.dry_run, log, pending, a.verbose)
            except (OSError, subprocess.SubprocessError) as e:
                log(f"! {root.name}: {e}")
        if a.dry_run or not (env or cfg.get("notify")):
            continue
        first = []
        for _, report, headings in pending:
            first += tidy_messages(root, cfg, report)
            add_seen(root, headings)
        try:
            dispatch_brief(root, cfg, env, dst, int(cfg.get("day_cap", DAY_CAP)), log, first)
        except TgError as e:
            log(f"! {root.name}: brief not sent: {e}")
        dst["runs"][str(root)] = dt.datetime.now().astimezone().isoformat(timespec="seconds")
        DISPATCH_STATE.write_text(json.dumps(dst, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    return 0


# ---------------------------------------------------------------------------
# `agentdrop tickets`: every ticket and every question for the owner across projects, with full
# text and thread, as JSON for a page where the owner opens one item and answers it.

def split_thread(text: str) -> tuple[str, list[dict]]:
    """An item's text without its title line split into the body and the `> **Name, when:** …` thread."""
    body, thread = [], []
    for line in text.splitlines():
        st = line.strip()
        m = COMMENT_RE.match(line)
        if m:
            head = re.match(r"^\s*>\s*\*\*([^*]+?):\*\*\s*(.*)", line)
            who, _, when = (head.group(1) if head else m.group(1)).partition(",")
            thread.append({"author": who.strip(), "when": when.strip(), "text": head.group(2) if head else ""})
        elif st.startswith(">") and thread:
            thread[-1]["text"] += "\n" + st.lstrip("> ").rstrip()
        elif st in ("_Thread closed._", "_Ветка закрыта._"):
            thread.append({"author": "", "when": "", "text": st.strip("_")})
        else:
            body.append(line[2:] if line.startswith("  ") else line)
    return "\n".join(body).strip(), thread


def collect_items(root: Path, cfg: dict) -> tuple[dict, list[dict]]:
    s = collect_status(root)
    label = project_label(root, cfg)
    prefix = "".join(w[0] for w in re.split(r"[-_ ]+", label) if w)[:3].lower() or "p"
    proj = {"key": prefix, "label": label, "root": str(root), "ru": s["ru"]}
    state = {}
    for key, ts in (("owner", s["waiting"]["tickets"]), ("turn", s["waiting"]["turn_tickets"]),
                    ("next", s["next"]["tickets"] + s["next"]["rest"]), ("others", s["next"]["blocked"]),
                    ("later", s["next"]["deferred"])):
        for t in ts:
            state.setdefault(t["id"], key)
    for c in s["running"]["claims"]:
        state.setdefault(c.get("ticket", ""), "running")
    items = []
    for t in parse_todo(root, cfg):
        text = ticket_text(root, t["id"])
        m = re.match(r"\*\*(.+?)\*\*\s*", text, re.S)   # **B85 (P0). Title.** body
        rest = text[m.end():] if m else ITEM_TICKET.sub("", text, count=1)
        title_plain = t["title"].replace("…", "")
        if not m and rest.startswith(title_plain):   # B134 P1 — Title. Зачем: «…» body
            rest = rest[len(title_plain):].lstrip(". ")
        why = WHY_RE.search(rest)
        if why and t["why"]:   # the why is shown on its own
            rest = (rest[:why.start()] + rest[why.end():]).lstrip(". ").replace("\n\n\n", "\n\n")
        body, thread = split_thread(rest)
        items.append({"id": f"{prefix}-{t['id']}", "project": prefix, "code": t["id"], "kind": "ticket",
                      "title": t["title"], "priority": t["priority"], "section": t["section"],
                      "state": state.get(t["id"], "next"), "why": t["why"], "waits": t["waits"],
                      "body": body, "thread": thread,
                      "images": t["images"], "doc": "TODO.md"})
    q = parse_questions(root, cfg)
    turn = set(q["your_turn"])
    all_q = {bold_title(text)[0]: text for _, text in md_items(doc(root, "QUESTIONS.md"))}
    wanted = [(x["key"].strip("*"), "owner", x) for x in q["waiting"]]
    for key, text in all_q.items():
        code = re.match(r"([A-ZА-ЯЁ]{1,3}-\d+)\.\s*", key or "")
        title = f"{key[code.end():].rstrip('. ')} ({code.group(1)})" if code else (key or "").rstrip(". ")
        if clip(title, 90) in turn:
            wanted.append((key, "turn", {"title": title, "images": item_images(root, text)}))
    for key, st, x in wanted:
        text = all_q.get(key, "")
        body, thread = split_thread(bold_title(text)[1])
        code = re.match(r"([A-ZА-ЯЁ]{1,3}-\d+)", key)
        items.append({"id": f"{prefix}-q{sha(key.encode())[:6]}", "project": prefix,
                      "code": code.group(1) if code else "", "kind": "question", "title": x["title"],
                      "priority": "", "section": "QUESTIONS", "state": st, "why": "", "waits": "",
                      "pick": x.get("pick", ""), "body": body, "thread": thread,
                      "images": x.get("images", []), "doc": "QUESTIONS.md"})
    have = {i["code"] for i in items}
    for head, body in re.findall(r"(?m)^## (.+)\n((?:(?!## ).*\n?)*)", doc(root, "LOG.md")):
        m = re.match(r"(\d{1,2}\.\d{2})\s*[—-]\s*(.*)", head.strip())
        if not m:   # closed tickets, so a link from another ticket opens something
            continue
        title = re.sub(r"^B\d+\b[\s:—-]*|\s*\((?:B\d+[,\s]*)+\)", "", m.group(2)).strip()
        for code in re.findall(r"\bB\d+\b", m.group(2)):
            if code in have:
                continue
            have.add(code)
            items.append({"id": f"{prefix}-{code}", "project": prefix, "code": code, "kind": "ticket",
                          "title": (title[:1].upper() + title[1:]) or code, "priority": "", "section": "LOG", "state": "done",
                          "why": "", "waits": "", "body": f"Сделано {m.group(1)}.\n\n{body.strip()}",
                          "thread": [], "images": [], "doc": "LOG.md"})
    return proj, items


IMG_EXT = {".png", ".jpg", ".jpeg", ".webp"}


def page_image(src: Path, out_dir: Path) -> str:
    """A copy of a screenshot for the tickets page: JPEG, at most 1600 px on the long side (sips on a Mac, else as is)."""
    out_dir.mkdir(parents=True, exist_ok=True)
    name = f"{sha(str(src.resolve()).encode())[:10]}.jpg"
    dst = out_dir / name
    if not dst.exists() or dst.stat().st_mtime < src.stat().st_mtime:
        if shutil.which("sips"):
            subprocess.run(["sips", "-s", "format", "jpeg", "-s", "formatOptions", "80", "--resampleHeightWidthMax", "1600",
                            str(src), "--out", str(dst)], capture_output=True)
        if not dst.exists():
            name = f"{sha(str(src.resolve()).encode())[:10]}{src.suffix.lower()}"
            shutil.copyfile(src, out_dir / name)
    return f"img/{name}"


def cmd_tickets(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop tickets",
                                description="Every ticket and question for the owner, with full text and thread, "
                                            "as JSON (for a page that opens one item).")
    p.add_argument("paths", nargs="*", help="Project directories (default: `projects` in the config, or every "
                                            "project whose board was looked at)")
    p.add_argument("--docs", metavar="FILE", help="Also write the project .md files the items mention in backticks "
                                                   "(`docs/HYPOTHESES.md`), so the page can open them")
    a = p.parse_args(argv)
    cfg = load_config()
    roots = [find_root(Path(os.path.expanduser(x))) for x in a.paths] or dispatch_projects(cfg)
    out = {"generated": dt.datetime.now().astimezone().isoformat(timespec="minutes"), "projects": [], "items": []}
    docs = {"refs": {}, "files": {}}   # refs: "sd:specs/x.md" -> "sd:docs/specs/x.md"; files: that -> text
    for root in roots:
        proj, items = collect_items(root, cfg)
        out["projects"].append(proj)
        out["items"] += items
        for it in items:
            text = " ".join([it["body"], it.get("why", ""), *(m["text"] for m in it["thread"])])
            for ref in re.findall(r"`([^`\s]+\.md)`", text):
                f = next((root / c for c in (ref, f"docs/{ref}") if (root / c).is_file()), None)
                if f:
                    real = f"{proj['key']}:{f.relative_to(root).as_posix()}"
                    docs["refs"][f"{proj['key']}:{ref}"] = real
                    docs["files"].setdefault(real, f.read_text(encoding="utf-8", errors="replace"))
            if a.docs and it["state"] != "done":   # screenshots it names, a file or a folder of them, shown inline
                pics = []
                for ref in re.findall(r"`([^`\s]+)`", text) + re.findall(r"[\w./-]+\.(?:png|jpe?g|webp)\b", text, re.I):
                    for base in (root, root / "docs"):
                        p = base / ref
                        if p.is_dir():
                            pics += sorted(x for x in p.iterdir() if x.suffix.lower() in IMG_EXT)
                            break
                        if p.is_file() and p.suffix.lower() in IMG_EXT:
                            pics.append(p)
                            break
                pics = list(dict.fromkeys(pics))[:8]
                if pics:
                    docs.setdefault("images", {})[it["id"]] = [
                        {"src": page_image(x, Path(a.docs).parent / "img"), "name": x.stem} for x in pics]
    if a.docs:
        Path(a.docs).write_text(json.dumps(docs, ensure_ascii=False), encoding="utf-8")
    print(json.dumps(out, ensure_ascii=False, indent=1))
    return 0


COMMANDS = {"status": cmd_status, "claim": cmd_claim, "release": cmd_release, "brief": cmd_brief,
            "replies": cmd_replies, "accept": cmd_accept,
            "dispatch": cmd_dispatch, "tickets": cmd_tickets}


def main() -> None:
    if len(sys.argv) > 1 and sys.argv[1] in COMMANDS:
        _console_safe()
        sys.exit(COMMANDS[sys.argv[1]](sys.argv[2:]))
    parser = argparse.ArgumentParser(
        description="Deploy shared AI-agent rules without overwriting harness-specific instructions."
    )
    parser.add_argument("target", nargs="?", help="Project directory, or one of: sync, edit")
    parser.add_argument("--install", action="store_true", help="Install agentdrop command and sync global rules")
    parser.add_argument("--dry-run", action="store_true", help="Show what would change")
    parser.add_argument("--docs", choices=DOCS_MODES,
                        help="Where project docs live: track (in the code repo), separate (local "
                             ".git-docs in the same folder) or local (ignored, no history). "
                             "Saved per repo; asked on the first run if omitted")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--research", dest="research", action="store_true", default=None,
                      help="Turn on research mode: asks, hypotheses and claims registries, skeptic")
    mode.add_argument("--no-research", dest="research", action="store_false",
                      help="Turn research mode off (keeps its files)")
    args = parser.parse_args()
    _console_safe()

    if args.install:
        install_self(dry=args.dry_run)
        return

    if args.target in ("sync", "global"):
        sync_globals(dry=args.dry_run)
        return

    if args.target in ("edit", "common"):
        open_common()
        return

    if not args.target:
        cwd = Path.cwd().resolve()

        # `agentdrop --dry-run` is deliberately non-interactive and previews CWD.
        if args.dry_run:
            bootstrap_project(cwd, dry=True, docs=args.docs, research=args.research)
            return

        print(f"\nAgentDrop will bootstrap/sync the current directory:\n  {cwd}\n")
        print("It will:")
        print("  - preserve existing harness/project instructions")
        print("  - put the docs charter into AGENTS.md (shared rules stay global)")
        print("  - add/update harness bridges without overwriting their own instructions")
        print("  - create missing docs/ skeleton, review-intake skill and docs guard (~/.agentdrop/kit)")
        print("  - on first setup, ask whether this is a research project (--research / --no-research)")
        print("  - back up any existing file before AgentDrop changes it")
        print("  - ask whether the docs go into this repo, a local .git-docs, or nowhere (git repos only)")
        print("\nIt will NOT initialize the project's Git, commit automatically, or overwrite project memory.")

        try:
            answer = input("\nProceed? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nCancelled.")
            return

        if answer not in {"y", "yes"}:
            print("Cancelled.")
            return

        bootstrap_project(cwd, dry=False, docs=args.docs, research=args.research)
        return

    bootstrap_project(Path(args.target), dry=args.dry_run, docs=args.docs, research=args.research)


if __name__ == "__main__":
    main()
