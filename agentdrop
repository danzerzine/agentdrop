def now_stamp() -> str:
    return dt.datetime.now().strftime("%Y%m%d-%H%M%S")


def sha(data: bytes) -> str:
    return hashlib.sha256(data.replace(b"\r\n", b"\n")).hexdigest()


def owned_kit_file(key: str) -> bool:
    """key is a path inside the kit; research-mode files sit under modes/research/."""
    return key in OWNED or key.startswith("modes/research/") and key[len("modes/research/"):] in OWNED


def load_lock() -> dict:
    try:
        return json.loads(read(KIT_LOCK)) if KIT_LOCK.exists() else {}
    except json.JSONDecodeError:
        return {}


def remember(lock: dict, key: str, digest: str) -> None:
    """Record a version of an owned kit file as agentdrop's own, so a project copy equal to it
    counts as untouched."""
    known = lock.setdefault("known:" + key, [])
    if digest not in known:
        known.append(digest)


def shipped_versions(bundled: Path) -> dict[str, set[str]]:
    """Every version of the owned kit files in the clone's git history, so a project set up by an
    older agentdrop still counts as untouched. Empty outside a git clone."""
    repo = bundled.parent
    try:
        log = subprocess.run(["git", "-C", str(repo), "log", "--format=", "--raw", "--no-abbrev",
                              "--no-renames", "--", "kit"], capture_output=True, text=True)
    except FileNotFoundError:
        return {}
    blobs: dict[str, str] = {}
    for line in log.stdout.splitlines():
        meta, _, path = line.partition("\t")
        parts = meta.split()
        key = path[len("kit/"):]
        if len(parts) >= 4 and path.startswith("kit/") and owned_kit_file(key):
            for blob in parts[2:4]:
                if blob.strip("0"):
                    blobs[blob] = key
    if not blobs:
        return {}
    r = subprocess.run(["git", "-C", str(repo), "cat-file", "--batch"], capture_output=True,
                       input="".join(b + "\n" for b in blobs).encode())
    out, pos, found = r.stdout, 0, {}
    for blob, key in blobs.items():
        header_end = out.find(b"\n", pos)
        if header_end < 0:
            break
        header = out[pos:header_end].split()
        pos = header_end + 1
        if len(header) < 3 or header[1] != b"blob":
            continue
        size = int(header[2])
        found.setdefault(key, set()).add(sha(out[pos:pos + size]))
        pos += size + 1
    return found


def update_kit(bundled: Path) -> None:
    """Bring ~/.agentdrop/kit and COMMON.md up to the bundled version without losing edits.

    A file agentdrop installed and nobody touched since is replaced; a missing one is added;
    one the user edited stays, and the new version goes next to it (kit.new/, COMMON.new.md).
    """
    lock = load_lock()
    kept = []
    for key, digests in shipped_versions(bundled).items():
        for digest in sorted(digests):
            remember(lock, key, digest)

    def place(key: str, new: bytes, dest: Path, side: Path, mode_from: Path | None = None) -> None:
        new_sha = sha(new)
        if owned_kit_file(key):
            remember(lock, key, new_sha)
        if dest.exists():
            cur = sha(dest.read_bytes())
            if cur == new_sha:
                lock[key] = new_sha
                return
            if lock.get(key) != cur:          # edited by the user, or installed before the lock
                if lock.get("offered:" + key) != new_sha:   # each new version is offered once
                    side.parent.mkdir(parents=True, exist_ok=True)
                    side.write_bytes(new)
                    kept.append(side)
                    lock["offered:" + key] = new_sha
                return
            backup(dest)
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(new)
        if mode_from:
            shutil.copymode(mode_from, dest)
        lock[key] = new_sha

    for src in sorted(bundled.rglob("*")):
        if src.is_file() and src.name != ".DS_Store" and "__pycache__" not in src.parts:
            rel = src.relative_to(bundled).as_posix()
            place(rel, src.read_bytes(), KIT / rel, KIT_NEW / rel, src)
    place("COMMON.md", (DEFAULT_COMMON.rstrip() + "\n").encode(), COMMON, STATE / "COMMON.new.md")
    write(KIT_LOCK, json.dumps(lock, indent=1, sort_keys=True) + "\n")
    if kept:
        print(f"! Kept your edited versions; the new ones are next to them ({len(kept)}):")
        for side in kept:
            print(f"    {side}")
        print("  Ask your agent to merge them, then delete the .new copies.")


def ensure_state() -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    BACKUPS.mkdir(parents=True, exist_ok=True)
    bundled = Path(__file__).resolve().parent / "kit"
    if bundled.is_dir():                      # running from a clone: install or update the kit
        update_kit(bundled)
    elif not COMMON.exists():
        write(COMMON, DEFAULT_COMMON.rstrip() + "\n")

    # Migrate managed blocks without replacing the user's own edits.
    existing = COMMON.read_text(encoding="utf-8", errors="replace")
    migrated = existing

    tools_block = f"{TOOLS_START}\n{TOOL_EFFICIENCY_BLOCK.rstrip()}\n{TOOLS_END}"
    tools_pattern = re.compile(re.escape(TOOLS_START) + r".*?" + re.escape(TOOLS_END), re.S)
    if not tools_pattern.search(migrated):
        product_heading = "\n## Product, data, and UI"
        if product_heading in migrated:
            migrated = migrated.replace(product_heading, "\n\n" + tools_block + product_heading, 1)
        else:
            migrated = migrated.rstrip() + "\n\n" + tools_block + "\n"

    if migrated != existing:
        backup_dir = BACKUPS / now_stamp()
        backup_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy2(COMMON, backup_dir / "COMMON.md")
        write(COMMON, migrated)


def backup(path: Path) -> None:
    if not path.exists():
        return
    try:
        rel = path.resolve().relative_to(HOME.resolve())
        dest = BACKUPS / now_stamp() / rel
    except Exception:
        safe = re.sub(r"[^A-Za-z0-9._-]+", "_", str(path))
        dest = BACKUPS / now_stamp() / safe
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, dest)


def read(path: Path) -> str:
    # utf-8-sig: Windows editors (Notepad, PowerShell 5.1) prepend a BOM, which would hide
    # a first-line "@AGENTS.md" import from the regex. Newlines come back as "\n".
    try:
        return path.read_text(encoding="utf-8-sig")
    except UnicodeDecodeError:
        return path.read_text(encoding="utf-8-sig", errors="replace")


def write(path: Path, text: str, dry: bool = False) -> bool:
    old = read(path) if path.exists() else None
    if old == text:
        return False
    if dry:
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    # keep the file's own line endings and BOM; new files get "\n" on every OS
    newline, bom = "\n", False
    if path.exists():
        raw = path.read_bytes()
        newline = "\r\n" if b"\r\n" in raw else "\n"
        bom = raw.startswith(b"\xef\xbb\xbf")
        backup(path)
    with open(path, "w", encoding="utf-8-sig" if bom else "utf-8", newline=newline) as f:
        f.write(text)
    return True


def managed_merge(
    path: Path,
    payload: str,
    start: str,
    end: str,
    dry: bool = False,
    position: str = "end",
) -> tuple[bool, str]:
    """Replace our managed block if present; otherwise add it without touching existing text."""
    existing = read(path) if path.exists() else ""
    block = f"{start}\n{payload.rstrip()}\n{end}"

    pattern = re.compile(re.escape(start) + r".*?" + re.escape(end), re.S)
    if pattern.search(existing):
        merged = pattern.sub(block, existing, count=1)
        action = "updated managed block"
    elif existing.strip():
        if position == "start":
            merged = block + "\n\n" + existing.lstrip()
        else:
            merged = existing.rstrip() + "\n\n" + block + "\n"
        action = "preserved existing + added managed block"
    else:
        merged = block + "\n"
        action = "created"

    return write(path, merged, dry), action


def ensure_import(path: Path, import_line: str, dry: bool = False) -> tuple[bool, str]:
    """
    Preserve harness-specific instructions and only add an import if AGENTS.md is not
    already imported/referenced with an @ import.
    """
    existing = read(path) if path.exists() else ""
    # Detect equivalent @ imports, allowing spaces and relative variants.
    target_name = "AGENTS.md"
    import_re = re.compile(r"(?m)^\s*@(?:\./|\.\./)*AGENTS\.md\s*$", re.I)
    if import_re.search(existing):
        return False, "already imports AGENTS.md"

    if existing.strip():
        new = import_line.rstrip() + "\n\n" + existing.lstrip()
        action = "preserved existing + added AGENTS import"
    else:
        new = import_line.rstrip() + "\n"
        action = "created import shim"

    return write(path, new, dry), action


def detect_stack(root: Path) -> str:
    bits = []
    if (root / "package.json").exists():
        try:
            data = json.loads(read(root / "package.json"))
            pm = "Node"
            if (root / "pnpm-lock.yaml").exists():
                pm += "/pnpm"
            elif (root / "yarn.lock").exists():
                pm += "/Yarn"
            elif (root / "bun.lockb").exists() or (root / "bun.lock").exists():
                pm += "/Bun"
            elif (root / "package-lock.json").exists():
                pm += "/npm"
            bits.append(pm)
        except Exception:
            bits.append("Node")
    if (root / "pyproject.toml").exists() or (root / "requirements.txt").exists():
        bits.append("Python")
    if (root / "Cargo.toml").exists():
        bits.append("Rust")
    if (root / "go.mod").exists():
        bits.append("Go")
    if (root / "Gemfile").exists():
        bits.append("Ruby")
    if (root / "composer.json").exists():
        bits.append("PHP")
    return ", ".join(bits) if bits else "not inferred"


def git_info(root: Path) -> tuple[bool, str]:
    try:
        r = subprocess.run(
            ["git", "-C", str(root), "rev-parse", "--show-toplevel"],
            text=True, capture_output=True, timeout=3
        )
        if r.returncode != 0:
            return False, ""
        b = subprocess.run(
            ["git", "-C", str(root), "branch", "--show-current"],
            text=True, capture_output=True, timeout=3
        )
        return True, b.stdout.strip() or "(detached)"
    except Exception:
        return False, ""


def sync_globals(dry: bool = False) -> None:
    ensure_state()
    common = read(COMMON).rstrip()

    print("\nGlobal harness rules")
    print("--------------------")

    # Claude: dedicated user rule avoids touching the user's existing CLAUDE.md.
    claude_rule = HOME / ".claude" / "rules" / "agentdrop-common.md"
    changed = write(claude_rule, common + "\n", dry)
    print(f"{'✓' if changed else '·'} Claude Code   {claude_rule}  "
          f"({'would update' if dry and changed else 'synced' if changed else 'unchanged'})")

    # Codex: AGENTS.override.md shadows AGENTS.md, so merge into the active one.
    codex_override = HOME / ".codex" / "AGENTS.override.md"
    codex_base = HOME / ".codex" / "AGENTS.md"
    codex_target = codex_override if codex_override.exists() else codex_base
    changed, action = managed_merge(
        codex_target, common, GLOBAL_START, GLOBAL_END, dry=dry
    )
    note = " (override detected)" if codex_target == codex_override else ""
    print(f"{'✓' if changed else '·'} Codex         {codex_target}{note} — {action}")

    targets = [
        ("OpenCode", HOME / ".config" / "opencode" / "AGENTS.md"),
        ("Command Code", HOME / ".commandcode" / "AGENTS.md"),
        ("Gemini CLI", HOME / ".gemini" / "GEMINI.md"),
    ]
    for name, path in targets:
        changed, action = managed_merge(path, common, GLOBAL_START, GLOBAL_END, dry=dry)
        print(f"{'✓' if changed else '·'} {name:<13} {path} — {action}")

    print(f"\nMaster rules: {COMMON}")
    if not dry:
        print("Edit that one file, then run:  agentdrop sync")


def project_template_with_meta(name: str, body: str, root: Path) -> str:
    if name != "HANDOFF.md":
        return body
    stack = detect_stack(root)
    is_git, branch = git_info(root)
    meta = (
        f"# HANDOFF\n\n"
        f"> Cold-agent handoff. Keep concise and current.\n\n"
        f"## Project\n"
        f"- Name: `{root.name}`\n"
        f"- Stack: {stack}\n"
    )
    if is_git:
        meta += f"- Git branch at bootstrap: `{branch}`\n"
    meta += "\n"
    return meta + body.split("\n", 3)[-1] if body.startswith("# HANDOFF") else body


def uses_kit(root: Path) -> bool:
    """Kit layout unless the project already runs on the old root-level memory files."""
    if not CHARTER.exists():
        return False
    if (root / "docs" / "STATE.md").exists():
        return True
    return not any((root / f).exists() for f in LEGACY_FILES)


def copy_kit(root: Path, dry: bool = False, src_root: Path = KIT) -> list[str]:
    created, kept = [], []
    lock = load_lock()
    for src in sorted(src_root.rglob("*")):
        rel = src.relative_to(src_root).as_posix()
        if src.is_dir() or rel in KIT_SKIP or rel.startswith("modes/") or src.name == ".DS_Store":
            continue
        dest = root / rel
        key = src.relative_to(KIT).as_posix() if src.is_relative_to(KIT) else rel
        new_sha = sha(src.read_bytes())
        if rel in OWNED:
            remember(lock, key, new_sha)
        if dest.exists():
            cur = sha(dest.read_bytes())
            if rel not in OWNED or cur == new_sha:
                continue
            if cur not in lock.get("known:" + key, []):
                # the project changed it: never overwrite its own checks or edits
                print(f"! {rel:<40} — kept: this project changed it")
                kept.append((rel, src))
                continue
            if not dry:
                backup(dest)
            action = "would update" if dry else "updated (old copy in ~/.agentdrop/backups)"
        else:
            action = "would create" if dry else "created"
        if not dry:
            dest.parent.mkdir(parents=True, exist_ok=True)
            data = src.read_bytes()
            if data.startswith(b"#!"):
                # a Windows clone (core.autocrlf) gives the kit CRLF; bash and git hooks want LF
                dest.write_bytes(data.replace(b"\r\n", b"\n"))
                shutil.copystat(src, dest)
            else:
                shutil.copy2(src, dest)
        print(f"✓ {rel:<40} — {action}")
        created.append(rel)
    if not dry:
        write(KIT_LOCK, json.dumps(lock, indent=1, sort_keys=True) + "\n")
    if kept:
        print("  agentdrop did not refresh these files because the project edited them. To take the new version:")
        if any(rel in ("scripts/check_docs.sh", ".githooks/pre-commit") for rel, _ in kept):
            print(f"  1. Move the project's own checks into {PROJECT_CHECKS} (the guard runs it on every")
            print("     commit and Stop hook, and agentdrop never touches it; see the README, \"Project checks\").")
            print("  2. Then copy the new version over the old one:")
        else:
            print("  Merge the project's edits into the new version, then copy it over the old one:")
        for rel, src in kept:
            print(f"       cp {src} {rel}")
    return created


def research_on(root: Path) -> bool:
    agents = root / "AGENTS.md"
    return agents.exists() and RESEARCH_START in read(agents)


def ask_research(root: Path) -> bool:
    """First setup in a terminal: ask whether this project explores the unknown."""
    if not sys.stdin.isatty() or not RESEARCH.is_dir():
        return False
    print("\nResearch mode is for projects that explore the unknown and test hypotheses:")
    print("  owner asks kept verbatim in docs/ASKS.md, hypotheses with a prediction before")
    print("  computing, claims with an evidence level, a skeptic and an acceptance judge.")
    print("  Turn it on or off later with --research / --no-research.")
    try:
        return input("Is this a research project? [y/N] ").strip().lower() in {"y", "yes"}
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def ensure_docs_allow(root: Path, line: str, dry: bool = False) -> bool:
    path = root / ".docs-allow"
    existing = read(path) if path.exists() else ""
    if line in existing.splitlines():
        return False
    text = existing + ("" if not existing or existing.endswith("\n") else "\n") + line + "\n"
    write(path, text, dry)
    print(f"✓ .docs-allow                             — {'would add' if dry else 'added'} research registries")
    return True


def apply_research(root: Path, on: bool, dry: bool = False) -> list[str]:
    agents = root / "AGENTS.md"
    if not on:
        if research_on(root):
            pattern = re.compile(r"\n*" + re.escape(RESEARCH_START) + r".*?" + re.escape(RESEARCH_END) + r"\n?", re.S)
            write(agents, pattern.sub("\n", read(agents)).rstrip() + "\n", dry)
            print(f"✓ AGENTS.md      — {'would remove' if dry else 'removed'} research block (files kept)")
        return []
    if not (RESEARCH / "CHARTER.md").exists():
        print(f"! Research mode not in {RESEARCH}; run `agentdrop --install` from the repo to add it")
        return []
    payload = read(RESEARCH / "CHARTER.md").rstrip()
    text = read(agents) if agents.exists() else ""
    if RESEARCH_START not in text and PROJECT_END in text:
        # right under the charter, above whatever the project wrote after it
        block = f"{RESEARCH_START}\n{payload}\n{RESEARCH_END}"
        changed = write(agents, text.replace(PROJECT_END, f"{PROJECT_END}\n\n{block}", 1), dry)
        action = "added block"
    else:
        changed, action = managed_merge(agents, payload, RESEARCH_START, RESEARCH_END, dry=dry)
    print(f"{'✓' if changed else '·'} AGENTS.md      — research: {action}")
    created = copy_kit(root, dry=dry, src_root=RESEARCH)
    had_allow = (root / ".docs-allow").exists()
    if ensure_docs_allow(root, RESEARCH_ALLOW, dry=dry) and not had_allow:
        created.append(".docs-allow")
    return created


def ensure_hooks(root: Path, dry: bool = False) -> None:
    """Claude Code hooks: the docs guard on Stop, reminders (harvest, research asks) on SessionStart."""
    path = root / ".claude" / "settings.json"
    try:
        data = json.loads(read(path)) if path.exists() else {}
    except json.JSONDecodeError:
        print(f"! {path.relative_to(root)} — not valid JSON, hooks not added")
        return
    wanted = [("Stop", STOP_HOOK_CMD, "--stop-hook")]
    guard = root / "scripts" / "check_docs.sh"
    if dry or (guard.exists() and "--session-start" in read(guard)):
        wanted.append(("SessionStart", START_HOOK_CMD, "--session-start"))
    added = []
    for event, cmd, flag in wanted:
        groups = data.setdefault("hooks", {}).setdefault(event, [])
        if not any(flag in h.get("command", "") for g in groups for h in g.get("hooks", [])):
            groups.append({"hooks": [{"type": "command", "command": cmd}]})
            added.append(event)
    if not added:
        print("· .claude/settings.json                   — hooks present")
        return
    write(path, json.dumps(data, ensure_ascii=False, indent=2) + "\n", dry)
    print(f"✓ .claude/settings.json                   — {'would add' if dry else 'added'} {' and '.join(added)} hook")


def git(root: Path, *args: str, git_dir: Path | None = None) -> subprocess.CompletedProcess:
    cmd = ["git", "-C", str(root)]
    if git_dir:
        cmd += [f"--git-dir={git_dir}", f"--work-tree={root}"]
    # git prints paths in UTF-8 whatever the Windows console code page is
    return subprocess.run(cmd + list(args), capture_output=True, encoding="utf-8", errors="replace")


def ensure_hooks_path(root: Path, dry: bool = False, git_dir: Path | None = None) -> None:
    label = f"{DOCS_GIT} core.hooksPath" if git_dir else "git core.hooksPath"
    try:
        current = git(root, "config", "core.hooksPath", git_dir=git_dir).stdout.strip()
    except FileNotFoundError:
        print("! git not found — .githooks/pre-commit not activated")
        return
    if current == ".githooks":
        print(f"· {label:<40} — already .githooks")
    elif current:
        print(f"! {label} is '{current}' — left as is; .githooks/pre-commit not active")
    else:
        if not dry:
            git(root, "config", "core.hooksPath", ".githooks", git_dir=git_dir).check_returncode()
        print(f"✓ {label + ' = .githooks':<40} — {'would set' if dry else 'set'}")


def saved_docs_mode(root: Path) -> str | None:
    mode = git(root, "config", "--get", DOCS_KEY).stdout.strip()
    if mode in DOCS_MODES:
        return mode
    if (root / DOCS_GIT).is_dir():   # a docs repo set up by hand before agentdrop asked
        return "separate"
    return None


def ask_docs_mode(dry: bool) -> tuple[str | None, bool]:
    """(mode, save): the owner's answer is saved; a default for a run without a terminal is not."""
    if dry:
        print("· docs in git  — not chosen yet: agentdrop will ask (or pass --docs track|separate|local)")
        return None, False
    if not sys.stdin.isatty():
        print("· docs in git  — no terminal to ask: left in the code repo this time "
              "(to choose: agentdrop --docs track|separate|local .)")
        return "track", False
    print("\nWhere should the project docs and agent files live?")
    print("  (docs/, AGENTS.md, GEMINI.md, .claude/, .githooks/, scripts/check_docs.sh)")
    print("  1) in this git repo, committed with the code")
    print(f"  2) in a separate local git in this folder ({DOCS_GIT}), never pushed")
    print("  3) only on this machine, ignored by git, no history")
    choices = {"": "track", "1": "track", "2": "separate", "3": "local", **{m: m for m in DOCS_MODES}}
    while True:
        try:
            answer = input("Choice [1]: ").strip().lower()
        except EOFError:
            answer = ""
        except KeyboardInterrupt:
            print("\nNot chosen; agentdrop will ask again next time.")
            return None, False
        if answer in choices:
            return choices[answer], True
        print("Type 1, 2 or 3.")


def update_exclude(root: Path, lines: list[str], dry: bool) -> bool:
    """Our marked block in .git/info/exclude holds the lines the file doesn't already have."""
    path = Path(git(root, "rev-parse", "--git-path", "info/exclude").stdout.strip())
    path = root / path   # relative to root unless git gave an absolute path (worktrees)
    existing = read(path) if path.exists() else ""
    block_re = re.compile(r"\n*" + re.escape(EXCLUDE_START) + r".*?" + re.escape(EXCLUDE_END) + r"\n?", re.S)
    rest = block_re.sub("\n", existing).rstrip("\n")
    have = {ln.strip().lstrip("/") for ln in rest.splitlines()}
    missing = [ln for ln in lines if ln.lstrip("/") not in have]
    if not missing and not block_re.search(existing):
        return False
    text = rest + "\n" if rest else ""
    if missing:
        text += ("\n" if rest else "") + "\n".join([EXCLUDE_START, *missing, EXCLUDE_END]) + "\n"
    return write(path, text, dry)


def apply_docs_mode(root: Path, mode: str, created: list[str], dry: bool = False) -> None:
    research = research_on(root)
    docs_paths = DOCS_PATHS + (RESEARCH_DOCS_PATHS if research else ())
    repo_paths = DOCS_REPO_PATHS + (RESEARCH_REPO_PATHS if research else ())
    docs_git = root / DOCS_GIT
    prefix = git(root, "rev-parse", "--show-prefix").stdout.strip()   # project may sit below the repo top

    if mode == "track":
        if update_exclude(root, [], dry):
            print(f"✓ .git/info/exclude                        — {'would remove' if dry else 'removed'} the agentdrop docs block")
        ensure_hooks_path(root, dry)
        if docs_git.is_dir():
            print(f"! {DOCS_GIT} left in place; the docs now belong to the code repo: git add them there")
        print("Project docs stay in the code repo; the agent commits them with its next coherent iteration.")
        return

    lines = [f"/{prefix}{p}" for p in (DOCS_GIT + "/", *docs_paths)]
    changed = update_exclude(root, lines, dry)
    print(f"{'✓' if changed else '·'} .git/info/exclude                        — "
          f"{'would list' if dry and changed else 'listed' if changed else 'already lists'} the docs paths")
    if git(root, "config", "core.hooksPath").stdout.strip() == ".githooks":
        if not dry:
            git(root, "config", "--unset", "core.hooksPath")
        print(f"✓ git core.hooksPath (code repo)           — {'would unset' if dry else 'unset'}")

    if mode == "separate":
        fresh = not docs_git.exists()
        if fresh:
            if not dry:
                git(root, "init", "-q", git_dir=docs_git).check_returncode()
                git(root, "config", "status.showUntrackedFiles", "no", git_dir=docs_git)
            print(f"✓ {DOCS_GIT + '/':<40} — {'would create' if dry else 'created'} the local docs repo")
        ensure_hooks_path(root, dry, git_dir=docs_git)
        in_repo = lambda rel: any(rel == p or rel.startswith(p + "/") for p in repo_paths)
        to_add = [p for p in repo_paths if (root / p).exists()] if fresh else [c for c in created if in_repo(c)]
        if to_add:
            if not dry:
                r = git(root, "add", "--", *to_add, git_dir=docs_git)
                if r.returncode:
                    print(f"! {DOCS_GIT}: git add failed — {r.stderr.strip().splitlines()[0]}")
            print(f"✓ {DOCS_GIT + '/':<40} — {'would stage' if dry else 'staged'} {len(to_add)} path(s), not committed")
        print(f"Project docs live in {DOCS_GIT}, never pushed. Commit them with:")
        print(f'  git --git-dir={DOCS_GIT} --work-tree=. commit -m "docs: ..."')
    else:
        if docs_git.is_dir():
            print(f"! {DOCS_GIT} left in place with its history; agentdrop no longer uses it")
        print("Project docs stay on this machine only, outside git.")

    tracked = [t for t in git(root, "ls-files", "-z", "--", *(p.rstrip("/") for p in docs_paths)).stdout.split("\0") if t]
    if tracked:
        specs = [p.rstrip("/") for p in docs_paths
                 if any(t == p.rstrip("/") or t.startswith(p) for t in tracked)]
        print(f"! {len(tracked)} of these files are still tracked in the code repo; the exclude list doesn't untrack them.")
        print(f"  Untrack them, keeping the files:  git rm -r -q --cached -- {' '.join(specs)}")
        print("  Past commits still contain them; removing them from history takes git filter-repo.")


def bootstrap_project(root: Path, dry: bool = False, docs: str | None = None,
                      research: bool | None = None) -> None:
    ensure_state()
    root = root.expanduser().resolve()
    if not root.exists():
        if dry:
            print(f"Would create directory: {root}")
        else:
            root.mkdir(parents=True)
    if not root.is_dir():
        raise SystemExit(f"Not a directory: {root}")

    print(f"\nProject: {root}")
    print("-" * min(80, len(str(root)) + 9))

    # AGENTS.md: the charter in a managed block; everything outside it is the project's own.
    # Existing project-specific content outside our managed block is preserved.
    agents = root / "AGENTS.md"
    kit = uses_kit(root)
    first_setup = not (agents.exists() and PROJECT_START in read(agents))
    if research is None:
        research = research_on(root) or (kit and first_setup and not dry and ask_research(root))
    # Common rules reach every harness through the global sync; repeating them here would
    # load them twice per session. The project block carries only the charter.
    project_payload = (read(CHARTER) if kit else PROJECT_BLOCK).rstrip()
    is_git, branch = git_info(root)
    # --docs, else the earlier answer; still unknown → asked once the layout is in place
    docs_mode = (docs or saved_docs_mode(root)) if kit and is_git else None
    save_mode = bool(docs_mode) and not dry
    if docs_mode and DOCS_NOTES[docs_mode]:
        project_payload += "\n\n" + DOCS_NOTES[docs_mode]
    if kit and not agents.exists() and not dry:
        write(
            agents,
            f"# {root.name}\n\n"
            "_What this project is, in one or two sentences. Project-specific rules go here,\n"
            "above the managed block; `agentdrop` refreshes the block below._\n",
        )
    changed, action = managed_merge(
        agents, project_payload, PROJECT_START, PROJECT_END, dry=dry
    )
    print(f"{'✓' if changed else '·'} AGENTS.md      — {action}")

    # Claude heuristic:
    # - If the repo already has CLAUDE.md, preserve it and import AGENTS.md.
    # - Otherwise create a tiny hidden shim so older Claude Code / disabled AGENTS support
    #   still sees AGENTS.md, without polluting the root with another full instruction file.
    root_claude = root / "CLAUDE.md"
    hidden_claude = root / ".claude" / "CLAUDE.md"
    if root_claude.exists():
        cpath, import_line = root_claude, "@AGENTS.md"
    elif hidden_claude.exists():
        cpath, import_line = hidden_claude, "@../AGENTS.md"
    else:
        cpath, import_line = hidden_claude, "@../AGENTS.md"
    changed, action = ensure_import(cpath, import_line, dry=dry)
    print(f"{'✓' if changed else '·'} Claude bridge  {cpath.relative_to(root)} — {action}")

    # Gemini does not use AGENTS.md by default; import it into its project context.
    gemini = root / "GEMINI.md"
    changed, action = ensure_import(gemini, "@AGENTS.md", dry=dry)
    print(f"{'✓' if changed else '·'} Gemini bridge  GEMINI.md — {action}")

    created = []
    if kit:
        created = copy_kit(root, dry=dry)
        created += apply_research(root, research, dry=dry)
        ensure_hooks(root, dry=dry)
    elif research:
        print("! Research mode needs the docs/ kit layout; migrate the old notes first.")
    elif CHARTER.exists():
        print("! Old layout (root HANDOFF/PROGRESS/...): docs/ kit not applied.")
        print("  To migrate, ask the agent to move the notes into the docs/ layout from ~/.agentdrop/kit, then run agentdrop again.")

    # Old layout only: create root memory docs if missing. Never overwrite project state.
    for filename, body in ({} if kit else TEMPLATES).items():
        path = root / filename
        if path.exists():
            print(f"· {filename:<14} — preserved existing")
            continue
        content = project_template_with_meta(filename, body, root)
        if not dry:
            write(path, content.rstrip() + "\n")
        print(f"✓ {filename:<14} — {'would create' if dry else 'created'}")

    # Report other instruction systems without trying to mash incompatible formats together.
    known = [
        root / ".github" / "copilot-instructions.md",
        root / ".cursorrules",
        root / ".windsurfrules",
        root / ".clinerules",
        root / ".cursor" / "rules",
        root / ".windsurf" / "rules",
    ]
    found = [p for p in known if p.exists()]
    if found:
        print("\nDetected extra harness-specific instructions; left untouched:")
        for p in found:
            print(f"  · {p.relative_to(root)}")

    if is_git and kit:
        print(f"\nGit repository detected (branch: {branch}).")
        if not docs_mode:
            docs_mode, save_mode = ask_docs_mode(dry)
            if docs_mode and DOCS_NOTES[docs_mode]:
                managed_merge(agents, project_payload + "\n\n" + DOCS_NOTES[docs_mode],
                              PROJECT_START, PROJECT_END, dry=dry)
                print("✓ AGENTS.md      — added the docs-in-git note to the managed block")
        if docs_mode:
            if save_mode:
                git(root, "config", DOCS_KEY, docs_mode)
            print(f"Docs mode: {docs_mode}{'' if save_mode or dry else ' (this run only)'}")
            apply_docs_mode(root, docs_mode, created, dry=dry)
    elif is_git:
        print(f"\nGit repository detected (branch: {branch}).")
        print("Project memory files are intentionally left trackable; the agent can commit them with the next coherent iteration.")
    else:
        print("\nNo Git repository detected. AgentDrop does not initialize Git automatically.")

    if dry:
        print("\nDry run only — nothing was changed.")
    else:
        print("\nDone. Open this folder in any harness; its own existing instructions were preserved.")


WIN_CMD_SHIM = """@echo off
rem agentdrop launcher for cmd and PowerShell; the script itself is agentdrop.py next to this file
rem "call": python may itself be a .bat shim (pyenv-win) that would otherwise never return
setlocal
set "AGENTDROP=%~dp0agentdrop.py"
call python -c "" >nul 2>&1 || goto trypy
call python "%AGENTDROP%" %*
exit /b %ERRORLEVEL%
:trypy
call py -3 -c "" >nul 2>&1 || goto nopython
call py -3 "%AGENTDROP%" %*
exit /b %ERRORLEVEL%
:nopython
echo agentdrop: Python 3 not found. Install it from python.org and tick "Add python.exe to PATH". 1>&2
exit /b 9009
"""

WIN_SH_SHIM = """#!/bin/sh
# agentdrop launcher for Git Bash / MSYS; the script itself is agentdrop.py next to this file
here=$(dirname "$0")
# the Microsoft Store "python" stub exists but fails, so probe before using
for py in python python3; do
  "$py" -c "" >/dev/null 2>&1 && exec "$py" "$here/agentdrop.py" "$@"
done
command -v py >/dev/null 2>&1 && exec py -3 "$here/agentdrop.py" "$@"
echo "agentdrop: Python 3 not found" >&2
exit 127
"""


def _win_user_path_add(bindir: Path) -> bool:
    """Put bindir on the user PATH (HKCU\\Environment) without setx: setx cuts PATH at 1024 chars
    and flattens %VARS%. Returns True if PATH changed."""
    import ctypes
    import winreg

    with winreg.OpenKey(winreg.HKEY_CURRENT_USER, "Environment", 0,
                        winreg.KEY_READ | winreg.KEY_WRITE) as key:
        try:
            value, kind = winreg.QueryValueEx(key, "Path")
        except FileNotFoundError:
            value, kind = "", winreg.REG_EXPAND_SZ
        parts = [p for p in value.split(";") if p]
        norm = lambda p: os.path.normcase(os.path.expandvars(p)).rstrip("\\/")
        if norm(str(bindir)) in {norm(p) for p in parts}:
            return False
        home = str(HOME)
        entry = "%USERPROFILE%" + str(bindir)[len(home):] if str(bindir).startswith(home) else str(bindir)
        if kind not in (winreg.REG_SZ, winreg.REG_EXPAND_SZ):
            kind = winreg.REG_EXPAND_SZ
        if "%" in entry:
            kind = winreg.REG_EXPAND_SZ
        winreg.SetValueEx(key, "Path", 0, kind, ";".join(parts + [entry]))
    # tell Explorer (and so new terminals) that the environment changed
    HWND_BROADCAST, WM_SETTINGCHANGE, SMTO_ABORTIFHUNG = 0xFFFF, 0x1A, 0x2
    ctypes.windll.user32.SendMessageTimeoutW(
        HWND_BROADCAST, WM_SETTINGCHANGE, 0, "Environment", SMTO_ABORTIFHUNG, 3000,
        ctypes.byref(ctypes.c_ulong()))
    return True


def install_self_windows(dry: bool = False) -> None:
    """Windows: agentdrop.py + agentdrop.cmd (cmd/PowerShell) + agentdrop (Git Bash) in ~/.local/bin."""
    src = Path(__file__).resolve()
    bindir = HOME / ".local" / "bin"
    dest = bindir / "agentdrop.py"
    on_path = os.path.normcase(str(bindir)) in {
        os.path.normcase(p.rstrip("\\/")) for p in os.environ.get("PATH", "").split(os.pathsep) if p}

    if dry:
        print(f"Would install {src} -> {dest}")
        print(f"Would create launchers {bindir / 'agentdrop.cmd'} and {bindir / 'agentdrop'}")
        if not on_path:
            print(f"Would add {bindir} to the user PATH")
        sync_globals(dry=True)
        return

    bindir.mkdir(parents=True, exist_ok=True)
    if dest.resolve() != src:
        backup(dest)
        dest.write_bytes(src.read_bytes().replace(b"\r\n", b"\n"))
    # cmd.exe wants CRLF in .cmd files; sh wants LF
    for name, body, nl in (("agentdrop.cmd", WIN_CMD_SHIM, "\r\n"), ("agentdrop", WIN_SH_SHIM, "\n")):
        shim = bindir / name
        if shim.exists() and shim.read_bytes() != body.replace("\n", nl).encode():
            backup(shim)
        with open(shim, "w", encoding="ascii", newline=nl) as f:
            f.write(body)

    print(f"Installed: {dest}")
    print(f"           {bindir / 'agentdrop.cmd'} (cmd, PowerShell) and {bindir / 'agentdrop'} (Git Bash)")
    if not on_path:
        try:
            if _win_user_path_add(bindir):
                print(f"Added to the user PATH: {bindir}")
        except OSError as e:
            print(f"! Could not update the user PATH ({e}). Add {bindir} to it by hand.")
    sync_globals(dry=False)
    print("\nOpen a new terminal (cmd, PowerShell or Git Bash), then use:")
    print("  cd $HOME\\Projects\\MyProject; agentdrop")
    print("or:")
    print("  agentdrop $HOME\\Projects\\MyProject")


def install_self(dry: bool = False) -> None:
    ensure_state()
    repo = Path(__file__).resolve().parent
    if not dry and (repo / ".git").exists():   # the harvest skill proposes upstream edits here
        write(SOURCE, str(repo) + "\n")
    if WINDOWS:
        install_self_windows(dry)
        return
    src = Path(__file__).resolve()
    bindir = HOME / ".local" / "bin"
    dest = bindir / "agentdrop"

    if dry:
        print(f"Would install {src} -> {dest}")
        sync_globals(dry=True)
        return

    bindir.mkdir(parents=True, exist_ok=True)
    if dest.exists() and dest.resolve() != src:
        backup(dest)
    if dest.resolve() != src:
        shutil.copy2(src, dest)
    dest.chmod(dest.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

    # macOS default shell is zsh. Add ~/.local/bin to PATH only when needed.
    path_parts = os.environ.get("PATH", "").split(os.pathsep)
    if str(bindir) not in path_parts:
        zshrc = HOME / ".zshrc"
        start = "# >>> agentdrop PATH >>>"
        end = "# <<< agentdrop PATH <<<"
        payload = 'export PATH="$HOME/.local/bin:$PATH"'
        managed_merge(zshrc, payload, start, end, dry=False)

    print(f"Installed: {dest}")
    sync_globals(dry=False)
    print("\nOpen a new Terminal window, then use:")
    print("  cd ~/Projects/MyProject && agentdrop")
    print("or:")
    print("  agentdrop ~/Projects/MyProject")


