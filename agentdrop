def pid_alive(raw: str) -> bool:
    """False only when the lock names a process that is gone; an empty or foreign lock counts as held."""
    if not raw.strip().isdigit() or platform.system() == "Windows":
        return True
    try:
        os.kill(int(raw), 0)
        return True
    except ProcessLookupError:
        return False
    except OSError:
        return True


class tg_lock:
    """A lock file, so two sessions running `status` at once don't both take the same answer.
    Without `wait` it gives up at once: the listener service may be holding the bot."""

    def __init__(self, wait: bool = True):
        self.tries = 50 if wait else 1

    def __enter__(self):
        import time
        STATE.mkdir(parents=True, exist_ok=True)
        for _ in range(self.tries):
            try:
                fd = os.open(TG_LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
                os.write(fd, str(os.getpid()).encode())
                os.close(fd)
                return self
            except FileExistsError:
                try:
                    if time.time() - TG_LOCK.stat().st_mtime > 120 or not pid_alive(TG_LOCK.read_text()):
                        TG_LOCK.unlink()
                        continue
                except OSError:
                    continue
                if self.tries > 1:
                    time.sleep(0.2)
        raise TgBusy("another agentdrop holds the Telegram lock")

    def __exit__(self, *exc):
        try:
            TG_LOCK.unlink()
        except OSError:
            pass


