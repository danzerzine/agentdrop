def watch_replies() -> int:
    """The listener: long-polls the bot so buttons and replies get an answer within seconds. It waits
    for Telegram without the lock and takes it only to write, so a brief can go out meanwhile;
    `status` and `brief` see its heartbeat and leave the bot's updates to it."""
    import time
    print(f"{dt.datetime.now():%d.%m %H:%M:%S} listening", flush=True)
    while True:
        TG_BEAT.touch()
        env = tg_env()
        if not env:
            time.sleep(60)
            continue
        try:
            ups = get_updates(env, tg_state()["offset"], timeout=20, wait=25)
            notes = []
            if ups:
                with tg_lock():
                    notes = pull_replies(env, tg_state(), load_config(), ups=ups)
        except TgError as e:
            notes = [f"! Telegram: {e}"]
            time.sleep(15)
        for n in notes:
            print(f"{dt.datetime.now():%d.%m %H:%M:%S} {n}", flush=True)


def launchd(label: str, args: list[str], action: str, log: Path, extra: dict, what: str) -> int:
    """macOS: an agentdrop command as a launchd agent (on / off / status)."""
    uid = os.getuid() if hasattr(os, "getuid") else 0
    target, plist = f"gui/{uid}/{label}", HOME / "Library" / "LaunchAgents" / f"{label}.plist"
    if platform.system() != "Darwin":
        print(f"agentdrop: run `agentdrop {' '.join(args)}` under your system's service manager (log: {log})",
              file=sys.stderr)
        return 2
    if action in ("off", "on"):
        subprocess.run(["launchctl", "bootout", target], capture_output=True)
    if action == "off":
        plist.unlink(missing_ok=True)
        print(f"✓ {what} stopped")
        return 0
    if action == "on":
        import plistlib
        exe = Path(shutil.which("agentdrop") or sys.argv[0]).resolve()
        path = ":".join([str(HOME / ".local" / "bin"), "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin"])
        plist.parent.mkdir(parents=True, exist_ok=True)
        plist.write_bytes(plistlib.dumps({
            "Label": label, "ProgramArguments": [sys.executable, str(exe), *args],
            "EnvironmentVariables": {"PATH": path, "HOME": str(HOME), "PYTHONUNBUFFERED": "1"},
            "StandardOutPath": str(log), "StandardErrorPath": str(log), **extra}))
        r = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(plist)], capture_output=True, text=True)
        if r.returncode != 0:
            print(f"agentdrop: launchctl: {r.stderr.strip()}", file=sys.stderr)
            return 1
        print(f"✓ {what} on ({exe}); log: {log}")
        return 0
    r = subprocess.run(["launchctl", "print", target], capture_output=True, text=True)
    state = re.search(r"^\s*state = (.+)$", r.stdout, re.M)
    print(f"{what}: {state.group(1) if state else 'not installed'}; log: {log}")
    return 0


def service(action: str) -> int:
    """The listener as a launchd agent, started at login and restarted if it dies."""
    return launchd(SERVICE, ["replies", "--watch"], action, SERVICE_LOG,
                   {"RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 30}, "listener")


def cmd_replies(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop replies",
                                description="Take the owner's Telegram messages, buttons and reactions into the "
                                            "project docs. `status` and `brief --send` do this too, unless the "
                                            "listener already has.")
    p.add_argument("--watch", action="store_true", help="Keep listening (what the service runs)")
    p.add_argument("--service", choices=("on", "off", "status"),
                   help="macOS: run the listener in the background, from login on")
    a = p.parse_args(argv)
    if a.service:
        return service(a.service)
    if not tg_env():
        print(f"agentdrop replies: Telegram isn't set up ({TG_ENV})", file=sys.stderr)
