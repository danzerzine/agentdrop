# ---------------------------------------------------------------------------
# Push loop, pass 3: `agentdrop accept B41`, the acceptance loop.
# The project's checks (docs/checks) run first; a failure goes back to the worker, no judge.
# When they pass, a fresh headless judge reads the ticket, its spec, the diff since the claim
# and the check output, never the worker's report, and returns PASS, REJECT or BLOCKED.
# REJECT goes back to the worker; the ACCEPT_REJECTS-th REJECT and any BLOCKED go to the owner.
# Each step is recorded in docs/.runs/B41.json before it starts, so a crashed run resumes.

RUNS = Path("docs") / ".runs"        # B41.json and B41/ logs; ignored by its own .gitignore
CHECKS = Path("docs") / "checks"     # one shell command per line, run from the project root
JUDGE = "claude -p --agent acceptance-judge --allowedTools Read,Grep,Glob,Bash --no-session-persistence"
ACCEPT_REJECTS = 3                   # two repairs, then the third REJECT goes to the owner
SPEC_RE = re.compile(r"(?:docs/)?specs/[\w./-]+\.md")
VERDICT_SCHEMA = {
    "type": "object", "required": ["verdict", "summary", "findings"],
    "properties": {
        "verdict": {"type": "string", "enum": ["PASS", "REJECT", "BLOCKED"]},
        "summary": {"type": "string"},
        "findings": {"type": "array", "items": {
            "type": "object", "required": ["severity", "what"],
            "properties": {"severity": {"type": "string", "enum": ["blocker", "remark"]},
                           "what": {"type": "string"}, "evidence": {"type": "string"}}}},
    },
}
ACCEPT = {
    "kind_pass": ("✅ {p} · ACCEPTED", "✅ {p} · ПРИНЯТО"),
    "kind_owner": ("⛔ {p} · NEEDS YOU", "⛔ {p} · НУЖЕН ТЫ"),
    "sub_pass": ("{t}, accepted on try {n}", "{t}, принято с {n}-й попытки"),
    "sub_reject": ("{t}: the judge rejected it {n} times", "{t}: судья отклонил {n} раза"),
    "sub_blocked": ("{t}: the judge can't decide without you", "{t}: судья не может решить без тебя"),
    "judge": ("Judge", "Судья"),
    "blockers": ("What's wrong", "Что не так"),
    "remarks": ("Remarks, not blocking", "Замечания, не блокируют"),
    "hint_pass": ("↩️ Anything to add: reply, it goes under the ticket in TODO.md.",
                  "↩️ Есть что добавить — ответь реплаем, запишу под тикет в TODO.md."),
    "hint_owner": ("↩️ Reply with what to do: it goes under the ticket in TODO.md, the agent reads it.",
                   "↩️ Ответь реплаем, что делать: запишу под тикет в TODO.md, агент прочтёт."),
