def remove_block(placed: dict) -> bool:
    """Take back the lines a placement added, if they are still there untouched."""
    path = Path(placed["path"])
    if not path.is_file():
        return False
    lines, block = read(path).split("\n"), placed["lines"]
    for i in range(len(lines) - len(block) + 1):
        if lines[i:i + len(block)] == block:
            del lines[i:i + len(block)]
            write(path, "\n".join(lines))
            return True
    return False


def run_router(cfg: dict, prompt: str) -> dict:
    import shlex
    cmd = cfg.get("router", ROUTER)
    if cmd.lower() in ("off", "none", ""):
        return {}
    try:
        r = subprocess.run(shlex.split(os.path.expanduser(cmd)), input=prompt, capture_output=True, text=True,
                           timeout=90)
        m = re.search(r"\{.*\}", r.stdout, re.S)
        return json.loads(m.group(0)) if r.returncode == 0 and m else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


def project_blurb(root: Path) -> str:
    """One line on what a project is, for the router: the first plain paragraph of its CONTEXT or README."""
    for name in (root / "docs" / "CONTEXT.md", root / "README.md"):
        if name.is_file():
            for para in re.split(r"\n\s*\n", read(name)):
                t = para.strip()
                if t and not t.startswith(("#", "|", ">", "```", "<!--", "_", "- ")):
                    return clip(re.sub(r"[*`]", "", t), 160)
    return ""


def route(cfg: dict, text: str, ref: dict | None, projects: dict[str, dict]) -> dict:
    """Where the owner's chat message belongs: "item", "project" (a new question there), "agentdrop"
    (about the bot and the messages), "status" (they ask what's going on), or "unclear". An LLM reads
    it; Python only acts on the label."""
    opts = []
    if ref and ref["kind"] != "brief":
        opts.append(f'- "item": an answer or comment about this item of {ref["project"]}: «{ref["title"]}»')
    if ref:
        opts.append(f'- "project": for project {ref["project"]}, but not about that item: a new task, idea or question')
    else:
        opts += [f'- "project:{p}": for project {p}' for p in projects]
        opts.append('- "unclear": can\'t tell which project')
    opts.append('- "agentdrop": about the bot itself: its messages, their format, buttons, summaries, '
                'or how the owner wants to be asked')
    opts.append('- "status": they ask what is going on, what is next or what is needed from them right now')
    known = "\n".join(f"- {p}: {project_blurb(Path(v['root']))}" for p, v in projects.items())
    prompt = ("The owner of several software projects chats with a Telegram bot that sends them the projects' questions "
              "and summaries. Decide where the owner's message belongs.\n\nOptions:\n" + "\n".join(opts) +
              (f"\n\nTheir projects:\n{known}" if known else "") +
              f"\n\nTheir message:\n«{text}»\n\nIf they react to the item (ask about it, say they don't "
              "understand it, answer it) and also make a general point about how questions or messages "
              "should be written, choose the item route and set also_agentdrop.\n\nAnswer with JSON only: "
              '{"route": "<option>", "why": "<at most 10 words, in the language of their message>", '
              '"also_agentdrop": <true if, besides the main route, they also say how questions or messages '
              'should be written in general>, "projects": [<for "status": the projects they mean, '
              'from the list; empty for all>]}')
    got = run_router(cfg, prompt)
    label, why = str(got.get("route", "")), clip(str(got.get("why", "")), 100)
    valid = {o.split('"')[1] for o in opts}
    if label not in valid:
        label, why = ("item" if ref and ref["kind"] != "brief" else "project" if ref else "unclear"), ""
    names = [p for p in got.get("projects") or [] if p in projects] if isinstance(got.get("projects"), list) else []
    return {"route": label, "why": why, "also": bool(got.get("also_agentdrop")) and label not in ("agentdrop", "status"),
            "projects": names}


def board_message(s: dict) -> str:
    """The answer to "what's going on": what waits for the owner, what runs, what's next."""
    ru = s["ru"]
    B = lambda k, **kw: BRIEF[k][ru].format(**kw)
    out = [f"<b>{tg_html(B('kind_board', p=s['label']))}</b>"]
    w = s["waiting"]
    items = [q["title"] for q in w["questions"]] + [f"{t['title']} ({t['id']})" for t in w["tickets"]]
    if items:
        rows = [f"{k}. {tg_html(clip(t, 110))}" for k, t in enumerate(items[:6], 1)]
        if len(items) > 6:
            rows.append(f"… {LABELS['more'][ru].format(n=len(items) - 6)}")
        out.append(f"<b>{B('waiting', n=len(items))}</b>\n" + "\n".join(rows))
    r = s["running"]
    rows = [f"• {tg_html(c['title'] or c.get('ticket', ''))} ({c.get('ticket')})" for c in r["claims"][:5]]
    if r["unclaimed_active_sessions"]:
        rows.append("• " + LABELS["unclaimed"][ru].format(n=r["unclaimed_active_sessions"], m=r["active_minutes"]))
    out.append(f"<b>{B('running')}</b>\n" + ("\n".join(rows) or LABELS["nothing"][ru]))
    nxt = s["next"]["tickets"][:3]
    if nxt:
        out.append(f"<b>{B('next')}</b>\n" + "\n".join(
            f"{k}. {tg_html(t['title'])} <i>({t['id']}, {t['priority']})</i>" for k, t in enumerate(nxt, 1)))
    if s["next"].get("blocked"):
        out.append(f"<b>{B('blocked')}</b>\n" + "\n".join(
            f"• {tg_html(clip(t['title'], 80))} <i>({t['id']})</i>" for t in s["next"]["blocked"][:5]))
    return "\n\n".join(out)


def answer_status(env: dict, st: dict, cfg: dict, names: list[str], projects: dict, reply_to: int) -> list[str]:
    now = dt.datetime.now().astimezone().isoformat()
    notes = []
    for name in names or list(projects):
        root = Path(projects[name]["root"])
        if not tasks_of(root, cfg).present():
            continue
        s = {**collect_status(root), "label": project_label(root, cfg)}
        mid = tg_send(env, board_message(s), reply_to=reply_to)
        st["messages"][str(mid)] = {**projects[name], "project": s["label"], "at": now}
        notes.append(f"· Telegram: {s['label']} → {BRIEF['kind_board'][s['ru']].format(p=s['label'])}")
    return notes


def place(st: dict, cfg: dict, dest: str, ref: dict | None, author: str, when: str, text: str) -> dict:
    if dest == "agentdrop":
        return add_feedback(ref, author, when, text)
    if dest == "project":
        ref = {**ref, "kind": "project", "item_title": ref["kind"] != "brief"}
    return tasks_of(Path(ref["root"]), cfg).comment(ref, author, when, text)


def ack_for(placed: dict, ref: dict | None, ru: bool, why: str) -> tuple[str, dict | None]:
    """The bot's confirmation, and buttons to move the words if the router got it wrong."""
    B = lambda k, **kw: BRIEF[k][ru].format(**kw)
    if placed["how"] == "feedback":
        text = B("feedback", path=Path(placed["path"]).name)
    else:
        text = B(placed["how"], title=clip(ref["title"], 80), project=ref["project"],
                 doc=Path(placed["path"]).name)
    if why:
        text += f"\n<i>{tg_html(why)}</i>"
    here = {"saved": "item", "moved": "project", "noted": "project", "feedback": "agentdrop"}[placed["how"]]
    buttons = []
    if ref and ref["kind"] not in ("brief",) and here != "item":
        buttons.append({"text": B("mv_item"), "callback_data": "mv:item"})
    if ref and here != "project":
        buttons.append({"text": B("mv_project", project=ref["project"]), "callback_data": "mv:project"})
    if here != "agentdrop":
        buttons.append({"text": B("mv_agentdrop"), "callback_data": "mv:agentdrop"})
    return text, ({"inline_keyboard": [[b] for b in buttons]} if buttons else None)


def recent_projects(st: dict, cfg: dict) -> dict[str, dict]:
    """The projects the bot has written about, by their short names."""
    out = {}
    for v in sorted(st["messages"].values(), key=lambda v: v.get("at", "")):
        if Path(v["root"]).is_dir():
            name = project_label(Path(v["root"]), cfg)
            out[name] = {"root": v["root"], "project": name, "ru": v.get("ru"), "doc": "QUESTIONS.md",
                         "kind": "brief", "key": "", "title": name}
    return out


def take_message(env: dict, st: dict, cfg: dict, m: dict) -> list[str]:
    now = dt.datetime.now().astimezone().isoformat()
    rt = m.get("reply_to_message") or {}
    ref = st["messages"].get(str(rt.get("message_id"))) if rt else None
    text = (m.get("text") or m.get("caption") or "").strip()
    ru = bool(ref.get("ru")) if ref else owner_ru(cfg)
    B = lambda k, **kw: BRIEF[k][ru].format(**kw)
    if not text or text.startswith("/") or (ref and not Path(ref["root"]).is_dir()):
        if text.startswith("/") or (not ref and not text):
            return []
        reason = B("text_only") if not text else B("no_project", project=ref["project"], root=ref["root"])
        tg_send(env, reason, reply_to=m.get("message_id"))
        return [f"· Telegram: {reason}"]
    also = False
    if ref and ref.get("force"):
        dest, why = ref["force"], ""
    else:
        projects = recent_projects(st, cfg)
        r = route(cfg, text, ref, projects)
        dest, why, also = r["route"], r["why"], r["also"]
        if dest == "status":
            return answer_status(env, st, cfg, r["projects"], projects, m.get("message_id"))
        if dest.startswith("project:"):
            ref, dest = projects[dest.split(":", 1)[1]], "project"
    if dest == "unclear":
        if dt.datetime.now().timestamp() - st.get("hint_at", 0) < HINT_HOURS * 3600:
            return [f"· Telegram: «{clip(text, 60)}» — not tied to any project, left as is"]
        st["hint_at"] = dt.datetime.now().timestamp()
        tg_send(env, B("not_item"), reply_to=m.get("message_id"))
        return [f"· Telegram: «{clip(text, 60)}» → {B('not_item')}"]
    when = dt.datetime.fromtimestamp(m.get("date", 0)).strftime("%d.%m %H:%M")
    author = owner_name(cfg, ru)
    placed = place(st, cfg, dest, ref, author, when, text)
    if also:   # an answer to the item that also says how questions should be asked: agentdrop keeps a copy
        add_feedback(ref, author, when, text)
        why = (why + "; " if why else "") + B("also_feedback")
    if placed["next"]:   # the owner's own message now stands for the thread: a reply to it continues it
        st["messages"][str(m.get("message_id"))] = {**placed["next"], "at": now}
    save_tg_state(st)    # before the ack: a failed ack must never write the answer twice
    ack, kb = ack_for(placed, ref, ru, why)
    mid = tg_send(env, ack, reply_to=m.get("message_id"), markup=kb)
    st["placed"][str(mid)] = {**placed, "ref": ref, "text": text, "when": when, "author": author, "ru": ru,
                              "src": m.get("message_id"), "at": now}
    if placed["next"]:
        st["messages"][str(mid)] = {**placed["next"], "at": now}
    return [f"· Telegram: {tg_plain(ack)}"]


def take_callback(env: dict, st: dict, cfg: dict, q: dict) -> list[str]:
    """Buttons: OK / not OK under an item, and "move it" under the bot's confirmations."""
    m = q.get("message") or {}
    mid, data = str(m.get("message_id")), q.get("data", "")
    if str(m.get("chat", {}).get("id")) != str(env["TG_CHAT_ID"]):
        return []
    now = dt.datetime.now().astimezone().isoformat()
    toast, notes = "", []
    ref = st["messages"].get(mid)
    ru = bool(ref.get("ru")) if ref else owner_ru(cfg)
    B = lambda k, **kw: BRIEF[k][ru].format(**kw)
    if data == "ok" and ref and Path(ref["root"]).is_dir():
        when = dt.datetime.now().strftime("%d.%m %H:%M")
        placed = tasks_of(Path(ref["root"]), cfg).comment(ref, owner_name(cfg, ru), when, B("button_ok"))
        toast = B(placed["how"], title=clip(ref["title"], 60), project=ref["project"], doc=Path(placed["path"]).name)
        tg_try(env, "editMessageReplyMarkup", {"chat_id": env["TG_CHAT_ID"], "message_id": int(mid), "reply_markup": {
            "inline_keyboard": [[{"text": B("ok_done"), "callback_data": "noop"}]]}})
        notes.append(f"· Telegram: {B('button_ok')} → {toast}")
    elif data == "no" and ref:
        pid = tg_send(env, B("not_ok_prompt", title=tg_html(clip(ref["title"], 80))), reply_to=int(mid),
                      markup={"force_reply": True, "input_field_placeholder": B("not_ok_placeholder")})
        st["messages"][str(pid)] = {**ref, "force": "item", "at": now}
    elif data.startswith("mv:") and mid in st["placed"]:
        p = st["placed"][mid]
        dest = data[3:]
        removed = remove_block(p) if p["how"] == "feedback" else tasks_of(Path(p["ref"]["root"]), cfg).take_back(p)
        placed = place(st, cfg, dest, p["ref"], p["author"], p["when"], p["text"])
        if placed["next"]:
            st["messages"][str(p["src"])] = {**placed["next"], "at": now}
            st["messages"][mid] = {**placed["next"], "at": now}
        ack, kb = ack_for(placed, p["ref"], p["ru"], "" if removed else B("left_copy"))
        st["placed"][mid] = {**p, **placed}
        tg_try(env, "editMessageText", {"chat_id": env["TG_CHAT_ID"], "message_id": int(mid), "text": ack,
                                        "parse_mode": "HTML", "reply_markup": kb or {"inline_keyboard": []}})
        toast = tg_plain(ack).split("\n")[0]
        notes.append(f"· Telegram: {B('moved_to')} → {toast}")
    save_tg_state(st)
    tg_try(env, "answerCallbackQuery", {"callback_query_id": q.get("id"), "text": clip(toast, 190)})
    return notes


def get_updates(env: dict, offset: int, timeout: float = 20, wait: int = 0) -> list:
    return tg_call(env, "getUpdates", {"offset": offset, "timeout": wait,
                                       "allowed_updates": ["message", "message_reaction", "callback_query"]},
                   timeout=timeout + wait)


def pull_replies(env: dict, st: dict, cfg: dict, timeout: float = 20, ups: list | None = None) -> list[str]:
    notes = []
    if ups is None:
        ups = get_updates(env, st["offset"], timeout)
    for u in ups:
        if u["update_id"] < st["offset"]:
            continue
        st["offset"] = u["update_id"] + 1
        save_tg_state(st)   # an update that breaks something is never taken twice
        if u.get("message_reaction"):
            notes += reaction_answer(env, st, cfg, u["message_reaction"])
        elif u.get("callback_query"):
            notes += take_callback(env, st, cfg, u["callback_query"])
        elif str((u.get("message") or {}).get("chat", {}).get("id")) == str(env["TG_CHAT_ID"]):
            notes += take_message(env, st, cfg, u["message"])
        save_tg_state(st)
    return notes


def reaction_answer(env: dict, st: dict, cfg: dict, r: dict) -> list[str]:
    """A 👍 on an item's message is the owner's OK, a 👎 a no; both go under the item like a reply."""
    ref = st["messages"].get(str(r.get("message_id")))
    if str(r.get("chat", {}).get("id")) != str(env["TG_CHAT_ID"]) or not ref or ref["kind"] == "brief":
        return []
    old = {x.get("emoji") for x in r.get("old_reaction", [])}
    new = [x.get("emoji") for x in r.get("new_reaction", []) if x.get("emoji") not in old]
    e = next((x for x in new if x in OK_REACTIONS | NO_REACTIONS), None)
    if not e or not Path(ref["root"]).is_dir():
        return []
    ru = bool(ref.get("ru"))
    text = BRIEF["reaction_no" if e in NO_REACTIONS else "reaction_ok"][ru].format(e=e)
    when = dt.datetime.fromtimestamp(r.get("date", 0)).strftime("%d.%m %H:%M")
    placed = tasks_of(Path(ref["root"]), cfg).comment(ref, owner_name(cfg, ru), when, text)
    save_tg_state(st)
    ack = BRIEF[placed["how"]][ru].format(title=clip(ref["title"], 80), project=ref["project"],
                                          doc=Path(placed["path"]).name)
    mid = tg_send(env, f"{text}. {ack}", reply_to=r.get("message_id"))
    st["messages"][str(mid)] = {**placed["next"], "at": dt.datetime.now().astimezone().isoformat()}
    return [f"· Telegram: {text} → {ack}"]


def sync_replies(timeout: float = 20, wait: bool = False) -> list[str]:
    """Pull the owner's answers into the docs; quiet no-op when Telegram isn't set up, and when the
    listener service (`agentdrop replies --watch`) holds the bot: it has already taken them."""
    env = tg_env()
    if not env or os.environ.get("AGENTDROP_OFFLINE") or listener_alive():
        return []
    try:
        with tg_lock(wait=wait):
            return pull_replies(env, tg_state(), load_config(), timeout)
    except TgBusy:
        return []
    except TgError as e:
        return [f"! Telegram: {e}"]


def project_label(root: Path, cfg: dict) -> str:
    """The name on the owner's phone: `alias.<folder> = name` in the config, else the folder
    without a trailing date."""
    return cfg.get(f"alias.{root.name}") or re.sub(r"[-_]\d{4}-\d{2}-\d{2}$", "", root.name)


def split_title(title: str) -> tuple[str, str]:
    """"Title (B116 — what it is, 27.09)" → ("Title", "B116 — what it is, 27.09")."""
    m = re.match(r"(.+?)\s*\(([^()]*(?:\([^()]*\)[^()]*)*)\)$", title)
    return (m.group(1), m.group(2)) if m else (title, "")


def wants_ok(kind: str, it: dict) -> bool:
    """An item the owner can settle with a 👍: a question with the agent's proposal, or a ticket
    that waits for the owner's OK."""
    return bool(it["pick"]) if kind == "question" else bool(OK_ASK_RE.search(it["waits"]))


def item_message(s: dict, kind: str, it: dict, pos: str = "") -> str:
    ru = s["ru"]
    B = lambda k, **kw: BRIEF[k][ru].format(**kw)
    ok = wants_ok(kind, it)
    title, sub = split_title(it["title"]) if kind == "question" else (it["title"], f"{it['id']}, {it['priority']}")
    parts = [f"<b>{tg_html(B('kind_ok' if ok else 'kind_decision', p=s['label'], pos=pos))}</b>",
             f"<b>{tg_html(title)}</b>" + (f"\n<i>{tg_html(sub)}</i>" if sub else "")]
    body = it.get("detail") or it.get("waits") or ""
    if ok and kind == "question" and it["pick"] in body:   # the proposal gets its own line, not twice
        body = re.sub(r"\s{2,}", " ", body.replace(it["pick"], "")).strip()
    if kind == "ticket" and it["why"]:
        parts.append(f"<b>{LABELS['why'][ru].capitalize()}:</b> {tg_html(it['why'])}")
    if body:
        parts.append(f"<blockquote>{tg_html(body)}</blockquote>")
    if kind == "question" and it["pick"] and (ok or it["pick"][:60] not in body):
        parts.append(f"<b>{B('pick')}:</b> {tg_html(it['pick'])}")
    if it.get("last"):
        parts.append(f"<b>{B('last')}:</b>\n<blockquote>{tg_html(it['last'])}</blockquote>")
    parts.append(f"<i>{tg_html(B('ok_hint' if ok else 'reply_hint', doc=it.get('doc', 'TODO.md')))}</i>")
    return "\n\n".join(parts)


def head_message(s: dict, new: int, earlier: int, later: int) -> str:
    ru = s["ru"]
    B = lambda k, **kw: BRIEF[k][ru].format(**kw)
    out = [f"<b>{tg_html(B('kind_brief', p=s['label']))}</b>"]
    # the owner reads what was done while they were away first, then what waits for them
    done = s["done"]["entries"]
    if done:
        rows = [f"• {tg_html(clip(e['heading'], 110))}" for e in done[:8]]
        if len(done) > 8:
            rows.append(f"… {LABELS['more'][ru].format(n=len(done) - 8)}")
        out.append(f"<b>{B('done', n=len(done))}</b>\n<blockquote expandable>" + "\n".join(rows) + "</blockquote>")
    w = s["waiting"]
    total = len(w["questions"]) + len(w["tickets"])
    if total or w["your_turn"]:
        block = [f"<b>{B('waiting', n=total)}</b>"] if total else []
        block += [B(k, n=n) for k, n in (("below", new), ("earlier", earlier), ("later", later)) if n]
        if w["your_turn"]:
            block.append(B("your_turn", n=len(w["your_turn"])))
        out.append("\n".join(block))
    claims = s["running"]["claims"]
    if claims:
        rows = []
        for c in claims[:5]:
            idle = age(c["idle_seconds"], ru)
            state = LABELS["stale"][ru].format(a=idle) if c["stale"] else LABELS["active"][ru].format(a=idle)
            rows.append(f"• {tg_html(c['title'] or c.get('ticket', ''))} ({c.get('ticket')})\n  <i>{state}</i>")
        out.append(f"<b>{B('running')}</b>\n" + "\n".join(rows))
    nxt = s["next"]["tickets"][:3]
    if nxt:
        out.append(f"<b>{B('next')}</b>\n" + "\n".join(
            f"{k}. {tg_html(t['title'])} <i>({t['id']}, {t['priority']})</i>" for k, t in enumerate(nxt, 1)))
    out.append(f"<i>{tg_html(B('head_hint'))}</i>")
    return "\n\n".join(out)


def plan_brief(root: Path, s: dict, st: dict, cfg: dict, everything: bool = False) -> list[dict]:
    """The messages a brief sends now: the head, then items that are new, changed or unanswered
    for RESEND_HOURS. Empty when nothing changed since the last brief."""
    now = dt.datetime.now().astimezone()
    resend = float(cfg.get("brief_resend_hours", RESEND_HOURS))
    s = {**s, "label": project_label(root, cfg)}
    w = s["waiting"]
    fresh, earlier = [], 0
    for kind, it in [("question", q) for q in w["questions"]] + [("ticket", t) for t in w["tickets"]]:
        doc_name = it.get("doc", "TODO.md")
        key = it["key"] if kind == "question" else it["id"]
        ident = f"{root}|{doc_name}|{key}"
        digest = sha(item_message(s, kind, it).encode())[:16]   # without "2/5", which moves between briefs
        prev = st["items"].get(ident)
        sent = parse_time(prev.get("at", "")) if prev else None
        if (not everything and prev and prev.get("hash") == digest and sent
                and (now - sent).total_seconds() < resend * 3600):
            earlier += 1
            continue
        code = re.match(r"\*\*([A-ZА-ЯЁ]{1,3}-\d+)\.", key) if kind == "question" else None
        fresh.append({"kind": kind, "it": it, "ident": ident, "hash": digest, "ok": wants_ok(kind, it),
                      "images": it.get("images", []),
                      "ref": {"root": str(root), "project": s["label"], "doc": doc_name, "kind": kind,
                              "key": key, "code": code.group(1) if code else "", "title": it["title"],
                              "ru": s["ru"]}})
    limit = int(cfg.get("brief_items", BRIEF_ITEMS))
    later = max(0, len(fresh) - limit)
    fresh = fresh[:limit]
    for k, f in enumerate(fresh, 1):
        f["text"] = item_message(s, f["kind"], f.pop("it"), f", {k}/{len(fresh)}" if len(fresh) > 1 else "")
    if not (everything or fresh or s["done"]["entries"]):
        return []
    head = {"kind": "head", "text": head_message(s, len(fresh), earlier, later),
            "ref": {"root": str(root), "project": s["label"], "doc": "QUESTIONS.md", "kind": "brief", "key": "",
                    "title": BRIEF["kind_brief"][s["ru"]].format(p=s["label"]), "ru": s["ru"]}}
    return [head, *fresh]


def deliver(msgs: list[dict], st: dict, env: dict, cfg: dict) -> str:
    """Send the brief: Telegram when ~/.agentdrop/telegram.env is set, else the `notify` command."""
    now = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    for m in msgs:
        if env:
            mid = tg_send(env, m["text"], markup={"inline_keyboard": [[
                {"text": BRIEF["button_ok_label"][m["ref"]["ru"]], "callback_data": "ok"},
                {"text": BRIEF["button_no_label"][m["ref"]["ru"]], "callback_data": "no"}]]} if m.get("ok") else None)
            if m.get("ref"):
                st["messages"][str(mid)] = {**m["ref"], "at": now}
            if m.get("images"):   # before/after pictures right under the item; a reply to one answers it too
                try:
                    for pid in tg_photos(env, m["images"], mid):
                        st["messages"][str(pid)] = {**m["ref"], "at": now}
                except (TgError, OSError) as e:
                    print(f"! Telegram: pictures for «{clip(m['ref']['title'], 60)}» not sent: {e}", file=sys.stderr)
        else:
            r = subprocess.run(os.path.expanduser(cfg["notify"]), shell=True, input=tg_plain(m["text"]),
                               text=True, capture_output=True)
            if r.returncode != 0:
                raise TgError(f"notify exited {r.returncode}: {clip(r.stderr, 200)}")
        if m.get("ident"):
            st["items"][m["ident"]] = {"hash": m["hash"], "at": now}
        save_tg_state(st)
    return "Telegram" if env else cfg["notify"]


def cmd_brief(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop brief",
                                description="The owner's brief: a short head message and one message per item "
                                            "that waits for the owner. Prints it; --send delivers it.")
    p.add_argument("path", nargs="?", default=".", help="Project directory (default: the current one)")
    p.add_argument("--send", action="store_true",
                   help="Deliver to Telegram (~/.agentdrop/telegram.env) or the `notify` command in "
                        "~/.agentdrop/config, and remember what was sent")
    p.add_argument("--all", action="store_true", help="Every waiting item, also those sent recently")
    p.add_argument("--json", action="store_true", help="Machine-readable output")
    a = p.parse_args(argv)
    root = find_root(Path(a.path))
    if not tasks_of(root).present():
        print(f"agentdrop brief: no docs/TODO.md in {root} or above", file=sys.stderr)
        return 2
    cfg, env = load_config(), tg_env()
    if a.send:
        if not env and not cfg.get("notify"):   # not an error: the charter runs this in every project
            print(f"· agentdrop brief: nowhere to send, nothing sent. Put TG_BOT_TOKEN and TG_CHAT_ID in {TG_ENV}, "
                  f"or `notify = <command>` in {CONFIG}", file=sys.stderr)
            return 0
        for note in sync_replies(wait=True):   # answers first, so the brief doesn't ask what's already answered
            print(note, file=sys.stderr)
    s = collect_status(root)
    try:
        with tg_lock():
            st = tg_state()
            msgs = plan_brief(root, s, st, cfg, a.all)
            if a.json:
                print(json.dumps(msgs, ensure_ascii=False, indent=1))
            elif not a.send:
                print("\n\n———\n\n".join(tg_plain(m["text"]) for m in msgs) or
                      ("нового нет" if s["ru"] else "nothing new"))
            if not a.send:
                return 0
            if not msgs:
                print("· нового нет, ничего не отправлено" if s["ru"] else "· nothing new, nothing sent")
                return 0
            where = deliver(msgs, st, env, cfg)
    except TgError as e:
        print(f"agentdrop brief: {e}", file=sys.stderr)
        return 1
    mark_seen(root)
    items = len(msgs) - 1
    print(f"✓ {where}: сводка и пунктов {items}" if s["ru"] else f"✓ {where}: head and {items} items")
    return 0


