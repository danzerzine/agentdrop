        f"Do ticket {tid} («{t['title']}») in the project in this directory, started by agentdrop's dispatcher. "
        "The owner marked it [autonomous]: you may do it without asking.",
        "Read AGENTS.md, docs/STATE.md and the ticket in docs/TODO.md first and follow the project's charter.",
        "", HANDS_OFF, "",
        f"1. `agentdrop claim {tid} --session dispatcher`. If it is refused, stop.",
        "2. Do the work and commit it.",
        f"3. `agentdrop accept {tid}`. Exit 1: fix what it printed and run it again. Exit 3: stop, the ticket "
        "went to the owner. Exit 0: accepted.",
        f"4. Finish as the charter says: LOG entry (say that deploying waits for the owner, if the project deploys), "
        f"STATE if the picture changed, remove the ticket from TODO, commit, `agentdrop release {tid} --session "
        "dispatcher`. Release it also when you stop halfway.",
        "Answer in one or two sentences: what happened and the exit code of the last `agentdrop accept`.",
    ])


def run_worker(root: Path, cfg: dict, kind: str, prompt: str, minutes: float, schema: dict | None = None,
               verbose: bool = False) -> dict:
    """One headless worker session, recorded in docs/.runs/dispatch.json like an acceptance step."""
    import shlex
    runf = root / RUNS / "dispatch.json"
    run = load_run(runf)
    run.setdefault("steps", [])
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M")
    out = root / RUNS / "dispatch" / f"{stamp}-{kind}.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    (out.parent / f"{stamp}-{kind}.prompt.md").write_text(prompt, encoding="utf-8")
    cmd = shlex.split(os.path.expanduser(cfg.get("worker", WORKER)))
    if Path(cmd[0]).name == "claude" and "--output-format" not in cmd:
        cmd += ["--output-format", "stream-json", "--verbose"] + (["--json-schema", json.dumps(schema)] if schema else [])
    step = run_step(root, runf, run, {"step": kind}, cmd, out, minutes * 60, stdin=prompt,
                    progress=Progress(f"{root.name} · {kind}", verbose))
    text = (root / step["log"]).read_text(encoding="utf-8", errors="replace")
    env = claude_result(text) or {}
    res = env.get("structured_output") if isinstance(env, dict) else None
    if not isinstance(res, dict):
        m = re.search(r"\{.*\}", env.get("result", "") if isinstance(env, dict) else text, re.S)
        try:
            res = json.loads(m.group(0)) if m and schema else {}
        except ValueError:
            res = {}
        if not schema:
            res = {"notes": clip(env.get("result", "") if isinstance(env, dict) else text, 400)}
    res["exit"], res["log"] = step.get("exit"), step["log"]
    if isinstance(env, dict) and env.get("total_cost_usd") is not None:
        res["cost_usd"] = round(float(env["total_cost_usd"]), 2)
    step.update({k: v for k, v in res.items() if k in ("closed", "changed", "notes", "cost_usd")})
    save_run(runf, run)
    return res


def busy(root: Path, s: dict) -> str:
    """Why the dispatcher leaves a project alone right now; empty when it may work there."""
    claims = [c for c in s["running"]["claims"] if not c["stale"]]
    if claims:
        return ", ".join(f"{c.get('ticket')} ({c.get('agent', '')})" for c in claims)
    if s["running"]["unclaimed_active_sessions"]:
        return f"{s['running']['unclaimed_active_sessions']} active session(s)"
    run = load_run(root / RUNS / "dispatch.json")
    live = [st for st in run.get("steps", []) if "ended" not in st and pid_alive(str(st.get("pid", "")))]
    return f"dispatcher still running ({live[0]['step']})" if live else ""


def dispatch_state() -> dict:
    try:
        st = json.loads(DISPATCH_STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        st = {}
    today = dt.date.today().isoformat()
    if st.get("day") != today:
        st = {"day": today, "sent": 0, "runs": st.get("runs", {})}
    return st


def dispatch_one(root: Path, cfg: dict, dry: bool, log, pending: list, verbose: bool = False) -> None:
    s, src = collect_status(root), tasks_of(root, cfg)
    why = busy(root, s)
    if why:
        log(f"{root.name}: someone is working there ({why}), only the brief")
        return
    turn = len(s["waiting"]["your_turn"])
    if dry:
        auto = [t["id"] for t in s["next"]["tickets"] + s["next"]["rest"] if AUTONOMOUS_RE.search(src.ticket_text(t["id"]))]
        log(f"{root.name}: would tidy ({turn} answered by the owner, {len(s['next']['tickets'])} next)"
            + (f", then do {auto[0]}" if auto else ""))
        return
    claim = root / CLAIMS / "TIDY.json"
    claim.parent.mkdir(parents=True, exist_ok=True)
    if not (claim.parent / ".gitignore").exists():
        (claim.parent / ".gitignore").write_text("# agentdrop claims: local to this machine, never committed\n*\n",
                                                 encoding="utf-8")
    claim.write_text(json.dumps({"ticket": "TIDY", "title": "утренний разбор" if s["ru"] else "morning tidy",
                                 "session": "dispatcher", "agent": "dispatcher", "host": platform.node(),
                                 "started": dt.datetime.now().astimezone().isoformat(timespec="seconds")},
                                ensure_ascii=False), encoding="utf-8")
    before = {e["heading"] for e in log_entries(root)}
    try:
        log(f"{root.name}: " + ("утренний разбор — сессия Claude, до {} мин" if s["ru"] else
                                "morning tidy — a Claude session, up to {} min").format(int(float(cfg.get("tidy_timeout_min", 30)))))
        r = run_worker(root, cfg, "tidy", tidy_prompt(s, isinstance(src, StoreTasks)), float(cfg.get("tidy_timeout_min", 30)), TIDY_SCHEMA, verbose)
    finally:
        claim.unlink(missing_ok=True)
    if r.get("report"):
        pending.append((root, r["report"], [e["heading"] for e in log_entries(root) if e["heading"] not in before]))
    log(f"{root.name}: tidy exit {r['exit']}, closed {', '.join(r.get('closed') or []) or 'nothing'}"
        + (f", changed {len(r.get('changed') or [])}" if r.get("changed") else "")
        + (f", ${r['cost_usd']}" if "cost_usd" in r else "") + f" — {clip(r.get('notes', ''), 200)}")
    s = collect_status(root)
    auto = next((t for t in s["next"]["tickets"] + s["next"]["rest"]
                 if AUTONOMOUS_RE.search(src.ticket_text(t["id"]))), None)
    if auto and not busy(root, s):
        log(f"{root.name}: {auto['id']} [autonomous] — {auto['title']}")
        r = run_worker(root, cfg, f"auto-{auto['id']}", autonomous_prompt(auto, isinstance(src, StoreTasks)),
                       float(cfg.get("autonomous_timeout_min", 120)), verbose=verbose)
        log(f"{root.name}: {auto['id']} exit {r['exit']}" + (f", ${r['cost_usd']}" if "cost_usd" in r else "")
            + f" — {clip(r.get('notes', ''), 200)}")


def tidy_messages(root: Path, cfg: dict, report: list[dict]) -> list[dict]:
    """The tidy pass's report as the owner wants it: one short message of what was done, then each
    reading of their words that could be wrong as its own message, so one reply corrects it."""
    ru, label = tasks_of(root, cfg).russian(), project_label(root, cfg)
    T = lambda k, **kw: TIDY_MSG[k][ru].format(**kw)
    done = [e for e in report if not e.get("check")]
    checks = [e for e in report if e.get("check")]
    parts = [f"<b>{tg_html(T('kind', p=label))}</b>"]
    if done:
        parts.append("\n".join(f"• {tg_html(clip(e['text'], 300))}" for e in done))
    if checks:
        parts.append(f"<i>{tg_html(T('checks', n=len(checks)))}</i>")
    base = {"root": str(root), "project": label, "doc": "QUESTIONS.md", "kind": "brief", "key": "",
            "code": "", "title": T("kind", p=label), "ru": ru}
    msgs = [{"kind": "tidy", "text": "\n\n".join(parts), "ref": base}]
    for k, e in enumerate(checks, 1):
        tid = ticket_id(e["ticket"]) if e.get("ticket") else ""
        ref = ({**base, "doc": "TODO.md", "kind": "ticket", "key": tid, "title": clip(e["text"], 80)}
               if re.fullmatch(r"B\d+", tid) else base)
        pos = f", {k}/{len(checks)}" if len(checks) > 1 else ""
        msgs.append({"kind": "tidy_check", "ref": ref, "text": "\n\n".join([
            f"<b>{tg_html(T('kind_check', p=label))}{pos}</b>",
            tg_html(clip(e["text"], 900)), f"<i>{tg_html(T('check_hint'))}</i>"])})
    return msgs


def add_seen(root: Path, headings: list[str]) -> None:
    """LOG entries the owner already got another way (the tidy report), so the brief doesn't repeat them."""
    if not headings:
        return
    state = seen_state()
    cur = state.get(str(root))
    if not cur:   # never looked: the brief shows the latest day, so everything before it counts as seen
        entries = log_entries(root)
        day = re.match(r"\S+", entries[0]["heading"]).group(0) if entries else ""
        cur = state[str(root)] = {"at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                                  "headings": [e["heading"] for e in entries if not e["heading"].startswith(day)]}
    cur["headings"] = (headings + cur.get("headings", []))[:300]
    STATE.mkdir(parents=True, exist_ok=True)
    SEEN.write_text(json.dumps(state, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")


def dispatch_brief(root: Path, cfg: dict, env: dict, dst: dict, cap: int, log, first: list | None = None) -> None:
    s = collect_status(root)
    left = cap - dst["sent"]
    with tg_lock():
        st = tg_state()
        msgs = (first or []) + plan_brief(root, s, st, cfg)
        if not msgs:
            log(f"{root.name}: nothing new for the owner")
            return
        if left < 1:
            log(f"{root.name}: {len(msgs)} message(s) held back, today's {cap} are used")
            return
        msgs = msgs[:left]
        deliver(msgs, st, env, cfg)
    mark_seen(root)
    dst["sent"] += len(msgs)
    log(f"{root.name}: brief, {len(msgs)} message(s)")


def cmd_dispatch(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop dispatch",
                                description="The morning run: in each project nobody is working in, a headless "
                                            "tidy pass acts on the owner's answers and closes what is done, one "
                                            "[autonomous] ticket goes through `accept`, then the brief goes out.")
    p.add_argument("--dry-run", action="store_true", help="Say what would run, run nothing, send nothing")
    p.add_argument("--now", action="store_true", help="Run even in quiet hours (23:00–09:00)")
    p.add_argument("--no-work", action="store_true", help="Only the briefs, no worker sessions")
    p.add_argument("--project", action="append", help="Only this project (repeatable)")
    p.add_argument("-v", "--verbose", action="store_true", help="Print every step of the sessions, not only a status line")
    p.add_argument("--service", choices=("on", "off", "status"), help=f"macOS: run it every day at "
                   f"{DISPATCH_TIME[0]:02d}:{DISPATCH_TIME[1]:02d}")
    a = p.parse_args(argv)
    if a.service:
        return launchd(DISPATCH_SERVICE, ["dispatch"], a.service, DISPATCH_LOG,
                       {"StartCalendarInterval": {"Hour": DISPATCH_TIME[0], "Minute": DISPATCH_TIME[1]}},
                       "dispatcher")
    cfg, env = load_config(), tg_env()
    hour = dt.datetime.now().hour
    if not (a.now or a.dry_run) and (hour >= QUIET_HOURS[0] or hour < QUIET_HOURS[1]):
        print("· quiet hours, nothing done (--now to run anyway)")
        return 0
    roots = [find_root(Path(os.path.expanduser(x))) for x in a.project] if a.project else dispatch_projects(cfg)
    if not roots:
        print(f"agentdrop dispatch: no projects. Put `projects = ~/path/a, ~/path/b` in {CONFIG}", file=sys.stderr)
        return 2

    def log(msg: str) -> None:
        line = f"{dt.datetime.now():%d.%m %H:%M} {msg}"
        print(line, flush=True)
        if not a.dry_run:
            STATE.mkdir(parents=True, exist_ok=True)
            with DISPATCH_LOG.open("a", encoding="utf-8") as fh:
                fh.write(line + "\n")

    if env and not a.dry_run:
        for note in sync_replies(wait=True):   # the owner's answers into the docs before anyone reads them
            log(note)
    dst = dispatch_state()
    for root in roots:
        pending: list = []
        if not a.no_work:
            try:
                dispatch_one(root, cfg, a.dry_run, log, pending, a.verbose)
            except (OSError, subprocess.SubprocessError) as e:
                log(f"! {root.name}: {e}")
        if a.dry_run or not (env or cfg.get("notify")):
            continue
        first = []
        for _, report, headings in pending:
            first += tidy_messages(root, cfg, report)
            add_seen(root, headings)
        try:
            dispatch_brief(root, cfg, env, dst, int(cfg.get("day_cap", DAY_CAP)), log, first)
        except TgError as e:
            log(f"! {root.name}: brief not sent: {e}")
        dst["runs"][str(root)] = dt.datetime.now().astimezone().isoformat(timespec="seconds")
        DISPATCH_STATE.write_text(json.dumps(dst, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    return 0


# ---------------------------------------------------------------------------
# `agentdrop pack`: a dense autonomous run the owner asked for. The frontier (open, unclaimed, waiting
# for nobody and for no open ticket, not marked [with owner]) in priority order, as one headless session
# that outlives the terminal and the chat that started it. Python picks the tickets; the model does them.

PACK_WORKER = "claude -p --permission-mode bypassPermissions"
PACK_EFFORT = "medium"               # low effort came back rejected by the judge; medium is the chosen balance
PACK_DIR = RUNS / "pack"             # <stamp>.prompt.md, .jsonl (the session), .err, .pid


def pack_tickets(s: dict, n: int) -> list[dict]:
    return [t for t in s["next"]["tickets"] + s["next"]["rest"] if t.get("mode") != "human"][:n]


def pack_prompt(s: dict, tickets: list[dict], budget: float, name: str,
                lane: tuple[int, int] = (1, 1), others: list[dict] | None = None, store: bool = False,
                history: list[str] | None = None) -> str:
    k, n = lane
    ask = (f"goes under its task: {ASK_HOW}, or `agentdrop task state B<n> waiting_others \"<whom>: …\"`" if store else
           f"goes to docs/QUESTIONS.md as its own item: {ASK_HOW}")
    lines = [f"Autonomous run in the project in this directory ({s['project']}), started by `agentdrop pack` "
             f"at {name}'s request. Nobody is watching: you can't ask {name} anything. Anything that needs their "
             f"decision or other people {ask}; then carry on with a reversible default.", "",
             ("First read AGENTS.md, docs/STATE.md and docs/PITFALLS.md, and run `agentdrop status`. " + STORE_RULE + " "
              if store else "First read AGENTS.md, docs/STATE.md, docs/TODO.md and docs/PITFALLS.md, and run "
              "`agentdrop status`. ") + "Skip a ticket another session has claimed.", ""]
    if n > 1:
        lines += [f"You are one of {n} sessions of this run working in this folder at the same time (lane {k}). "
                  "The others do: " + "; ".join(f"{t['title']} ({t['id']})" for t in others or []) + ". Don't touch "
                  f"their tickets or files. The docs ({'LOG.md, STATE.md' if store else 'TODO.md, LOG.md, STATE.md, QUESTIONS.md'}) are shared: edit only "
                  "your own items, never revert another session's edits; committing a shared doc that also holds "
                  "their uncommitted lines is fine. If `agentdrop accept` or git trips over files another session "
                  "changed and hasn't committed yet, don't commit or undo them: wait a few minutes and run it "
                  "again.", ""]
    lines += ["The tickets, in this order; each is its own pass by the charter (" + (
        "`agentdrop task take B<n>` → work → commit → `agentdrop task handin B<n>` → `agentdrop accept B<n>` → LOG):"
        if store else "claim → work → commit → `agentdrop accept` → LOG, TODO, release):")]
    for i, t in enumerate(tickets, 1):
        lines.append(f"{i}. {t['title']} ({t['id']}, {t['priority']})" + (f". Why: {t['why']}" if t["why"] else ""))
    if history:
        lines += ["", "This continues earlier runs; they are below, newest last. Before working, read what they did "
                  "(the task's thread and history, `git log`, the end of a log if you need more) and go on from where "
                  "they stopped: don't redo committed work, and don't repeat what a stopped run was stopped in the "
                  "middle of without checking why.", *history, ""]
    lines += [("When a ticket runs into missing data or access, say what is missing with `agentdrop task comment` and "
               "go on. If time and budget remain, `agentdrop task take` with no number gives the next one (refused "
               "means another session has it)." if store else
               "When a ticket runs into missing data or access, write what is missing under it and go on. If time "
               "and budget remain, take the next tickets from «Next up» in `agentdrop status` the same way (claim "
               "first; refused means another session has it), skipping those marked [with owner] / [с человеком]."), "",
              "`agentdrop accept` takes up to half an hour: run it in the background and go on to the next ticket, "
              "but wait for every accept before the final brief: this session ends when you stop answering, and the "
              "background jobs die with it, so before the brief block on them in the foreground (a loop that sleeps "
              "until the accept log shows its exit code) rather than saying you will wait. Exit 1: fix what it "
              "printed and run it again. "
              f"Exit 3: leave the ticket to {name} and go on.", "",
              f"Budget: ${budget:g} for this session. Do bulk work (labelling, crawls, checking many items) with "
              "scripts, local models or cheaper subagents; spend the strongest model only on spot checks of "
              "disputed cases. Tell every subagent not to start subagents of its own: nested agents burn the "
              "budget unseen.", "",
              "Never deploy, never send anything to anyone (mail, chats, Telegram), never push, never publish "
              "anything outside. Commit only your own files, no AI attribution. The project's rules in AGENTS.md "
              "hold throughout.", "",
              f"The last message is one brief for {name}'s phone, in the language of the docs: per ticket its "
              "meaning and the key number in a line or two (the code in parentheses), what waits for "
              f"{name} (with your pick), what is left undone, what was spent."]
    return "\n".join(lines)


def pack_lane(f: Path) -> dict:
    """One session of a run: `<stamp>.jsonl`, or `<stamp>-<lane>.jsonl` when the run went in parallel."""
    pid = f.with_suffix(".pid")
    text = f.read_text(encoding="utf-8", errors="replace")
    res = claude_result(text)
    res = res if isinstance(res, dict) and res.get("type") == "result" else None
    stopped = f.with_suffix(".stopped")
    out = {"stamp": f.stem, "log": str(f),
           "running": not res and not stopped.exists() and pid.exists() and pid_alive(pid.read_text())}
    if stopped.exists():
        try:
            out["stopped"] = json.loads(stopped.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            out["stopped"] = {}
    if res:
        out.update(result=res.get("result", ""), cost_usd=res.get("total_cost_usd"),
                   minutes=round(res.get("duration_ms", 0) / 60000))
    else:   # still going (or died): the last thing it said
        texts = []
        for line in text.splitlines():
            try:
                e = json.loads(line)
            except ValueError:   # the line being written
                continue
            if isinstance(e, dict) and e.get("type") == "assistant":
                texts += [c.get("text", "") for c in e.get("message", {}).get("content", []) if c.get("type") == "text"]
        out["last"] = clip(texts[-1], 400) if texts else ""
    return out


def last_pack(root: Path) -> list[dict]:
    """Every session of the latest run in this project (one, or one per lane)."""
    runs = sorted((root / PACK_DIR).glob("*.jsonl"))
    if not runs:
        return []
    stamp = runs[-1].stem[:13]   # 20260927-1307
    return [pack_lane(f) for f in runs if f.stem[:13] == stamp]


def pack_tickets_of(f: Path) -> list[str]:
    """The tickets a run was given: the numbered lines of its prompt."""
    pf = f.with_suffix(".prompt.md")
    text = pf.read_text(encoding="utf-8") if pf.exists() else ""
    return re.findall(r"^\d+\. .*\((B\d+), (?:P\d)?\)", text, re.M)


def pack_session(f: Path) -> str:
    """The agent's session id, from the first lines of a run's log."""
    try:
        with f.open(encoding="utf-8", errors="replace") as fh:
            for _, line in zip(range(30), fh):
                m = re.search(r'"session_id":\s*"([0-9a-f-]{36})"', line)
                if m:
                    return m.group(1)
    except OSError:
        pass
    return ""


def live_packs(root: Path) -> list[Path]:
    """Every run in this project still going, of any start time."""
    return [f for f in sorted((root / PACK_DIR).glob("*.jsonl"))
            if f.with_suffix(".pid").exists() and pid_alive(f.with_suffix(".pid").read_text()) and pack_lane(f)["running"]]


def pack_history(root: Path, tid: str) -> list[str]:
    """One line per earlier run of this ticket, for the prompt of the next one: when, how it ended, its last words."""
    out = []
    for f in sorted((root / PACK_DIR).glob("*.jsonl")):
        if tid not in pack_tickets_of(f):
            continue
        lane = pack_lane(f)
        start = dt.datetime.strptime(f.stem[:13], "%Y%m%d-%H%M")
        mins = lane.get("minutes") or max(1, round((f.stat().st_mtime - start.timestamp()) / 60))
        if lane["running"]:
            how = "still going"
        elif "stopped" in lane:
            how = f"stopped by {lane['stopped'].get('by') or 'hand'}"
        elif "result" in lane:
            how = "finished" + (f", ${lane['cost_usd']:.2f}" if lane.get("cost_usd") is not None else "")
        else:
            how = "broke off without a result"
        words = lane.get("result") or lane.get("last") or ""
        out.append(f"- {tid}, {start:%d.%m %H:%M}, {mins} min, {how}"
                   + (f". Its last words: {clip(' '.join(words.split()), 700)}" if words else "")
                   + f" (log: {(PACK_DIR / f.name).as_posix()})")
    return out


def unread_words(src: "StoreTasks", tid: str, cfg: dict) -> list[dict]:
    """The owner's comments in a task's thread since its last run started: no agent has read them yet."""
    out, words = [], owner_words(cfg)
    for e in src.show(src.record(tid))["events"]:
        if e["what"] == "run started":
            out = []
        elif e["what"] == "comment" and by_owner(e["author"], words):
            out.append(json.loads(e["detail"]))
    return out


def reply_lines(tid: str, name: str, words: list[dict]) -> list[str]:
    return [f"{name} wrote in the thread of {tid} (the task's thread in the store), newest last:", "",
            *(f"> [{c['at']}] " + c["text"].replace("\n", "\n> ") for c in words), "",
            f"Answer {name} in the thread first, before any other work: `agentdrop task comment {tid} \"…\"`, what you "
            "understood and what you will do; then go on with the task with their words in mind, and answer again "
            f"in the thread with the result (or `agentdrop task ask {tid} \"<question>\" --option … --pick …` if you "
            "need their decision). The thread is "
            f"where {name} reads you; the final brief is still the last message."]


def pack_stop(root: Path, cfg: dict, run: str, by: str) -> int:
    """Stop one run: its own process group only; the tasks it holds go back to the queue, noted in their history."""
    import signal
    import time
    f = root / PACK_DIR / f"{run}.jsonl"
    if not f.exists():
        print(f"agentdrop pack --stop: no run {run} in {root.name}", file=sys.stderr)
        return 2
    if not pack_lane(f)["running"]:
        print(f"agentdrop pack --stop: {run} is not running", file=sys.stderr)
        return 1
    pid = int(f.with_suffix(".pid").read_text().strip())
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(pid, sig)   # the run was started in its own session: the group is the agent and its tools
        except ProcessLookupError:
            break
        except (OSError, AttributeError):
            os.kill(pid, sig)
        for _ in range(50):
            if not pid_alive(str(pid)):
                break
            time.sleep(0.1)
        else:
            continue
        break
    at = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    f.with_suffix(".stopped").write_text(json.dumps({"by": by, "at": at}, ensure_ascii=False), encoding="utf-8")
    sid, src = pack_session(f), tasks_of(root, cfg)
    store = isinstance(src, StoreTasks)
    held = [c.get("ticket", "") for c in read_claims(root) if sid and c.get("session") == sid]
    for tid in dict.fromkeys(pack_tickets_of(f) + held):
        if tid in held:
            (root / CLAIMS / f"{tid}.json").unlink(missing_ok=True)
            if store:
                src.released(tid, by)
        if store and src.record(tid):
            src.journal(tid, by, "run stopped", {"run": run, "held": tid in held})
    print(f"✓ stopped {run}" + (f"; back in the queue: {', '.join(held)}" if held else ""))
    return 0


def cmd_pack(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop pack",
                                description="A dense autonomous run: the frontier tickets (not waiting for anyone "
                                            "or for another open ticket, not marked [with owner]) in priority order "
                                            "as one prompt; --run starts it as headless sessions in the background.")
    p.add_argument("path", nargs="?", default=".", help="Project directory (default: here)")
    p.add_argument("-n", type=int, default=5, help="How many tickets (default 5)")
    p.add_argument("-j", type=int, default=1, help="Sessions working at once, the tickets dealt between them "
                                                    "(default 1); the budget is split evenly")
    p.add_argument("--only", help="These tickets instead of the frontier, in this order: B6,B108")
    p.add_argument("--budget", type=float, default=30, help="Dollar cap for the whole run (default 30)")
    p.add_argument("--effort", help=f"Effort of the sessions (low … max; default `pack_effort` in the config, "
                                     f"else {PACK_EFFORT}); subagents keep their own model settings")
    p.add_argument("--run", action="store_true", help="Start it now, detached; prints where it writes")
    p.add_argument("--last", action="store_true", help="How the latest run in this project is doing, or its brief")
    p.add_argument("--stop", metavar="RUN", help="Stop this run (its log's name, 20260927-1307): only its own "
                                                 "processes; the tasks it holds go back to the queue")
    p.add_argument("--by", help="Who stops it, for the tasks' history (default: the owner's name)")
    p.add_argument("--reply", metavar="TASK", help="Deliver the owner's new words in this task's thread: continue the "
                                                    "session of its latest run with them (or a fresh run if it had "
                                                    "none); exit 1 when there is nothing unread, 2 while a run holds it")
    a = p.parse_args(argv)
    root, cfg = find_root(Path(os.path.expanduser(a.path))), load_config()
    if a.stop:
        return pack_stop(root, cfg, a.stop, a.by or owner_name(cfg, owner_ru(cfg)))
    effort = a.effort or cfg.get("pack_effort", PACK_EFFORT)
    prev = last_pack(root)
    if a.last:
        if not prev:
            print("· no pack runs here yet")
            return 1
        for i, lane in enumerate(prev):
            state = "running" if lane["running"] else "finished" if "result" in lane else "stopped without a result"
            print(("\n" if i else "") + f"{lane['stamp']}: {state}"
                  + (f", ${lane['cost_usd']:.2f}, {lane['minutes']} min" if lane.get("cost_usd") is not None else "")
                  + f" — {lane['log']}")
            print(lane.get("result") or lane.get("last", ""))
        return 0
    s = collect_status(root)
    src = tasks_of(root, cfg)
    store = isinstance(src, StoreTasks)
    resume = ""
    if a.reply:
        r = src.record(a.reply) if store else None
        if r is None:
            print(f"agentdrop pack --reply: no task {a.reply} in {root.name}'s store", file=sys.stderr)
            return 2
        words = unread_words(src, r["id"], cfg)
        if not words:
            print(f"· nothing new from {owner_name(cfg, s['ru'])} in {r['id']}'s thread")
            return 1
        mine = [f for f in sorted((root / PACK_DIR).glob("*.jsonl"), key=lambda f: f.stat().st_mtime)
                if r["id"] in pack_tickets_of(f)]
        resume = pack_session(mine[-1]) if mine else ""
        a.only, a.j = r["id"], 1
    if a.only:
        by_id = {t["id"]: t for t in src.tickets()}
        if a.reply and r["id"] not in by_id:   # a finished task they wrote about goes back to work
            by_id[r["id"]] = {"id": r["id"], "title": r["title"], "priority": r["priority"], "why": "", "mode": r["mode"]}
        want = [ticket_id(x) for x in a.only.split(",") if x.strip()]
        missing = [x for x in want if x not in by_id]
        if missing:
            print(f"agentdrop pack: not in TODO: {', '.join(missing)}", file=sys.stderr)
            return 2
        tickets = [by_id[x] for x in want]
    else:
        tickets = pack_tickets(s, a.n)
    if not tickets:
        print("· nothing on the frontier: every open ticket waits for someone or for another ticket")
        return 1
    j = max(1, min(a.j, len(tickets)))
    lanes = [tickets[k::j] for k in range(j)]   # dealt in priority order: lane 1 gets the 1st, (j+1)th, …
    budget = a.budget / j
    name = owner_name(cfg, s["ru"])
    if resume:   # the same session goes on: it already has the charter and what it did, it only needs their words
        t = tickets[0]
        prompts = ["\n".join([f"This continues your run on the task below, in the same project ({s['project']}).",
                               f"1. {t['title']} ({t['id']}, {t['priority']})", "",
                               *reply_lines(t["id"], name, words), "",
                               f"First `agentdrop task take {t['id']}` again: the run you were in has let go of it. "
                               "Everything the first prompt said still holds: nobody is watching live, the budget "
                               f"(${budget:g} now), never deploy or send anything, commit only your own files."])]
    else:
        past = {t["id"]: pack_history(root, t["id"]) for t in tickets} if a.only else {}
        prompts = [pack_prompt(s, lane, budget, name, (k + 1, j), [t for t in tickets if t not in lane], store,
                               [x for t in lane for x in past.get(t["id"], [])])
                   + ("\n\n" + "\n".join(reply_lines(lane[0]["id"], name, words)) if a.reply else "")
                   for k, lane in enumerate(lanes)]
    if not a.run:
        print("\n\n---\n\n".join(prompts))
        return 0
    # a run of named tickets may go beside other runs, as long as none of them has these tickets
    mine = {t["id"] for t in tickets}
    live = [f.stem for f in live_packs(root) if not a.only or mine & set(pack_tickets_of(f))]
    if live:
        print(f"agentdrop pack: a run is still going ({', '.join(live)}); `agentdrop pack --last`", file=sys.stderr)
        return 2
    if a.only:   # a claim left by an earlier run of these tickets that died is no one's any more
        dead = {pack_session(f) for f in (root / PACK_DIR).glob("*.jsonl")
                if mine & set(pack_tickets_of(f)) and not pack_lane(f)["running"]} - {""}
        for c in read_claims(root):
            if c.get("ticket") in mine and c.get("session") in dead:
                (root / CLAIMS / f"{c['ticket']}.json").unlink(missing_ok=True)
    import shlex
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M")
    d = root / PACK_DIR
    if any(d.glob(f"{stamp}*")):   # another run started this minute: seconds keep the names apart
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    d.mkdir(parents=True, exist_ok=True)
    # its own session/process group: closing the chat or the terminal that started it doesn't stop it
    detach = ({"creationflags": 0x00000008 | 0x00000200} if platform.system() == "Windows"
              else {"start_new_session": True})
    for k, (lane, prompt) in enumerate(zip(lanes, prompts), 1):
        name_k = stamp if j == 1 else f"{stamp}-{k}"
        pf = d / f"{name_k}.prompt.md"
        pf.write_text(prompt, encoding="utf-8")
        cmd = shlex.split(os.path.expanduser(cfg.get("pack_worker", PACK_WORKER)))
        if resume:
            cmd += ["--resume", resume]
        if Path(cmd[0]).name == "claude":
            cmd += ["--output-format", "stream-json", "--verbose", "--max-budget-usd", f"{budget:g}",
                    "--effort", effort] + ([] if resume else ["-n", f"pack-{root.name}-{name_k}"])
        with pf.open(encoding="utf-8") as inp, (d / f"{name_k}.jsonl").open("w") as out, \
                (d / f"{name_k}.err").open("w") as err:
            proc = subprocess.Popen(cmd, cwd=root, stdin=inp, stdout=out, stderr=err, **detach)
        (d / f"{name_k}.pid").write_text(str(proc.pid))
        if store:
            for t in lane:
                src.journal(t["id"], "agentdrop pack", "run started", {"run": name_k, "pid": proc.pid}
                            | ({"reply": len(words), "resumed": resume} if a.reply else {}))
        print(f"· started{f' lane {k}' if j > 1 else ''}: {', '.join(t['id'] for t in lane)}, cap ${budget:g}, "
              f"effort {effort}, pid {proc.pid}")
    print(f"· sessions in {d}; progress and the briefs: `agentdrop pack --last`")
    return 0


