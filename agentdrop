        print("Edit that one file, then run:  agentdrop sync")


def project_template_with_meta(name: str, body: str, root: Path) -> str:
    if name != "HANDOFF.md":
        return body
    stack = detect_stack(root)
    is_git, branch = git_info(root)
    meta = (
        f"# HANDOFF\n\n"
        f"> Cold-agent handoff. Keep concise and current.\n\n"
        f"## Project\n"
        f"- Name: `{root.name}`\n"
        f"- Stack: {stack}\n"
    )
    if is_git:
        meta += f"- Git branch at bootstrap: `{branch}`\n"
    meta += "\n"
    return meta + body.split("\n", 3)[-1] if body.startswith("# HANDOFF") else body


def uses_kit(root: Path) -> bool:
    """Kit layout unless the project already runs on the old root-level memory files."""
    if not CHARTER.exists():
        return False
    if (root / "docs" / "STATE.md").exists():
        return True
    return not any((root / f).exists() for f in LEGACY_FILES)


def copy_kit(root: Path, dry: bool = False) -> None:
    for src in sorted(KIT.rglob("*")):
        rel = src.relative_to(KIT).as_posix()
        if src.is_dir() or rel in KIT_SKIP or src.name == ".DS_Store":
            continue
        dest = root / rel
        if dest.exists():
            continue
        if not dry:
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest)
        print(f"✓ {rel:<40} — {'would create' if dry else 'created'}")


def ensure_stop_hook(root: Path, dry: bool = False) -> None:
    path = root / ".claude" / "settings.json"
    try:
        data = json.loads(read(path)) if path.exists() else {}
    except json.JSONDecodeError:
        print(f"! {path.relative_to(root)} — not valid JSON, Stop hook not added")
        return
    stops = data.setdefault("hooks", {}).setdefault("Stop", [])
    if any("check_docs.sh" in h.get("command", "") for g in stops for h in g.get("hooks", [])):
        print("· .claude/settings.json                   — Stop hook present")
        return
    stops.append({"hooks": [{"type": "command", "command": STOP_HOOK_CMD}]})
    write(path, json.dumps(data, ensure_ascii=False, indent=2) + "\n", dry)
    print(f"✓ .claude/settings.json                   — {'would add' if dry else 'added'} Stop hook")


def ensure_hooks_path(root: Path, dry: bool = False) -> None:
    r = subprocess.run(["git", "-C", str(root), "config", "core.hooksPath"],
                       text=True, capture_output=True)
    current = r.stdout.strip()
    if current == ".githooks":
        print("· git core.hooksPath                      — already .githooks")
    elif current:
        print(f"! git core.hooksPath is '{current}' — left as is; .githooks/pre-commit not active")
    else:
        if not dry:
            subprocess.run(["git", "-C", str(root), "config", "core.hooksPath", ".githooks"], check=True)
        print(f"✓ git core.hooksPath = .githooks          — {'would set' if dry else 'set'}")


def bootstrap_project(root: Path, dry: bool = False) -> None:
    ensure_state()
    root = root.expanduser().resolve()
    if not root.exists():
        if dry:
            print(f"Would create directory: {root}")
        else:
            root.mkdir(parents=True)
    if not root.is_dir():
        raise SystemExit(f"Not a directory: {root}")

    print(f"\nProject: {root}")
    print("-" * min(80, len(str(root)) + 9))

    # Make the project's AGENTS.md self-contained: full common rules + project workflow.
    # Existing project-specific content outside our managed block is preserved.
    agents = root / "AGENTS.md"
    common = read(COMMON).rstrip()
    kit = uses_kit(root)
    workflow = read(CHARTER) if kit else PROJECT_BLOCK
    project_payload = common + "\n\n" + workflow.rstrip()
    if kit and not agents.exists() and not dry:
        agents.write_text(
            f"# {root.name} — устав для агента\n\n"
            "_Что это за проект — одна-две фразы. Правила, которые в этом проекте ломают доверие,\n"
            "и всё своё — здесь, над управляемым блоком. Блок ниже обновляет `agentdrop`._\n",
            encoding="utf-8",
        )
    changed, action = managed_merge(
        agents, project_payload, PROJECT_START, PROJECT_END, dry=dry
    )
    print(f"{'✓' if changed else '·'} AGENTS.md      — {action}")

    # Claude heuristic:
    # - If the repo already has CLAUDE.md, preserve it and import AGENTS.md.
    # - Otherwise create a tiny hidden shim so older Claude Code / disabled AGENTS support
    #   still sees AGENTS.md, without polluting the root with another full instruction file.
    root_claude = root / "CLAUDE.md"
    hidden_claude = root / ".claude" / "CLAUDE.md"
    if root_claude.exists():
        cpath, import_line = root_claude, "@AGENTS.md"
    elif hidden_claude.exists():
        cpath, import_line = hidden_claude, "@../AGENTS.md"
    else:
        cpath, import_line = hidden_claude, "@../AGENTS.md"
    changed, action = ensure_import(cpath, import_line, dry=dry)
    print(f"{'✓' if changed else '·'} Claude bridge  {cpath.relative_to(root)} — {action}")

    # Gemini does not use AGENTS.md by default; import it into its project context.
    gemini = root / "GEMINI.md"
    changed, action = ensure_import(gemini, "@AGENTS.md", dry=dry)
    print(f"{'✓' if changed else '·'} Gemini bridge  GEMINI.md — {action}")

    is_git_repo, _ = git_info(root)
    if kit:
        copy_kit(root, dry=dry)
        ensure_stop_hook(root, dry=dry)
        if is_git_repo:
            ensure_hooks_path(root, dry=dry)
    elif CHARTER.exists():
        print("! Old layout (root HANDOFF/PROGRESS/...): docs/ kit not applied.")
        print("  To migrate, ask the agent: «переведи доки проекта на структуру docs/ из ~/.agentdrop/kit», then run agentdrop again.")

    # Old layout only: create root memory docs if missing. Never overwrite project state.
    for filename, body in ({} if kit else TEMPLATES).items():
        path = root / filename
        if path.exists():
            print(f"· {filename:<14} — preserved existing")
            continue
        content = project_template_with_meta(filename, body, root)
        if not dry:
            path.write_text(content.rstrip() + "\n", encoding="utf-8")
        print(f"✓ {filename:<14} — {'would create' if dry else 'created'}")

    # Report other instruction systems without trying to mash incompatible formats together.
    known = [
        root / ".github" / "copilot-instructions.md",
        root / ".cursorrules",
        root / ".windsurfrules",
        root / ".clinerules",
        root / ".cursor" / "rules",
        root / ".windsurf" / "rules",
    ]
    found = [p for p in known if p.exists()]
    if found:
        print("\nDetected extra harness-specific instructions; left untouched:")
        for p in found:
            print(f"  · {p.relative_to(root)}")

    is_git, branch = git_info(root)
    if is_git:
        print(f"\nGit repository detected (branch: {branch}).")
        print("Project memory files are intentionally left trackable; the agent can commit them with the next coherent iteration.")
    else:
        print("\nNo Git repository detected. AgentDrop does not initialize Git automatically.")

    if dry:
        print("\nDry run only — nothing was changed.")
    else:
        print("\nDone. Open this folder in any harness; its own existing instructions were preserved.")


def install_self(dry: bool = False) -> None:
    ensure_state()
    src = Path(__file__).resolve()
    bindir = HOME / ".local" / "bin"
    dest = bindir / "agentdrop"

    if dry:
        print(f"Would install {src} -> {dest}")
        sync_globals(dry=True)
        return

    bindir.mkdir(parents=True, exist_ok=True)
    if dest.exists() and dest.resolve() != src:
        backup(dest)
    if dest.resolve() != src:
        shutil.copy2(src, dest)
    dest.chmod(dest.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

    # macOS default shell is zsh. Add ~/.local/bin to PATH only when needed.
    path_parts = os.environ.get("PATH", "").split(os.pathsep)
    if str(bindir) not in path_parts:
        zshrc = HOME / ".zshrc"
        start = "# >>> agentdrop PATH >>>"
        end = "# <<< agentdrop PATH <<<"
        payload = 'export PATH="$HOME/.local/bin:$PATH"'
        managed_merge(zshrc, payload, start, end, dry=False)

    print(f"Installed: {dest}")
    sync_globals(dry=False)
    print("\nOpen a new Terminal window, then use:")
    print("  cd ~/Projects/MyProject && agentdrop")
    print("or:")
    print("  agentdrop ~/Projects/MyProject")


def open_common() -> None:
    ensure_state()
    if platform.system() == "Darwin":
        subprocess.run(["open", "-e", str(COMMON)])
    elif platform.system() == "Windows":
        os.startfile(str(COMMON))  # type: ignore[attr-defined]
    else:
        editor = os.environ.get("EDITOR")
        if editor:
            subprocess.run([editor, str(COMMON)])
        else:
            print(COMMON)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Deploy shared AI-agent rules without overwriting harness-specific instructions."
    )
    parser.add_argument("target", nargs="?", help="Project directory, or one of: sync, edit")
    parser.add_argument("--install", action="store_true", help="Install agentdrop command and sync global rules")
    parser.add_argument("--dry-run", action="store_true", help="Show what would change")
    args = parser.parse_args()

    if args.install:
        install_self(dry=args.dry_run)
        return

    if args.target in ("sync", "global"):
        sync_globals(dry=args.dry_run)
        return

    if args.target in ("edit", "common"):
        open_common()
        return

    if not args.target:
        cwd = Path.cwd().resolve()

        # `agentdrop --dry-run` is deliberately non-interactive and previews CWD.
        if args.dry_run:
            bootstrap_project(cwd, dry=True)
            return

        print(f"\nAgentDrop will bootstrap/sync the current directory:\n  {cwd}\n")
        print("It will:")
        print("  - preserve existing harness/project instructions")
        print("  - put the full shared rules + project workflow into AGENTS.md")
        print("  - add/update harness bridges without overwriting their own instructions")
        print("  - create missing docs/ skeleton, review-intake skill and docs guard (~/.agentdrop/kit)")
        print("  - back up any existing file before AgentDrop changes it")
        print("\nIt will NOT initialize Git, commit automatically, or overwrite project memory.")

        try:
            answer = input("\nProceed? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nCancelled.")
            return

        if answer not in {"y", "yes"}:
            print("Cancelled.")
            return

        bootstrap_project(cwd, dry=False)
        return

    bootstrap_project(Path(args.target), dry=args.dry_run)


if __name__ == "__main__":
    main()
