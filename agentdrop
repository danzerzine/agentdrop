                     r"recommend|i suggest|my pick|proposal)[^.!?]*[.!?]?")
COMMENT_RE = re.compile(r"^\s*>\s*\*\*([^,*]+?)(?:,[^*]*)?:\*\*")
CLOSED_RE = re.compile(r"_(?:Thread closed|Ветка закрыта)\._")
REVERT_RE = re.compile(r"(?i)можно отменить|you can revert|may revert|revertible")
SECTION_ORDER = [(re.compile(r"(?i)сейчас|^now"), 0, "P1"), (re.compile(r"(?i)дальше|^next"), 1, "P2"),
                 (re.compile(r"(?i)потом|^later"), 2, "P3")]


def doc(root: Path, name: str) -> str:
    """A project doc under docs/, or "" when the project doesn't keep it."""
    path = root / "docs" / name
    return read(path) if path.is_file() else ""


def load_config() -> dict:
    cfg = {}
    try:
        for line in CONFIG.read_text(encoding="utf-8").splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip().strip("\"'")
    except OSError:
        pass
    return cfg


def owner_words(cfg: dict) -> list[str]:
    names = [n.strip().lower() for n in cfg.get("owner", "").split(",") if n.strip()]
    return names + ["владел", "owner"]


def by_owner(text: str, words: list[str]) -> bool:
    low = text.lower()
    return any(re.search(r"(?<!\w)" + re.escape(w), low) for w in words)


def find_root(start: Path) -> Path:
    p = start.resolve()
    for cand in (p, *p.parents):
        if tasks_of(cand).present():
            return cand
    return p


def clip(text: str, n: int = 220) -> str:
    text = re.sub(r"\s+", " ", text.replace("**", "")).strip()
    if len(text) <= n:
        return text
    cut = text[:n].rsplit(" ", 1)[0].rstrip(",;:—–- ")
    return cut + "…"


def md_spans(lines: list[str]) -> list[tuple[list[str], int, int]]:
    """Top-level `- ` list items as line ranges [start, end), trailing blank lines excluded,
    with the headings above each. An item runs on through blank and indented lines."""
    spans, heads, cur = [], {}, None
    for i, line in enumerate(lines):
        h = re.match(r"^(#{1,4})\s+(.*)", line)
        if h:
            cur = None
            level = len(h.group(1))
            heads = {k: v for k, v in heads.items() if k < level}
            heads[level] = h.group(2).strip()
            continue
        if line.startswith("- "):
            cur = [[heads[k] for k in sorted(heads)], i, i + 1]
            spans.append(cur)
        elif cur is not None and (not line.strip() or line[:1] in (" ", "\t")):
            if line.strip():
                cur[2] = i + 1
        else:
            cur = None
    return [(hs, a, b) for hs, a, b in spans]


def md_items(text: str) -> list[tuple[list[str], str]]:
    """Top-level `- ` list items with their indented continuation, and the headings above each."""
    lines = text.splitlines()
    return [(hs, "\n".join([lines[a][2:], *lines[a + 1:b]]).rstrip()) for hs, a, b in md_spans(lines)]


def bold_title(text: str) -> tuple[str, str]:
    m = re.match(r"\*\*(.+?)\*\*\s*(.*)", text, re.S)
    if m:
        return m.group(1).strip(), m.group(2)
    return "", text


IMAGE_RE = re.compile(r"[\w./-]+\.(?:png|jpe?g|webp|gif)\b", re.I)


def item_images(root: Path, text: str) -> list[str]:
    """Pictures an item names (before/after screenshots, mockups) that exist in the project, at most 10."""
    out = []
    for name in IMAGE_RE.findall(text):
        for base in (root, root / "docs"):
            f = (base / name).resolve()
            if f.is_file() and root.resolve() in f.parents and str(f) not in out:
                out.append(str(f))
                break
    return out[:10]


# --- a question for the owner in parts (`agentdrop task ask`): read in five seconds, answered by one tap.
# The question is one line, the options short, the agent's pick named; file paths and task codes only in the
# details. A question about how something looks carries pictures: one per option, or a before/after pair.
ASK_Q_MAX, ASK_OPT_MAX, ASK_OPTS = 120, 60, (2, 4)
ASK_LETTERS = ("abcd", "абвг")   # [ru]
ASK_WORDS = {"pick": ("My pick", "Мой выбор"), "pics": ("Pictures", "Картинки"), "details": ("Details", "Подробнее"),
             "before": ("before", "было"), "after": ("after", "станет")}
ASK_CODE_RE = re.compile(r"(?<![\w-])(?:B\d+|q[0-9a-f]{6}(?:-\d+)?)(?![\w-])")
ASK_PATH_RE = re.compile(r"(?<![\w/])(?:~?\.{0,2}/[\w.-]+|[\w.-]+(?:/[\w.-]+){2,}|[\w.-]*/[\w.-]*\.[A-Za-z]\w{0,4}"
                         r"|[\w-]+\.(?:md|py|js|ts|css|html|json|jsonl|sh|png|jpe?g|webp|gif|txt|sqlite3|ya?ml|toml))\b", re.A)
# how the prompts teach it, in one line
ASK_HOW = ("`agentdrop task ask B<n> \"<the question, one line>\" --option \"…\" --option \"…\" --pick <n> "
           "[--details \"…\"]` (up to 120 characters for the question, 2–4 options of up to 60, your pick; context, "
           "file paths and task codes only in --details; a question about how something looks adds --design and a "
           "--pic per option or --before/--after)")
ASK_MARK_RE = re.compile(r"\n?[ \t]*<!--\s*ask:\s*(\{.*?\})\s*-->", re.S)


def ask_picture(root: Path, name: str) -> tuple[str, str]:
    """(path relative to the project, "") for a picture inside the project, else ("", what is wrong). The path is
    resolved first, so `..` and symlinks that lead out of the project are refused."""
    base = root.resolve()
    try:
        f = (base / os.path.expanduser(name)).resolve(strict=True)
    except (OSError, RuntimeError):
        return "", f"{name}: no such file in the project"
    if base not in f.parents:
        return "", f"{name}: outside the project; pictures must be files under {base}"
    if not f.is_file() or f.suffix.lower() not in IMG_EXT:
        return "", f"{name}: not a picture (png, jpg or webp)"
    return f.relative_to(base).as_posix(), ""


def ask_parts(root: Path, question: str, options: list[str], pick: str, details: str = "", pics: list[str] = (),
              before: str = "", after: str = "", design: bool = False, ru: bool = False) -> tuple[dict, list[str]]:
    """The question as the store keeps it, and what to fix when it breaks the form (empty when it is fine)."""
    q, opts, bad = " ".join(question.split()), [" ".join(o.split()) for o in options if o.strip()], []
    if not q:
        bad.append("the question is empty: one line, what exactly you ask")
    elif "\n" in question.strip():
        bad.append("the question has several lines: one line; the rest goes to --details")
    if len(q) > ASK_Q_MAX:
        bad.append(f"the question is {len(q)} characters; at most {ASK_Q_MAX}, one line (the rest goes to --details)")
    if not opts:
        bad.append(f"no options: give {ASK_OPTS[0]} to {ASK_OPTS[1]} with --option \"…\", each at most "
                   f"{ASK_OPT_MAX} characters; a yes/no question is two options too")
    elif not ASK_OPTS[0] <= len(opts) <= ASK_OPTS[1]:
        bad.append(f"{len(opts)} option{'s' * (len(opts) != 1)}; give {ASK_OPTS[0]} to {ASK_OPTS[1]}")
    for k, o in enumerate(opts, 1):
        if len(o) > ASK_OPT_MAX:
            bad.append(f"option {k} is {len(o)} characters; at most {ASK_OPT_MAX} (the rest goes to --details)")
    for what, text in [("the question", q)] + [(f"option {k}", o) for k, o in enumerate(opts, 1)]:
        found = ASK_CODE_RE.findall(text) + [m.group(0) for m in ASK_PATH_RE.finditer(text)]
        if found:
            bad.append(f"{what} names {', '.join(dict.fromkeys(found))}: file paths and task codes go only in "
                       f"--details; say it in words here")
    letters = ASK_LETTERS[ru]
    p = pick.strip().lower().strip("()")
    n = (int(p) - 1 if p.isdigit() else next((L.index(p) for L in ASK_LETTERS if p in L and len(p) == 1), -1)) if p else -1
    if not p:
        bad.append("no pick: say which option you would take, --pick 1.." + str(max(len(opts), 2)))
    elif not 0 <= n < len(opts):
        bad.append(f"--pick {pick}: no such option; 1..{len(opts)} or a letter {letters[:len(opts)]}")
    shots = []
    if pics and (before or after):
        bad.append("pictures either one per option (--pic) or a before/after pair (--before, --after), not both")
    elif pics:
        if len(pics) != len(opts):
            bad.append(f"--pic given {len(pics)} times for {len(opts)} options: one picture per option, in the "
                       f"options' order, or a pair with --before and --after")
        shots = [(x, letters[k] if k < len(letters) else "") for k, x in enumerate(pics)]
    elif before or after:
        if not (before and after):
            bad.append("a before/after pair needs both --before and --after")
        shots = [(x, ASK_WORDS[w][ru]) for x, w in ((before, "before"), (after, "after")) if x]
    elif design:
        bad.append(f"--design: a question about how something looks needs pictures: --pic per option "
                   f"({len(opts) or 'one each'}) or --before and --after, screenshots or mockups inside the project")
    out = []
    for name, label in shots:
        rel, why = ask_picture(root, name)
        if why:
            bad.append(why)
        else:
            out.append({"path": rel, "label": label})
    ask = {"q": q, "options": opts, "pick": n, "details": details.strip(), "pics": out, "design": bool(design)}
    return ask, bad


def ask_text(ask: dict, ru: bool) -> str:
    """The question as words, for the thread and QUESTIONS.md: every reader that doesn't know the parts still reads it."""
    letters = ASK_LETTERS[ru]
    lines = [ask["q"], *(f"({letters[k]}) {o}" for k, o in enumerate(ask["options"]))]
    lines.append(f"{ASK_WORDS['pick'][ru]} — ({letters[ask['pick']]}).")
    if ask.get("pics"):
        lines.append(f"{ASK_WORDS['pics'][ru]}: " + ", ".join(f"`{p['path']}` ({p['label']})" for p in ask["pics"]))
    if ask.get("details"):
        lines.append(f"{ASK_WORDS['details'][ru]}: {ask['details']}")
    return "\n".join(lines)


def ask_mark(ask: dict) -> str:
    """The parts as a hidden line under a QUESTIONS.md item, so the page reads them without guessing."""
    return "<!-- ask: " + json.dumps(ask, ensure_ascii=False).replace("-->", "--\\u003e") + " -->"


def ask_of(text: str) -> tuple[dict | None, str]:
    """(the parts, the text without their line) of a QUESTIONS.md item; (None, text) for an item in free words."""
    m = ASK_MARK_RE.search(text or "")
    if not m:
        return None, text
    try:
        ask = json.loads(m.group(1))
    except ValueError:
        return None, text
    return (ask if isinstance(ask, dict) and ask.get("q") and ask.get("options") else None), (text[:m.start()] + text[m.end():]).rstrip()


def split_thread(text: str) -> tuple[str, list[dict]]:
    """An item's text without its title line split into the body and the `> **Name, when:** …` thread."""
    body, thread = [], []
    for line in text.splitlines():
        st = line.strip()
        m = COMMENT_RE.match(line)
        if m:
            head = re.match(r"^\s*>\s*\*\*([^*]+?):\*\*\s*(.*)", line)
            who, _, when = (head.group(1) if head else m.group(1)).partition(",")
            thread.append({"author": who.strip(), "when": when.strip(), "text": head.group(2) if head else ""})
        elif st.startswith(">") and thread:
            thread[-1]["text"] += "\n" + st.lstrip("> ").rstrip()
        elif st in ("_Thread closed._", "_Ветка закрыта._"):
            thread.append({"author": "", "when": "", "text": st.strip("_")})
        else:
            body.append(line[2:] if line.startswith("  ") else line)
    return "\n".join(body).strip(), thread


class MarkdownTasks:
    """A project's tickets and the questions waiting for the owner, kept in docs/TODO.md and
    docs/QUESTIONS.md. Every command reads and writes them through this object (see `tasks_of`),
    so another store can take the place of markdown without touching the commands.

    Reads parse the files afresh on every call and return new records the caller may change.
    `full=True` adds each item's body and thread, for the tickets page; `question_items` gives
    every question with its group, `done` the tickets closed in docs/LOG.md. Writes go to the files
    at once: `comment` puts the owner's words under an item or as a new question and returns the
    placement, `take_back` removes a placement again if it is still there untouched."""

    def __init__(self, root: Path, cfg: dict | None = None):
        self.root, self._cfg = root, cfg

    @property
    def cfg(self) -> dict:   # read on first use: `find_root` asks every parent folder for `present()`
        if self._cfg is None:
            self._cfg = load_config()
        return self._cfg

    def present(self) -> bool:
        """The project keeps its tickets here."""
        return (self.root / "docs" / "TODO.md").is_file()

    def russian(self) -> bool:
        """The tickets are written in Russian (else the project's AGENTS.md is)."""
        sample = doc(self.root, "TODO.md")[:3000] or doc(self.root, "../AGENTS.md")[:3000]
        cyr = len(re.findall(r"[а-яё]", sample, re.I))
        lat = len(re.findall(r"[a-z]", sample, re.I))
        return cyr > lat

    def tickets(self, full: bool = False) -> list[dict]:
        """The open tickets in file order, with the board's fields; `full` adds "body" (without
        the title and the why) and "thread" (the comments under it)."""
        root, words, out, text_by_id = self.root, owner_words(self.cfg), [], {}
        for idx, (heads, text) in enumerate(md_items(doc(root, "TODO.md"))):
            section = next(((order, prio) for rx, order, prio in SECTION_ORDER
                            if any(rx.search(h) for h in heads[1:])), None)
            head = text.replace("**", "", 1) if text.startswith("**") else text
            m = ITEM_TICKET.match(head)
            if m:
                text_by_id.setdefault(m.group(2), text)   # the first one, as ticket_text() finds it
            if not m or section is None:
                continue
            first_para = text.split("\n\n", 1)[0]
            title, body = bold_title(first_para)
            if title:   # **B85 (P0). Title.** body
                title = ITEM_TICKET.sub("", title, count=1)
            else:       # B134 P1 — Title. Зачем: «…»
                rest = first_para[m.end():]
                cut = re.search(r"\s(?:Зачем|Why):", rest)
                title, body = (rest[:cut.start()], rest[cut.start():]) if cut else (rest, "")
                sent = re.match(r"(.{20,}?[.!?])\s", title, re.S)
                if sent:
                    title, body = sent.group(1), title[sent.end():] + body
            title = re.sub(r"(?i)\s*(?:После|After):\s*B\d+(?:\s*(?:,|и|and)\s*B\d+)*[^.]*\.?", "", title)   # a field, not the title
            why = WHY_RE.search(first_para)
            waits = WAITS_RE.search(text)
            after = [x for g in AFTER_RE.findall(first_para) for x in re.findall(r"B\d+", g) if x != m.group(2)]
            comments = [(c.group(1).strip(), line) for line in text.splitlines() if (c := COMMENT_RE.match(line))]
            t = {
                "id": m.group(2), "priority": m.group(1) or m.group(3) or section[1],
                "section": heads[-1] if heads else "", "order": (section[0], idx),
                "title": clip(title.rstrip(". "), 160),
                "why": clip(why.group(1), 200) if why else "",
                "context": "" if why else clip(body, 200),
                "waits": clip(waits.group(0), 110) if waits else "",
                "waits_owner": bool(waits and by_owner(waits.group(0), words)),
                "detail": clip(body.strip(), 700),
                "images": item_images(root, text), "ask": None,   # a question in parts lives in QUESTIONS.md
                # the owner wrote last under the ticket: the agent's move, whatever the ticket says it waits for
                "owner_last": bool(comments and by_owner(comments[-1][0], words)),
                "deferred": bool(DEFERRED_RE.search(text.split("\n\n", 1)[0])),
                "after": list(dict.fromkeys(after)),
                "mode": "auto" if AUTONOMOUS_RE.search(first_para) else "human" if HUMAN_RE.search(first_para) else "",
                "last": clip(re.sub(r"^\s*>\s*", "", comments[-1][1]), 400) if comments else "",
            }
            if full:
                t["body"], t["thread"] = self._ticket_page(text_by_id[t["id"]], t)
                t["doc"] = "TODO.md"
                tag = (m.group(4) or "").strip()   # **B94 (P0) [model].** the theme, unless it is a mark
                t["theme"] = "" if AUTONOMOUS_RE.search(f"[{tag}]") or HUMAN_RE.search(f"[{tag}]") else tag
            out.append(t)
        return out

    @staticmethod
    def _ticket_page(text: str, t: dict) -> tuple[str, list[dict]]:
        m = re.match(r"\*\*(.+?)\*\*\s*", text, re.S)   # **B85 (P0). Title.** body
        rest = text[m.end():] if m else ITEM_TICKET.sub("", text, count=1)
        title_plain = t["title"].replace("…", "")
        if not m and rest.startswith(title_plain):   # B134 P1 — Title. Зачем: «…» body
            rest = rest[len(title_plain):].lstrip(". ")
        why = WHY_RE.search(rest)
        if why and t["why"]:   # the why is shown on its own
            rest = (rest[:why.start()] + rest[why.end():]).lstrip(". ").replace("\n\n\n", "\n\n")
        return split_thread(rest)

    def ticket_text(self, tid: str) -> str:
        """A ticket in full as it stands, its thread included, in any section; "" when it's gone."""
        for _, text in md_items(doc(self.root, "TODO.md")):
            m = ITEM_TICKET.match(text.replace("**", "", 1) if text.startswith("**") else text)
            if m and m.group(2) == tid:
                return text
        return ""

    def question_items(self, text_all: str | None = None) -> list[dict]:
        """Every item of QUESTIONS.md in file order with its "group": "closed", "people" (for
        others), "revertible", "deferred", "turn" (the owner answered last) or "owner" (waits for
        the owner's answer); and its section "path", bold "key", "title", "body" (the text after
        the key) and "comments" (author, line) in order. Items above the first section are left out."""
        text_all = doc(self.root, "QUESTIONS.md") if text_all is None else text_all
        words, out = owner_words(self.cfg), []
        sections = [h for h in re.findall(r"(?m)^## (.+)$", text_all)
                    if not re.search(r"(?i)закрыт|closed|resolved", h)]
        # the owner's section: the one that names them, else the first one (the kit puts it first)
        owner_section = next((h for h in sections if by_owner(h, words)), sections[0] if sections else "")
        for heads, text in md_items(text_all):
            path = " / ".join(heads[1:])
            if not path:
                continue
            ask, text = ask_of(text)   # a question in parts carries them on a hidden line
            key, body = bold_title(text)
            title = key
            code = re.match(r"([A-ZА-ЯЁ]{1,3}-\d+)\.\s*", title)
            if code:
                title = f"{title[code.end():].rstrip('. ')} ({code.group(1)})"
            comments = [(m.group(1).strip(), line) for line in text.splitlines() if (m := COMMENT_RE.match(line))]
            if re.search(r"(?i)закрыт|closed|resolved", path) or CLOSED_RE.search(text):
                group = "closed"
            elif not (len(heads) > 1 and heads[1].strip() == owner_section.strip()):
                group = "people"
            elif REVERT_RE.search(path) or REVERT_RE.search(body[:300]):
                group = "revertible"
            elif DEFERRED_RE.search(re.split(r"\n\s*>", body, maxsplit=1)[0][:400]):
                group = "deferred"
            elif comments and by_owner(comments[-1][0], words):
                group = "turn"
            else:
                group = "owner"
            out.append({"group": group, "path": path, "key": key, "title": title, "text": text,
                        "body": body, "comments": comments, "ask": ask})
        return out

    def questions(self, full: bool = False) -> dict:
        """The owner's open questions: "waiting" for their answer, "your_turn" (titles the owner
        answered last), and counts of the "revertible", "people" (for others) and "deferred" ones.
        `full` adds "items": the waiting ones, then those the owner answered, each with its key,
        state ("owner" or "turn"), title, pick, images, body and thread."""
        root = self.root
        res = {"waiting": [], "your_turn": [], "revertible": 0, "people": 0, "deferred": 0}
        text_all = doc(root, "QUESTIONS.md")
        for q in self.question_items(text_all):
            group, key, body, title, comments = q["group"], q["key"], q["body"], q["title"], q["comments"]
            if group in ("people", "revertible", "deferred"):
                res[group] += 1
            elif group == "turn":
                res["your_turn"].append(clip(title.rstrip(". "), 90))
            elif group == "owner":
                para = re.split(r"\n\s*\n|\n\s*>", body, maxsplit=1)[0]
                reco = RECO_RE.search(body)
                res["waiting"].append({
                    "title": clip(title.rstrip(". "), 160),
                    "context": clip(para, 220),
                    "pick": clip(reco.group(0), 200) if reco else "",
                    "thread": len(comments),
                    "doc": "QUESTIONS.md", "key": f"**{key}**" if key else q["text"].split("\n", 1)[0][:80],
                    "detail": clip(re.split(r"\n\s*>", body, maxsplit=1)[0], 700),
                    "last": clip(re.sub(r"^\s*>\s*", "", comments[-1][1]), 400) if comments else "",
                    "images": item_images(root, q["text"]), "ask": q["ask"],
                })
        if full:
            res["items"] = self._question_pages(text_all, res)
        return res

    def _question_pages(self, text_all: str, res: dict) -> list[dict]:
        turn = set(res["your_turn"])
        all_q = {bold_title(text)[0]: text for _, text in md_items(text_all)}
        wanted = [(x["key"].strip("*"), "owner", x) for x in res["waiting"]]
        for key, text in all_q.items():
            code = re.match(r"([A-ZА-ЯЁ]{1,3}-\d+)\.\s*", key or "")
            title = f"{key[code.end():].rstrip('. ')} ({code.group(1)})" if code else (key or "").rstrip(". ")
            if clip(title, 90) in turn:
                wanted.append((key, "turn", {"title": title, "images": item_images(self.root, text)}))
        items = []
        for key, state, x in wanted:
            ask, text = ask_of(all_q.get(key, ""))
            body, thread = split_thread(bold_title(text)[1])
            items.append({"key": key, "state": state, "title": x["title"], "pick": x.get("pick", ""),
                          "images": x.get("images", []), "body": body, "thread": thread, "doc": "QUESTIONS.md",
                          "ask": ask})
        return items

    def comment(self, ref: dict, author: str, when: str, text: str) -> dict:
        """Write the owner's words under the item, or as a new item on top of the owner's open questions
        (ref kind "brief" or "project", or the item is gone). Returns the placement: how, the file, the
        exact lines added, and where the next answer in this thread goes."""
        root = self.root
        path = root / "docs" / ref["doc"]
        lines = read(path).split("\n") if path.is_file() else []
        span = item_span(lines, ref) if ref["kind"] not in ("brief", "project") else None
        if span:
            _, b = span
            new = quote_lines(author, when, text, "  ")
            added = insert_block(path, lines, b, new if lines[b - 1].lstrip().startswith(">") else ["", *new])
            return {"how": "saved", "path": str(path), "lines": added, "next": ref}
        qpath = root / "docs" / "QUESTIONS.md"
        qlines = read(qpath).split("\n") if qpath.is_file() else ["# QUESTIONS", ""]
        ru = bool(ref.get("ru"))
        end = open_slot(qlines, owner_words(self.cfg))
        if ref["kind"] in ("brief", "project"):
            title = (BRIEF["about_item"][ru].format(title=clip(ref["title"], 60), when=when)
                     if ref["kind"] == "project" and ref.get("item_title") else BRIEF["brief_item"][ru].format(when=when))
            how = "noted"
        else:
            title, how = BRIEF["new_item"][ru].format(title=ref["title"]) + f" ({ref['doc']})", "moved"
        item = [f"- **{title}**", "", *quote_lines(author, when, text, "  "), ""]
        if end > 0 and qlines[end - 1].strip():
            item.insert(0, "")
        added = insert_block(qpath, qlines, end, item)
        return {"how": how, "path": str(qpath), "lines": added,
                "next": {**ref, "kind": "question", "doc": "QUESTIONS.md", "key": f"**{title}**", "code": "",
                         "title": title}}

    def ask(self, tid: str, ask: dict, when: str | None = None) -> dict:
        """A question for the owner in parts, as a new item on top of their open questions in QUESTIONS.md: the
        words every reader knows, then the parts on a hidden line the page reads. Returns the item's key."""
        ru, when = self.russian(), when or dt.datetime.now().strftime("%d.%m")
        qpath = self.root / "docs" / "QUESTIONS.md"
        qlines = read(qpath).split("\n") if qpath.is_file() else ["# QUESTIONS — what waits for a human", ""]
        if not any(re.match(r"^## ", x) for x in qlines):
            qlines += ["## For the owner", ""]
        code = ticket_id(tid) if tid and re.fullmatch(r"(?i)b?\d+", tid.strip()) else ""
        key = f"**{ask['q'].rstrip('. ')} ({code + ', ' if code else ''}{when})**"
        end = open_slot(qlines, owner_words(self.cfg))
        body = [f"  {x}" for x in ask_text(ask, ru).split("\n")[1:] if x.strip()]
        item = [f"- {key}", *body, f"  {ask_mark(ask)}", ""]
        if end > 0 and qlines[end - 1].strip():
            item.insert(0, "")
        insert_block(qpath, qlines, end, item)
        return {"key": key, "path": str(qpath)}

    def take_back(self, placed: dict) -> bool:
        """Remove what `comment` added, if it is still there untouched."""
        return remove_block(placed)

    def done(self) -> list[dict]:
        """Tickets closed in docs/LOG.md, once each in log order: id, title, the day ("27.09") and
        the entry's text. Only `## 27.09 — B12 …` entries count."""
        out, seen = [], set()
        for head, body in re.findall(r"(?m)^## (.+)\n((?:(?!## ).*\n?)*)", doc(self.root, "LOG.md")):
            m = re.match(r"(\d{1,2}\.\d{2})\s*[—-]\s*(.*)", head.strip())
            if not m:
                continue
            title = re.sub(r"^B\d+\b[\s:—-]*|\s*\((?:B\d+[,\s]*)+\)", "", m.group(2)).strip()
            for code in re.findall(r"\bB\d+\b", m.group(2)):
                if code not in seen:
                    seen.add(code)
                    out.append({"id": code, "title": (title[:1].upper() + title[1:]) or code,
                                "day": m.group(1), "text": body.strip()})
        return out


def in_store(root: Path, cfg: dict | None = None) -> bool:
    """The project's tasks live in the store: `tasks.<folder> = store` in the config."""
    cfg = load_config() if cfg is None else cfg
    return cfg.get(f"tasks.{root.name}", "").lower() == "store"


def tasks_of(root: Path, cfg: dict | None = None) -> MarkdownTasks | StoreTasks:
    """Where a project's tickets and questions live: the store for a project the config moves there
    (`tasks.<folder> = store`), its markdown for every other one."""
    return StoreTasks(root, cfg) if in_store(root, cfg) else MarkdownTasks(root, cfg)


def parse_asks(root: Path) -> dict | None:
    text = doc(root, "ASKS.md")
    if not text:
        return None
    counts = {"open": 0, "lost": 0}
    for line in text.splitlines():
        if re.match(r"^\|\s*A\d+\s*\|", line):
            status = line.rstrip(" |").rsplit("|", 1)[-1].strip().lower()
            if re.match(r"(нет|lost)\b", status):
                counts["lost"] += 1
            elif re.match(r"(частично|partial|в работе|in progress)", status):
                counts["open"] += 1
    hook = ""
    script = root / "scripts" / "owner_asks.py"
    if script.is_file():
        try:
            r = subprocess.run([sys.executable, str(script), "--hook"], cwd=root, capture_output=True,
                               text=True, timeout=20)
            hook = r.stdout.strip() if r.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            pass
    return {**counts, "unregistered": hook}


def log_entries(root: Path) -> list[dict]:
    entries, cur = [], None
    for line in doc(root, "LOG.md").splitlines():
        if line.startswith("## "):
            cur = {"heading": line[3:].strip(), "first": ""}
            entries.append(cur)
        elif cur is not None and not cur["first"] and line.strip().startswith(("- ", "* ")):
            cur["first"] = line.strip()[2:]
    return entries


def seen_state() -> dict:
    try:
        return json.loads(SEEN.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def session_id(explicit: str | None = None) -> str:
    for v in (explicit, os.environ.get("AGENTDROP_SESSION"), os.environ.get("CLAUDE_CODE_SESSION_ID"),
              os.environ.get("CODEX_SESSION_ID")):
        if v:
            return v
    return f"{os.environ.get('USER') or os.environ.get('USERNAME') or 'user'}@{platform.node()}:{os.getppid()}"


def agent_name() -> str:
    agent = os.environ.get("AI_AGENT", "")
    if agent:
        return agent.split("_")[0]
    return "claude-code" if os.environ.get("CLAUDE_CODE_SESSION_ID") else "shell"


def claude_dir(root: Path) -> Path:
    return HOME / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(root))


def transcript(root: Path, sid: str) -> Path | None:
    p = claude_dir(root) / f"{sid}.jsonl"
    if p.is_file():
        return p
    return next(iter((HOME / ".claude" / "projects").glob(f"*/{sid}.jsonl")), None) if sid else None


def parse_time(s: str) -> dt.datetime | None:
    try:
        t = dt.datetime.fromisoformat(s)
        return t if t.tzinfo else t.astimezone()
    except (TypeError, ValueError):
        return None


def age(seconds: float, ru: bool) -> str:
    m = max(0, int(seconds // 60))
    if m < 60:
        return f"{m} {UNITS['min'][ru]}"
    if m < 48 * 60:
        return f"{m // 60} {UNITS['h'][ru]}" + (f" {m % 60} {UNITS['min'][ru]}" if m < 600 and m % 60 else "")
    return f"{m // 1440} {UNITS['d'][ru]}"


def read_claims(root: Path) -> list[dict]:
    out = []
    for f in sorted((root / CLAIMS).glob("*.json")):
        try:
            out.append(json.loads(f.read_text(encoding="utf-8")))
        except (OSError, ValueError):
            continue
    return out


def claim_activity(root: Path, c: dict) -> float:
    """Seconds since the claiming session last did anything we can see."""
    now = dt.datetime.now().astimezone()
    last = parse_time(c.get("started", "")) or now
    t = transcript(root, c.get("session", ""))
    if t:
        last = max(last, dt.datetime.fromtimestamp(t.stat().st_mtime).astimezone())
    return (now - last).total_seconds()


def git_summary(root: Path) -> dict:
    try:
        if git(root, "rev-parse", "--is-inside-work-tree").returncode != 0:
            return {}
    except FileNotFoundError:
        return {}
    branch = git(root, "branch", "--show-current").stdout.strip() or "(detached)"
    dirty = [l for l in git(root, "status", "--porcelain").stdout.splitlines() if l.strip()]
    ahead = git(root, "rev-list", "--count", "@{u}..HEAD")
    last = git(root, "log", "-1", "--format=%ct%x09%s").stdout.strip().split("\t", 1)
    info = {"branch": branch, "dirty": len(dirty),
            "ahead": int(ahead.stdout.strip()) if ahead.returncode == 0 and ahead.stdout.strip().isdigit() else None}
    if len(last) == 2 and last[0].isdigit():
        info["last_commit_age"] = dt.datetime.now().timestamp() - int(last[0])
        info["last_commit"] = last[1]
    return info


def sort_tickets(tickets: list[dict], claimed: set) -> dict:
    """The open tickets by whose move it is: "turn" (the owner wrote last), "deferred", "owner"
    (waits for the owner), "blocked" (waits for other people), "after" (waits for tickets still
    open) and "free" (next up, by priority then file order). Claimed tickets are in none."""
    turn = [t for t in tickets if t["owner_last"] and t["id"] not in claimed]
    deferred = [t for t in tickets if t["deferred"] and t["id"] not in claimed and not t["owner_last"]]
    open_ = [t for t in tickets if t["id"] not in claimed and not t["owner_last"] and not t["deferred"]]
    owner_tickets = [t for t in open_ if t["waits_owner"]]
    # a ticket blocked on someone else (a client's answer) is nobody's next step: counted, not listed
    blocked = [t for t in open_ if t["waits"] and not t["waits_owner"]]
    free = [t for t in open_ if not t["waits"]]
    free.sort(key=lambda t: (t["priority"], t["order"]))
    # the frontier: a ticket whose «После: B…» are still in TODO waits for them, it is not next yet
    in_todo = {t["id"] for t in tickets}
    for t in free:
        t["after_open"] = [x for x in t["after"] if x in in_todo]
    return {"turn": turn, "deferred": deferred, "owner": owner_tickets, "blocked": blocked,
            "after": [t for t in free if t["after_open"]], "free": [t for t in free if not t["after_open"]]}


def collect_status(root: Path) -> dict:
    cfg = load_config()
    src = tasks_of(root, cfg)
    ru = src.russian()
    stale_h = float(cfg.get("stale_hours", STALE_HOURS))
    tickets = src.tickets()
    by_id = {t["id"]: t for t in tickets}

    claims = []
    for c in read_claims(root):
        idle = claim_activity(root, c)
        started = parse_time(c.get("started", ""))
        t = by_id.get(c.get("ticket", ""), {})
        claims.append({**c, "title": t.get("title") or c.get("title", ""), "idle_seconds": int(idle),
                       "stale": idle > stale_h * 3600,
                       "running_seconds": int((dt.datetime.now().astimezone() - started).total_seconds())
                       if started else None})
    claimed = {c.get("ticket") for c in claims}
    claimed_sessions = {c.get("session") for c in claims}

    active = 0
    cdir = claude_dir(root)
    if cdir.is_dir():
        cutoff = dt.datetime.now().timestamp() - ACTIVE_MINUTES * 60
        active = sum(1 for f in cdir.glob("*.jsonl") if f.stat().st_mtime > cutoff and f.stem not in claimed_sessions)

    q = src.questions()
    b = sort_tickets(tickets, claimed)
    turn, deferred, owner_tickets, blocked, queued, free = (
        b["turn"], b["deferred"], b["owner"], b["blocked"], b["after"], b["free"])

    entries = log_entries(root)
    seen = seen_state().get(str(root))
    if seen:
        known = set(seen.get("headings", []))
        done = [e for e in entries if e["heading"] not in known]
    else:
        day = re.match(r"\S+", entries[0]["heading"]).group(0) if entries else ""
        done = [e for e in entries if e["heading"].startswith(day)] if day else []

    return {
        "project": root.name, "root": str(root), "ru": ru,
        "generated": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "waiting": {"questions": q["waiting"], "tickets": owner_tickets, "your_turn": q["your_turn"] + [f"{t['title']} ({t['id']})" for t in turn],
                    "turn_tickets": turn,
                    "revertible": q["revertible"], "people": q["people"],
                    "asks": parse_asks(root)},
        "running": {"claims": claims, "unclaimed_active_sessions": active, "active_minutes": ACTIVE_MINUTES},
        "done": {"since_seen": bool(seen), "seen_at": seen.get("at") if seen else None, "entries": done},
        "next": {"tickets": free[:SHOW["next"]], "rest": free[SHOW["next"]:], "blocked": blocked,
                 "after": queued, "deferred": deferred},
        "git": git_summary(root),
    }


def render_status(s: dict) -> str:
    ru = s["ru"]
    L = lambda k, **kw: LABELS[k][ru].format(**kw)
    out = [f"{s['project']} — {s['generated'][:16].replace('T', ' ')}"]
    g = s["git"]
    if g:
        bits = [L("branch", b=g["branch"])]
        if g["dirty"]:
            bits.append(L("dirty", n=g["dirty"]))
        if g.get("ahead"):
            bits.append(L("ahead", n=g["ahead"]))
        if "last_commit" in g:
            bits.append(L("last_commit", a=age(g["last_commit_age"], ru), s=clip(g["last_commit"], 80)))
        out.append("git: " + "; ".join(bits))

    def more(items, key):
        n = len(items) - SHOW[key]
        return [f"  … {L('more', n=n)}"] if n > 0 else []

    w = s["waiting"]
    out += ["", f"## {L('waiting')}"]
    for item in w["questions"][:SHOW["waiting"]]:
        out.append(f"- {item['title']}")
        if item["context"]:
            out.append(f"  {L('context')}: {item['context']}")
        if item["pick"]:
            out.append(f"  {L('pick')}: {item['pick']}")
    out += more(w["questions"], "waiting")
    for t in w["tickets"]:
        out.append(f"- {t['title']} ({t['id']}, {t['priority']})")
        out.append(f"  {L('waits')}: {t['waits']}")
    if w["your_turn"]:
        out.append("· " + L("your_turn", items="; ".join(w["your_turn"])))
    if w["revertible"]:
        out.append("· " + L("revertible", n=w["revertible"]))
    if w["people"]:
        out.append("· " + L("people", n=w["people"]))
    if w["asks"]:
        a = w["asks"]
        out.append("· " + L("asks_open", open=a["open"], lost=a["lost"]))
        if a["unregistered"]:
            out.append("· " + a["unregistered"])
    if not (w["questions"] or w["tickets"]):
        out.append(f"- {L('nothing')}")

    r = s["running"]
    out += ["", f"## {L('running')}"]
    for c in r["claims"][:SHOW["running"]]:
        started = parse_time(c.get("started", ""))
        when = started.strftime("%d.%m %H:%M") if started else "?"
        idle = age(c["idle_seconds"], ru)
        state = L("stale", a=idle) if c["stale"] else L("active", a=idle)
        title = c["title"] or c.get("ticket", "")
        sid = c.get("session", "")[:8]
        out.append(f"- {title} ({c.get('ticket')}) — {c.get('agent', '')} {sid}, "
                   f"{L('since', t=when)}; {state}" + (f"; {c['branch']}" if c.get("branch") else ""))
    if r["unclaimed_active_sessions"]:
        out.append("· " + L("unclaimed", n=r["unclaimed_active_sessions"], m=r["active_minutes"]))
    if not r["claims"] and not r["unclaimed_active_sessions"]:
        out.append(f"- {L('nothing')}")

    d = s["done"]
    out += ["", f"## {L('done') if d['since_seen'] else L('done_first')}"]
    for e in d["entries"][:SHOW["done"]]:
        out.append(f"- {clip(e['heading'], 160)}")
        if e["first"]:
            out.append(f"  {clip(e['first'], 200)}")
    out += more(d["entries"], "done")
    if not d["entries"]:
        out.append(f"- {L('nothing')}")

    n = s["next"]
    out += ["", f"## {L('next')}"]
    for t in n["tickets"]:
        mode = f"; {L('mode_' + t['mode'])}" if t.get("mode") else ""
        out.append(f"- {t['title']} ({t['id']}, {t['priority']}{mode})")
        if t["why"]:
            out.append(f"  {L('why')}: {t['why']}")
        elif t["context"]:
            out.append(f"  {L('context')}: {t['context']}")
        if t["waits"]:
            out.append(f"  {L('waits')}: {t['waits']}")
    if not n["tickets"]:
        out.append(f"- {L('nothing')}")
    if n["rest"]:
        counts = {}
        for t in n["rest"]:
            counts[t["priority"]] = counts.get(t["priority"], 0) + 1
        out.append("· " + L("open_rest", counts=", ".join(f"{p} {counts[p]}" for p in sorted(counts))))
    if n.get("after"):
        out.append("· " + L("after_open", items="; ".join(
            f"{clip(t['title'], 60)} ({t['id']} ← {', '.join(t['after_open'])})" for t in n["after"])))
    if n.get("blocked"):
        out.append("· " + L("blocked", items="; ".join(f"{clip(t['title'], 60)} ({t['id']})" for t in n["blocked"])))
    return "\n".join(out)


def mark_seen(root: Path) -> None:
    state = seen_state()
    state[str(root)] = {"at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                        "headings": [e["heading"] for e in log_entries(root)][:300]}
    STATE.mkdir(parents=True, exist_ok=True)
    SEEN.write_text(json.dumps(state, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")


def cmd_status(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop status",
                                description="The owner's board: what waits for you, what runs, what's done, what's next.")
    p.add_argument("path", nargs="?", default=".", help="Project directory (default: the current one)")
    p.add_argument("--json", action="store_true", help="Machine-readable output")
    p.add_argument("--mark-seen", action="store_true",
                   help="Remember the LOG entries shown, so the next status lists only newer ones")
    a = p.parse_args(argv)
    root = find_root(Path(a.path))
    if not tasks_of(root).present():
        print(f"agentdrop status: no docs/TODO.md in {root} or above", file=sys.stderr)
        return 2
    for note in sync_replies(timeout=6):   # the owner's Telegram answers land before anyone reads the docs
        print(note, file=sys.stderr)
    s = collect_status(root)
    print(json.dumps(s, ensure_ascii=False, indent=1) if a.json else render_status(s))
    if a.mark_seen:
        mark_seen(root)
    return 0


def claim_parser(name: str, desc: str) -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog=f"agentdrop {name}", description=desc)
    p.add_argument("ticket", help="Ticket number, e.g. B41")
    p.add_argument("--root", default=".", help="Project directory (default: the current one)")
    p.add_argument("--session", help="Session id (default: $AGENTDROP_SESSION, $CLAUDE_CODE_SESSION_ID, …)")
    p.add_argument("--force", action="store_true", help="Take over or drop another session's claim")
    return p


def ticket_id(raw: str) -> str:
    t = raw.strip().upper()
    return t if re.fullmatch(r"B\d+", t) else ("B" + t if t.isdigit() else t)


def cmd_claim(argv: list[str]) -> int:
    a = claim_parser("claim", "Claim a ticket for this session at the start of a pass.").parse_args(argv)
    root, tid, sid = find_root(Path(a.root)), ticket_id(a.ticket), session_id(a.session)
    src = tasks_of(root)
    ru = src.russian()
    d = root / CLAIMS
    f = d / f"{tid}.json"
    stale_h = float(load_config().get("stale_hours", STALE_HOURS))
    if f.exists():
        try:
            other = json.loads(f.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            other = {}
        if other.get("session") and other.get("session") != sid and not a.force:
            idle = claim_activity(root, other)
            started = other.get("started", "?")[:16].replace("T", " ")
            note = (" — зависло, можно забрать с --force" if ru else " — stale, take over with --force") \
                if idle > stale_h * 3600 else ""
            print((f"{tid} уже захвачен: {other.get('agent', '')} {other['session'][:8]} с {started}, "
                   f"последняя активность {age(idle, ru)} назад{note}. Возьми другой тикет или спроси владельца."
                   if ru else
                   f"{tid} is already claimed by {other.get('agent', '')} {other['session'][:8]} since {started}, "
                   f"last activity {age(idle, False)} ago{note}. Take another ticket or ask the owner."),
                  file=sys.stderr)
            return 1
    ticket = next((t for t in src.tickets() if t["id"] == tid), None)
    if ticket is None:
        print(f"! {tid} нет в docs/TODO.md — захватываю всё равно" if ru
              else f"! {tid} is not in docs/TODO.md — claiming anyway", file=sys.stderr)
    write_claim(root, tid, ticket["title"] if ticket else "", sid)
    print(f"✓ {tid} захвачен ({sid[:8]})" if ru else f"✓ {tid} claimed ({sid[:8]})")
    return 0


def cmd_release(argv: list[str]) -> int:
    a = claim_parser("release", "Release a ticket at the end of a pass.").parse_args(argv)
    root, tid, sid = find_root(Path(a.root)), ticket_id(a.ticket), session_id(a.session)
    src = tasks_of(root)
    ru = src.russian()
    f = root / CLAIMS / f"{tid}.json"
    if not f.exists():
        print(f"· {tid} не был захвачен" if ru else f"· {tid} was not claimed")
        return 0
    try:
        other = json.loads(f.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        other = {}
    if other.get("session") not in (None, sid) and not a.force:
        print((f"{tid} захвачен другой сессией ({other['session'][:8]}); снять — с --force" if ru
               else f"{tid} is held by another session ({other['session'][:8]}); use --force to drop it"),
              file=sys.stderr)
        return 1
    f.unlink()
    if isinstance(src, StoreTasks):
        src.released(tid, f"{agent_name()} {sid}")
    print(f"✓ {tid} отпущен" if ru else f"✓ {tid} released")
    return 0


