def item_span(lines: list[str], ref: dict) -> tuple[int, int] | None:
    code = ref.get("code")
    for _, a, b in md_spans(lines):
        first = lines[a][2:]
        if ref["kind"] == "ticket":
            m = ITEM_TICKET.match(first.replace("**", "", 1) if first.startswith("**") else first)
            if m and m.group(2) == ref["key"]:
                return a, b
        elif first.startswith(ref["key"]) or (code and first.startswith(f"**{code}.")):
            return a, b
    return None


def quote_lines(author: str, when: str, text: str, indent: str) -> list[str]:
    body = [f"**{author}, {when}:** " + (text.strip().splitlines() or [""])[0].strip()]
    body += [t.rstrip() for t in text.strip().splitlines()[1:]]
    out = []
    for k, t in enumerate(body):
        more = k < len(body) - 1 and body[k + 1].strip()
        out.append(f"{indent}> {t}{'  ' if t.strip() and more else ''}" if t.strip() else f"{indent}>")
    return out


def open_slot(lines: list[str], words: list[str]) -> int:
    """Where a new question for the owner goes: on top of the open list in the owner's section
    (newest first), never under "closed" or "revertible" subsections."""
    skip = re.compile(r"(?i)закрыт|closed|resolved|можно отменить|revert")
    heads = [(i, len(m.group(1))) for i, l in enumerate(lines) if (m := re.match(r"^(#{2,4})\s", l))]
    top = [i for i, lv in heads if lv == 2 and not skip.search(lines[i])]
    start = next((i for i in top if by_owner(lines[i], words)), top[0] if top else None)
    if start is None:
        return len(lines)
    stop = next((i for i, lv in heads if i > start and lv == 2), len(lines))
    subs = [i for i, lv in heads if start < i < stop]
    sub = next((i for i in subs if not skip.search(lines[i])), None if subs else start)
    if sub is None:   # only closed or revertible subsections: go before the first of them
        return subs[0]
    sub_end = next((i for i in subs if i > sub), stop)
    first = next((i for i in range(sub + 1, sub_end) if lines[i].startswith("- ")), None)
    if first is not None:
        return first
    end = sub_end
    while end > sub + 1 and not lines[end - 1].strip():
        end -= 1
    return end


