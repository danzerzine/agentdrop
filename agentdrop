class TgError(Exception):
    pass


class TgBusy(TgError):
    pass


def tg_env() -> dict:
    env = {}
    try:
        for line in TG_ENV.read_text(encoding="utf-8").splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                env[k.strip().removeprefix("export ").strip()] = v.strip().strip("\"'")
    except OSError:
        pass
    return env if env.get("TG_BOT_TOKEN") and env.get("TG_CHAT_ID") else {}


def tg_call(env: dict, method: str, payload: dict | bytes, timeout: float = 20,
            ctype: str = "application/json") -> object:
    import urllib.error
    import urllib.request
    base = (env.get("TG_RELAY_URL") or "https://api.telegram.org").rstrip("/")
    # Cloudflare answers 403 to the default Python-urllib user agent
    headers = {"content-type": ctype, "user-agent": "agentdrop/1"}
    if env.get("TG_RELAY_KEY"):
        headers["x-relay-key"] = env["TG_RELAY_KEY"]
    req = urllib.request.Request(f"{base}/bot{env['TG_BOT_TOKEN']}/{method}",
                                 data=payload if isinstance(payload, bytes) else json.dumps(payload).encode(),
                                 headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        try:
            data = json.load(e)
        except ValueError:
            raise TgError(f"HTTP {e.code}") from None
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise TgError(str(getattr(e, "reason", e))) from None
    if not data.get("ok"):
        raise TgError(str(data.get("description", "error")))
    return data["result"]


def tg_html(text: str) -> str:
    """Markdown bits of a doc line as Telegram HTML."""
    import html
    t = html.escape(text, quote=False)
    # Telegram turns a bare "QUESTIONS.md" into a link to a website; a file name goes as code
    t = "`".join(re.sub(r"(?<![\w/`])([\w.-]+(?:/[\w.-]+)*\.(?:md|py|csv|json|jsonl|sh|txt|js|html|yml|yaml))\b",
                        r"`\1`", part) if k % 2 == 0 else part for k, part in enumerate(t.split("`")))
    t = re.sub(r"`([^`\n]+)`", r"<code>\1</code>", t)
    t = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", t)
    return re.sub(r"\[([^\]]+)\]\((https?://[^)\s]+)\)", r'<a href="\2">\1</a>', t)


def tg_plain(text: str) -> str:
    import html
    return html.unescape(re.sub(r"<[^>]+>", "", text))


def tg_photos(env: dict, paths: list[str], reply_to: int) -> list[int]:
    """Send pictures as one album (or one photo) under a message."""
    import uuid
    boundary = uuid.uuid4().hex
    parts, media = [], []
    for k, path in enumerate(paths):
        media.append({"type": "photo", "media": f"attach://f{k}"})
        data = Path(path).read_bytes()
        parts.append((f'--{boundary}\r\nContent-Disposition: form-data; name="f{k}"; filename="{Path(path).name}"\r\n'
                      f"Content-Type: application/octet-stream\r\n\r\n").encode() + data + b"\r\n")
    fields = {"chat_id": str(env["TG_CHAT_ID"]), "media": json.dumps(media),
              "reply_parameters": json.dumps({"message_id": reply_to, "allow_sending_without_reply": True})}
    for k, v in fields.items():
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode())
    body = b"".join(parts) + f"--{boundary}--\r\n".encode()
    res = tg_call(env, "sendMediaGroup", body, timeout=60, ctype=f"multipart/form-data; boundary={boundary}")
    return [m["message_id"] for m in res]


def tg_try(env: dict, method: str, payload: dict) -> None:
    """A call whose failure changes nothing for the owner (a stale button toast, an unchanged edit)."""
    try:
        tg_call(env, method, payload)
    except TgError:
        pass


def tg_send(env: dict, text: str, reply_to: int | None = None, markup: dict | None = None) -> int:
    hour = dt.datetime.now().hour
    payload = {"chat_id": env["TG_CHAT_ID"], "text": text, "parse_mode": "HTML",
               "link_preview_options": {"is_disabled": True},
               "disable_notification": hour >= QUIET_HOURS[0] or hour < QUIET_HOURS[1]}
    if reply_to:
        payload["reply_parameters"] = {"message_id": reply_to, "allow_sending_without_reply": True}
    if markup:
        payload["reply_markup"] = markup
    try:
        return tg_call(env, "sendMessage", payload)["message_id"]
    except TgError as e:
        if "parse" not in str(e).lower():
            raise
        payload.pop("parse_mode")   # a tag broke somewhere: the same words, without formatting
        payload["text"] = tg_plain(text)
        return tg_call(env, "sendMessage", payload)["message_id"]


