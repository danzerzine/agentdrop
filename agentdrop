# `agentdrop tickets`: every ticket and every question for the owner across projects, with full
# text and thread, as JSON for a page where the owner opens one item and answers it.

def collect_items(root: Path, cfg: dict) -> tuple[dict, list[dict]]:
    s = collect_status(root)
    label = project_label(root, cfg)
    prefix = "".join(w[0] for w in re.split(r"[-_ ]+", label) if w)[:3].lower() or "p"
    proj = {"key": prefix, "label": label, "root": str(root), "ru": s["ru"]}
    state = {}
    for key, ts in (("owner", s["waiting"]["tickets"]), ("turn", s["waiting"]["turn_tickets"]),
                    ("next", s["next"]["tickets"] + s["next"]["rest"] + s["next"]["after"]),
                    ("others", s["next"]["blocked"]),
                    ("later", s["next"]["deferred"])):
        for t in ts:
            state.setdefault(t["id"], key)
    for c in s["running"]["claims"]:
        state.setdefault(c.get("ticket", ""), "running")
    src = tasks_of(root, cfg)
    items = []
    for t in src.tickets(full=True):
        items.append({"id": f"{prefix}-{t['id']}", "project": prefix, "code": t["id"], "kind": "ticket",
                      "title": t["title"], "priority": t["priority"], "section": t["section"],
                      "state": state.get(t["id"], "next"), "why": t["why"], "waits": t["waits"],
                      "body": t["body"], "thread": t["thread"],
                      "images": t["images"], "doc": t["doc"], "ask": t.get("ask")})
    for x in src.questions(full=True)["items"]:
        code = re.match(r"([A-ZА-ЯЁ]{1,3}-\d+)", x["key"])
        items.append({"id": f"{prefix}-{x.get('id') or 'q' + sha(x['key'].encode())[:6]}", "project": prefix,
                      "code": code.group(1) if code else "", "kind": "question", "title": x["title"],
                      "priority": "", "section": "QUESTIONS", "state": x["state"], "why": "", "waits": "",
                      "pick": x["pick"], "body": x["body"], "thread": x["thread"],
                      "images": x["images"], "doc": x["doc"], "ask": x.get("ask")})
    have = {i["code"] for i in items}
    for d in src.done():   # closed tickets, so a link from another ticket opens something
        if d["id"] not in have:
            items.append({"id": f"{prefix}-{d['id']}", "project": prefix, "code": d["id"], "kind": "ticket",
                          "title": d["title"], "priority": "", "section": "LOG", "state": "done",
                          "why": "", "waits": "", "body": f"Сделано {d['day']}.\n\n{d['text']}",
                          "thread": [], "images": [], "doc": "LOG.md"})
    return proj, items


IMG_EXT = {".png", ".jpg", ".jpeg", ".webp"}


def page_image(src: Path, out_dir: Path) -> str:
    """A copy of a screenshot for the tickets page: JPEG, at most 1600 px on the long side (sips on a Mac, else as is)."""
    out_dir.mkdir(parents=True, exist_ok=True)
    name = f"{sha(str(src.resolve()).encode())[:10]}.jpg"
    dst = out_dir / name
    if not dst.exists() or dst.stat().st_mtime < src.stat().st_mtime:
        if shutil.which("sips"):
            subprocess.run(["sips", "-s", "format", "jpeg", "-s", "formatOptions", "80", "--resampleHeightWidthMax", "1600",
                            str(src), "--out", str(dst)], capture_output=True)
        if not dst.exists():
            name = f"{sha(str(src.resolve()).encode())[:10]}{src.suffix.lower()}"
            shutil.copyfile(src, out_dir / name)
    return f"img/{name}"


def cmd_tickets(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop tickets",
                                description="Every ticket and question for the owner, with full text and thread, "
                                            "as JSON (for a page that opens one item).")
    p.add_argument("paths", nargs="*", help="Project directories (default: `projects` in the config, or every "
                                            "project whose board was looked at)")
    p.add_argument("--docs", metavar="FILE", help="Also write the project .md files the items mention in backticks "
                                                   "(`docs/HYPOTHESES.md`), so the page can open them")
    a = p.parse_args(argv)
    cfg = load_config()
    roots = [find_root(Path(os.path.expanduser(x))) for x in a.paths] or dispatch_projects(cfg)
    out = {"generated": dt.datetime.now().astimezone().isoformat(timespec="minutes"), "projects": [], "items": []}
    docs = {"refs": {}, "files": {}}   # refs: "sd:specs/x.md" -> "sd:docs/specs/x.md"; files: that -> text
    for root in roots:
        proj, items = collect_items(root, cfg)
        out["projects"].append(proj)
        out["items"] += items
        for it in items:
            text = " ".join([it["body"], it.get("why", ""), *(m["text"] for m in it["thread"])])
            for ref in re.findall(r"`([^`\s]+\.md)`", text):
                f = next((root / c for c in (ref, f"docs/{ref}") if (root / c).is_file()), None)
                if f:
                    real = f"{proj['key']}:{f.relative_to(root).as_posix()}"
                    docs["refs"][f"{proj['key']}:{ref}"] = real
                    docs["files"].setdefault(real, f.read_text(encoding="utf-8", errors="replace"))
            if a.docs and (it.get("ask") or {}).get("pics"):   # a question's pictures, checked again: inside the project
                pics = []
                for x in it["ask"]["pics"]:
                    rel, why = ask_picture(root, x.get("path", ""))
                    if not why:
                        pics.append({**x, "src": page_image(root / rel, Path(a.docs).parent / "img")})
                it["ask"] = {**it["ask"], "pics": pics}
            if a.docs and it["state"] != "done":   # screenshots it names, a file or a folder of them, shown inline
                pics = []
                for ref in re.findall(r"`([^`\s]+)`", text) + re.findall(r"[\w./-]+\.(?:png|jpe?g|webp)\b", text, re.I):
                    for base in (root, root / "docs"):
                        p = base / ref
                        if p.is_dir():
                            pics += sorted(x for x in p.iterdir() if x.suffix.lower() in IMG_EXT)
                            break
                        if p.is_file() and p.suffix.lower() in IMG_EXT:
                            pics.append(p)
                            break
                asked = {(root / x["path"]).resolve() for x in (it.get("ask") or {}).get("pics", [])}
                inside = lambda x: root.resolve() in x.resolve().parents   # never a file outside the project
                pics = [x for x in dict.fromkeys(pics) if inside(x) and x.resolve() not in asked][:8]
                if pics:
                    docs.setdefault("images", {})[it["id"]] = [
                        {"src": page_image(x, Path(a.docs).parent / "img"), "name": x.stem} for x in pics]
    if a.docs:
        Path(a.docs).write_text(json.dumps(docs, ensure_ascii=False), encoding="utf-8")
    print(json.dumps(out, ensure_ascii=False, indent=1))
    return 0


# --- subscription limits: can an autonomous run start now ---------------------------------------------
# Claude Code writes a rate_limit_event at the start of every `claude -p` run with stream-json output: how full
# the five-hour and the seven-day windows are and when they reset. The newest one is the measurement.

LIMIT_LOGS = HOME / ".agentdrop" / "scheduled" / "logs"
LIMIT_FRESH_MIN = 90        # an older measurement says nothing about now
LIMIT_FIVE_HOUR_MAX = 0.70  # above this the five-hour window stays for the owner's own work


def limit_readings(roots: list[Path], since: float) -> list[dict]:
    """Every measurement in run logs written after `since`, oldest first."""
    files = list(LIMIT_LOGS.glob("*.jsonl")) + [f for r in roots for f in (r / PACK_DIR).glob("*.jsonl")]
    out = []
    for f in files:
        try:
            st = f.stat()
        except OSError:
            continue
        if st.st_mtime < since:
            continue
        m = re.search(r"(\d{8}-\d{4})", f.stem)   # the run's start: page-20260927-1805, 20260927-1307-2
        started = dt.datetime.strptime(m.group(1), "%Y%m%d-%H%M").timestamp() if m else st.st_mtime
        with f.open(encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if '"rate_limit_event"' not in line:
                    continue
                try:
                    w = json.loads(line)["rate_limit_info"]["unifiedWindows"]
                    out.append({"at": started, "written": st.st_mtime,
                                "five_hour": float(w["five_hour"]["utilization"]),
                                "five_hour_resets": int(w["five_hour"]["resetsAt"]),
                                "seven_day": float(w["seven_day"]["utilization"]),
                                "seven_day_resets": int(w["seven_day"]["resetsAt"])})
                except (ValueError, KeyError, TypeError):
                    continue
    # newest last by when the log was last written, not when its run started: a long run's latest line is fresh
    return sorted(out, key=lambda r: (r["written"], r["at"]))


def limits_verdict(readings: list[dict], now: float) -> dict:
    """Can an autonomous run start: a fresh measurement, the five-hour window at most 70% full, and today's use
    of the seven-day window under the daily share (its free part at the day's first measurement / days to its
    reset). Today's use counts every run, the owner's too, so autonomous runs give way when he works a lot."""
    if not readings:
        return {"can_start": False, "reason": "no_reading", "why": "no measurement in the run logs"}
    last = readings[-1]
    age = max(int((now - last["written"]) // 60), 0)   # a log written this very second
    midnight = dt.datetime.fromtimestamp(now).replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
    today = [r for r in readings if r["at"] >= midnight and r["seven_day_resets"] == last["seven_day_resets"]]
    first = today[0] if today else last
    days = max((first["seven_day_resets"] - first["at"]) / 86400, 1.0)
    share = round((1 - first["seven_day"]) / days, 4)
    spent = round(max(last["seven_day"] - first["seven_day"], 0.0), 4)
    out = {"measured_at": dt.datetime.fromtimestamp(last["written"]).astimezone().isoformat(timespec="minutes"),
           "age_min": age,
           "five_hour": {"used": last["five_hour"], "resets_at": dt.datetime.fromtimestamp(
               last["five_hour_resets"]).astimezone().isoformat(timespec="minutes")},
           "seven_day": {"used": last["seven_day"], "resets_at": dt.datetime.fromtimestamp(
               last["seven_day_resets"]).astimezone().isoformat(timespec="minutes")},
           "today": {"spent": spent, "share": share}}
    if age > LIMIT_FRESH_MIN:
        return {**out, "can_start": False, "reason": "stale",
                "why": f"the last measurement is {age} min old, older than {LIMIT_FRESH_MIN}"}
    if last["five_hour"] > LIMIT_FIVE_HOUR_MAX:
        return {**out, "can_start": False, "reason": "five_hour",
                "why": f"the five-hour window is {last['five_hour']:.0%} full, over {LIMIT_FIVE_HOUR_MAX:.0%}"}
    if spent >= share:
        return {**out, "can_start": False, "reason": "daily_share",
                "why": f"today used {spent:.0%} of the week, the daily share is {share:.0%}"}
    return {**out, "can_start": True, "reason": "ok",
            "why": f"five-hour window {last['five_hour']:.0%}, today {spent:.0%} of a {share:.0%} daily share"}


def cmd_limits(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop limits",
                                description="How full the subscription's five-hour and seven-day windows are, and "
                                            "whether an autonomous run may start now. Exit 0 when it may.")
    p.add_argument("paths", nargs="*", help="Project directories whose pack logs to read (default: as `tickets`)")
    p.add_argument("--json", action="store_true", help="Print the measurement and the verdict as JSON")
    a = p.parse_args(argv)
    cfg = load_config()
    roots = [find_root(Path(os.path.expanduser(x))) for x in a.paths] or dispatch_projects(cfg)
    now = dt.datetime.now().timestamp()
    v = limits_verdict(limit_readings(roots, now - 8 * 86400), now)
    if a.json:
        print(json.dumps(v, ensure_ascii=False, indent=1))
    else:
        if "five_hour" in v:
            print(f"five-hour window  {v['five_hour']['used']:.0%}, resets {v['five_hour']['resets_at']}")
            print(f"seven-day window  {v['seven_day']['used']:.0%}, resets {v['seven_day']['resets_at']}")
            print(f"today             {v['today']['spent']:.0%} of the week, daily share {v['today']['share']:.0%}")
            print(f"measured          {v['measured_at']} ({v['age_min']} min ago)")
        print(("yes: " if v["can_start"] else "no: ") + v["why"])
    return 0 if v["can_start"] else 1


# `agentdrop store`: the tasks of every project in one SQLite file on this machine. Projects still
# live in markdown for now: `import` copies one into the store and `check` shows where the two
# differ. Every change the store takes is written to an append-only journal of events.

STORE_STATES = ("queued", "running", "waiting_you", "waiting_task", "waiting_others", "accepting", "done", "deferred")
STATE_NAMES = {   # the glossary's names, English and Russian; `agentdrop task state` takes any of them
    "queued": ("Queued", "В очереди"), "running": ("Running", "В работе"), "waiting_you": ("Waits for you", "Ждёт вас"),
    "waiting_task": ("Waits for another task", "Ждёт другую задачу"),
    "waiting_others": ("Waits for other people", "Ждёт других людей"),
    "accepting": ("In acceptance", "На приёмке"), "done": ("Done", "Готово"), "deferred": ("Deferred", "Отложена")}
STORE_FIELDS = ("kind", "title", "text", "source", "state", "priority", "theme", "mode", "waits",
                "section", "position")
STORE_TASKS = f"""
CREATE TABLE IF NOT EXISTS {{name}} (
  project TEXT NOT NULL REFERENCES projects(name),
  id TEXT NOT NULL,                      -- B12, or q1a2b3c for a question turned into a task
  kind TEXT NOT NULL CHECK (kind IN ('ticket', 'question')),
  title TEXT NOT NULL,
  text TEXT NOT NULL DEFAULT '',
  source TEXT NOT NULL DEFAULT '',       -- where it came from: the quoted why, or the log entry
  state TEXT NOT NULL CHECK (state IN ({", ".join(f"'{s}'" for s in STORE_STATES)})),
  priority TEXT NOT NULL DEFAULT '',     -- P0..P3
  theme TEXT NOT NULL DEFAULT '',
  mode TEXT NOT NULL DEFAULT '' CHECK (mode IN ('', 'auto', 'human')),   -- auto: may run unattended
  waits TEXT NOT NULL DEFAULT '',        -- whom or what it waits for, in words
  section TEXT NOT NULL DEFAULT '',
  position INTEGER NOT NULL DEFAULT 0,   -- order within its kind, as in the project
  created TEXT NOT NULL,
  updated TEXT NOT NULL,
  PRIMARY KEY (project, id)
);
"""
STORE_SCHEMA = """
CREATE TABLE IF NOT EXISTS projects (
  name TEXT PRIMARY KEY,
  root TEXT NOT NULL
);
""" + STORE_TASKS.format(name="tasks") + """
CREATE TABLE IF NOT EXISTS links (       -- task runs after the other one is done
  project TEXT NOT NULL,
  task TEXT NOT NULL,
  after TEXT NOT NULL,
  PRIMARY KEY (project, task, after),
  FOREIGN KEY (project, task) REFERENCES tasks(project, id)
);
CREATE TABLE IF NOT EXISTS comments (    -- a task's thread, in order
  project TEXT NOT NULL,
  task TEXT NOT NULL,
  n INTEGER NOT NULL,
  author TEXT NOT NULL,
  at TEXT NOT NULL,                      -- as written: "26.09" or "26.09 14:05"
  text TEXT NOT NULL,
  ask TEXT NOT NULL DEFAULT '',          -- a question in parts (`task ask`), JSON; '' for words alone
  PRIMARY KEY (project, task, n),
  FOREIGN KEY (project, task) REFERENCES tasks(project, id)
);
CREATE TABLE IF NOT EXISTS events (      -- append-only: every change, when and by whom
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  at TEXT NOT NULL,
  author TEXT NOT NULL,
  project TEXT NOT NULL,
  task TEXT NOT NULL,
  what TEXT NOT NULL,                    -- created, changed, links, comment, thread, state, taken, …
  detail TEXT NOT NULL DEFAULT '{}'
);
CREATE INDEX IF NOT EXISTS events_by_task ON events (project, task, id);
CREATE TRIGGER IF NOT EXISTS events_no_update BEFORE UPDATE ON events
  BEGIN SELECT RAISE(ABORT, 'events are append-only'); END;
CREATE TRIGGER IF NOT EXISTS events_no_delete BEFORE DELETE ON events
  BEGIN SELECT RAISE(ABORT, 'events are append-only'); END;
"""


def store_path() -> Path:
    """The store: ~/.agentdrop/tasks.sqlite3, or AGENTDROP_STORE (tests point it elsewhere)."""
    return Path(os.environ.get("AGENTDROP_STORE") or STATE / "tasks.sqlite3")


def store_open() -> sqlite3.Connection:
    path = store_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(path, timeout=30)
    conn.row_factory = sqlite3.Row
    old = conn.execute("SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'tasks'").fetchone()
    if old and "'waiting_others'" not in old[0]:   # a store from before the eighth state: widen its CHECK
        conn.executescript("PRAGMA foreign_keys = OFF; BEGIN IMMEDIATE;" + STORE_TASKS.format(name="tasks_new")
                           + "INSERT INTO tasks_new SELECT * FROM tasks; DROP TABLE tasks;"
                           " ALTER TABLE tasks_new RENAME TO tasks; COMMIT;")
    conn.execute("PRAGMA foreign_keys = ON")
    conn.executescript(STORE_SCHEMA)
    if "ask" not in {c[1] for c in conn.execute("PRAGMA table_info(comments)")}:   # a store from before questions in parts
        try:
            conn.execute("ALTER TABLE comments ADD COLUMN ask TEXT NOT NULL DEFAULT ''")
            conn.commit()
        except sqlite3.OperationalError:   # another process added it first
            pass
    return conn


def markdown_records(root: Path, cfg: dict) -> list[dict]:
    """A project's tasks as the store keeps them, read from its markdown: open tickets with their
    state, every question as a task «Решить: …», and tickets closed in the log."""
    src = MarkdownTasks(root, cfg)
    ru = src.russian()
    tickets = src.tickets(full=True)
    claimed = {c.get("ticket") for c in read_claims(root)}
    state = {t["id"]: "running" for t in tickets if t["id"] in claimed}
    board = sort_tickets(tickets, claimed)
    for key, st in (("turn", "queued"), ("deferred", "deferred"), ("owner", "waiting_you"),
                    ("blocked", "waiting_others"), ("after", "waiting_task"), ("free", "queued")):
        for t in board[key]:
            state[t["id"]] = st
    thread = lambda th: [{"author": c["author"], "at": c["when"], "text": c["text"]} for c in th]
    out = []
    for t in tickets:
        out.append({"id": t["id"], "kind": "ticket", "title": t["title"], "text": t["body"], "source": t["why"],
                    "state": state[t["id"]], "priority": t["priority"], "theme": t["theme"], "mode": t["mode"],
                    "waits": t["waits"], "section": t["section"], "position": t["order"][1],
                    "after": sorted(t["after"]), "thread": thread(t["thread"])})
    # a question the owner answered last is the agent's move; one closed is done; one for others waits for them;
    # the rest wait for the owner
    q_state = {"turn": "queued", "deferred": "deferred", "closed": "done", "people": "waiting_others"}
    for i, q in enumerate(src.question_items()):
        body, th = split_thread(q["body"])
        out.append({"id": "q" + sha((q["key"] or q["text"].split("\n", 1)[0]).encode())[:6], "kind": "question",
                    "title": ("Решить: " if ru else "Decide: ") + (q["title"] or clip(q["text"], 80)).rstrip(". "),
                    "text": body, "source": "", "state": q_state.get(q["group"], "waiting_you"),
                    "priority": "", "theme": "", "mode": "", "waits": "", "section": q["path"], "position": i,
                    "after": [], "thread": thread(th)})
    open_ids = {t["id"] for t in tickets}
    for i, d in enumerate(x for x in src.done() if x["id"] not in open_ids):
        out.append({"id": d["id"], "kind": "ticket", "title": d["title"], "text": d["text"],
                    "source": f"LOG.md {d['day']}", "state": "done", "priority": "", "theme": "", "mode": "",
                    "waits": "", "section": "LOG", "position": i, "after": [], "thread": []})
    seen = {}
    for r in out:   # the same id twice in the files: the later one gets a suffix, so neither is lost
        n = seen[r["id"]] = seen.get(r["id"], 0) + 1
        if n > 1:
            r["id"] = f"{r['id']}-{n}"
    return out


def store_records(conn: sqlite3.Connection, project: str, tid: str | None = None) -> list[dict]:
    """A project's tasks in the store (or the one task `tid`), in the shape `markdown_records` gives."""
    out = []
    for row in conn.execute("SELECT * FROM tasks WHERE project = ? AND (? IS NULL OR id = ?) "
                            "ORDER BY kind DESC, state = 'done', position", (project, tid, tid)):
        r = {"id": row["id"], **{f: row[f] for f in STORE_FIELDS}, "updated": row["updated"]}
        r["after"] = [x[0] for x in conn.execute(
            "SELECT after FROM links WHERE project = ? AND task = ? ORDER BY after", (project, row["id"]))]
        rows = conn.execute("SELECT author, at, text, ask FROM comments WHERE project = ? AND task = ? ORDER BY n",
                            (project, row["id"])).fetchall()
        r["thread"] = [{"author": x["author"], "at": x["at"], "text": x["text"]} for x in rows]
        r["ask"] = None   # the latest question in parts, while nobody has answered under it
        for k, x in enumerate(rows):
            if x["ask"]:
                try:
                    r["ask"] = {**json.loads(x["ask"]), "n": k, "author": x["author"], "at": x["at"]}
                except ValueError:
                    pass
            elif r["ask"] and x["author"] and x["author"] != r["ask"]["author"]:
                r["ask"] = None
        out.append(r)
    return out


def store_import(conn: sqlite3.Connection, project: str, root: Path, records: list[dict],
                 author: str = "import") -> dict:
    """Write the records into the store: new tasks are created, changed fields, links and threads
    updated, each with an event; a task the same as before is left alone, so importing twice adds
    nothing. Tasks the store has but the records don't are only counted ("gone")."""
    now = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    n = {"new": 0, "changed": 0, "same": 0, "comments": 0, "events": 0}

    def event(task: str, what: str, detail: dict) -> None:
        conn.execute("INSERT INTO events (at, author, project, task, what, detail) VALUES (?, ?, ?, ?, ?, ?)",
                     (now, author, project, task, what, json.dumps(detail, ensure_ascii=False)))
        n["events"] += 1

    def add_comments(task: str, start: int, comments: list[dict]) -> None:
        conn.executemany("INSERT INTO comments (project, task, n, author, at, text) VALUES (?, ?, ?, ?, ?, ?)",
                         [(project, task, start + i, c["author"], c["at"], c["text"]) for i, c in enumerate(comments)])
        n["comments"] += len(comments)

    with conn:
        conn.execute("INSERT INTO projects (name, root) VALUES (?, ?) ON CONFLICT (name) DO UPDATE SET root = excluded.root",
                     (project, str(root)))
        have = {r["id"]: r for r in store_records(conn, project)}
        for r in records:
            old, tid = have.get(r["id"]), r["id"]
            if old is None:
                conn.execute(f"INSERT INTO tasks (project, id, {', '.join(STORE_FIELDS)}, created, updated) "
                             f"VALUES (?, ?, {', '.join('?' * len(STORE_FIELDS))}, ?, ?)",
                             (project, tid, *(r[f] for f in STORE_FIELDS), now, now))
                conn.executemany("INSERT INTO links (project, task, after) VALUES (?, ?, ?)",
                                 [(project, tid, x) for x in r["after"]])
                add_comments(tid, 0, r["thread"])
                event(tid, "created", {**{f: r[f] for f in STORE_FIELDS}, "after": r["after"],
                                       "comments": len(r["thread"])})
                n["new"] += 1
                continue
            changed = {f: [old[f], r[f]] for f in STORE_FIELDS if old[f] != r[f]}
            if changed:
                conn.execute(f"UPDATE tasks SET {', '.join(f'{f} = ?' for f in changed)} WHERE project = ? AND id = ?",
                             (*(r[f] for f in changed), project, tid))
                event(tid, "changed", changed)
            if old["after"] != r["after"]:
                conn.execute("DELETE FROM links WHERE project = ? AND task = ?", (project, tid))
                conn.executemany("INSERT INTO links (project, task, after) VALUES (?, ?, ?)",
                                 [(project, tid, x) for x in r["after"]])
                event(tid, "links", {"after": [old["after"], r["after"]]})
            if old["thread"] != r["thread"]:
                if r["thread"][:len(old["thread"])] == old["thread"]:   # new answers under the old ones
                    new = r["thread"][len(old["thread"]):]
                    add_comments(tid, len(old["thread"]), new)
                    for c in new:
                        event(tid, "comment", c)
                else:   # the thread was edited: keep what the files say now
                    conn.execute("DELETE FROM comments WHERE project = ? AND task = ?", (project, tid))
                    add_comments(tid, 0, r["thread"])
                    event(tid, "thread", {"before": old["thread"], "after": r["thread"]})
            if changed or old["after"] != r["after"] or old["thread"] != r["thread"]:
                conn.execute("UPDATE tasks SET updated = ? WHERE project = ? AND id = ?", (now, project, tid))
                n["changed"] += 1
            else:
                n["same"] += 1
    n["gone"] = sorted(set(have) - {r["id"] for r in records})
    return n


def store_diff(md: list[dict], st: list[dict]) -> list[str]:
    """Where the store and the markdown disagree, one line each; empty when they give the same."""
    a, b = {r["id"]: r for r in md}, {r["id"]: r for r in st}
    out = [f"{i}: only in markdown ({clip(a[i]['title'], 60)})" for i in a if i not in b]
    out += [f"{i}: only in the store ({clip(b[i]['title'], 60)})" for i in b if i not in a]
    for i in (i for i in a if i in b):
        for f in (*STORE_FIELDS, "after", "thread"):
            if a[i][f] != b[i][f]:
                show = lambda v: clip(json.dumps(v, ensure_ascii=False), 80)
                out.append(f"{i} {f}: markdown {show(a[i][f])}, store {show(b[i][f])}")
    return out


def store_counts(records: list[dict]) -> str:
    n = lambda k, word: f"{k} {word}{'s' * (k != 1)}"
    return (f"{n(sum(r['kind'] == 'ticket' for r in records), 'ticket')} "
            f"({sum(r['kind'] == 'ticket' and r['state'] == 'done' for r in records)} done), "
            f"{n(sum(r['kind'] == 'question' for r in records), 'question')} as tasks, "
            f"{n(sum(len(r['thread']) for r in records), 'comment')}, "
            f"{n(sum(len(r['after']) for r in records), '«after» link')}")


def cmd_store(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop store",
                                description=f"The task store ({store_path()}, AGENTDROP_STORE to use another). "
                                            "Projects still live in markdown; this copies them in and compares.")
    sub = p.add_subparsers(dest="action", required=True)
    for name, text in (("import", "Copy a project's tickets and questions from its markdown into the store "
                                  "(again: only what changed, never twice)"),
                       ("check", "Compare the store with the project's markdown; exit 1 when they differ")):
        sp = sub.add_parser(name, help=text, description=text)
        sp.add_argument("path", nargs="?", default=".", help="Project directory (default: the current one)")
        if name == "import":
            sp.add_argument("--force", action="store_true", help="Import even into a project that works from the store")
    a = p.parse_args(argv)
    root, cfg = find_root(Path(a.path)), load_config()
    if not MarkdownTasks(root, cfg).present():
        print(f"agentdrop store: no docs/TODO.md in {root} or above", file=sys.stderr)
        return 2
    if a.action == "import" and in_store(root, cfg) and not a.force:
        print(f"agentdrop store: {root.name} already works from the store (tasks.{root.name} = store), so its "
              "markdown is out of date; importing it would undo the changes made since. --force to do it anyway",
              file=sys.stderr)
        return 2
    project, records = root.name, markdown_records(root, cfg)
    conn = store_open()
    try:
        if a.action == "import":
            n = store_import(conn, project, root, records)
            print(f"{project}: {store_counts(records)}.")
            print(f"store {store_path()}: {n['new']} new, {n['changed']} changed, {n['same']} unchanged, "
                  f"{n['comments']} comments added, {n['events']} events")
            if n["gone"]:
                print(f"in the store but no longer in the markdown: {', '.join(n['gone'])}")
            return 0
        diffs = store_diff(records, store_records(conn, project))
        for line in diffs:
            print(line)
        print(f"{project}: {len(diffs)} differences between the store and the markdown" if diffs
              else f"{project}: the store and the markdown match: {store_counts(records)}")
        return 1 if diffs else 0
    finally:
        conn.close()


# A project whose tasks live in the store (`tasks.<folder> = store` in the config) reads and changes them
# through `StoreTasks`, the same interface `MarkdownTasks` gives, so status, tickets, brief, pack, dispatch
# and accept work on it unchanged; agents use `agentdrop task …` instead of editing TODO.md and QUESTIONS.md.

STORE_DOC = "store"   # where an item lives, for the page and the messages (TODO.md / QUESTIONS.md in markdown)
Q_PREFIX = re.compile(r"^(?:Решить|Decide):\s*")
HOLDS = ("running", "accepting")   # the states in which a session keeps its claim on a task


def section_rank(section: str) -> int:
    return next((order for rx, order, _ in SECTION_ORDER if rx.search(section)), 1)


def thread_head(c: dict) -> str:
    """A comment's first line as the markdown thread writes it: the board's "last"."""
    who = c["author"] + (f", {c['at']}" if c["at"] else "")
    return clip(f"**{who}:** " + (c["text"].splitlines() or [""])[0], 400)


def question_key(title: str) -> str:
    """"Which chart library (Q-2)" → "Q-2. Which chart library": the code in front, as QUESTIONS.md writes it."""
    m = re.match(r"(.*?)\s*\(([A-ZА-ЯЁ]{1,3}-\d+)\)$", title)
    return f"{m.group(2)}. {m.group(1)}" if m else title


def state_of(raw: str) -> str | None:
    """A state from its key or its glossary name in either language: "waiting_you", "Ждёт вас", "done"."""
    low = raw.strip().lower().replace("ё", "е")
    for key, names in STATE_NAMES.items():
        if low in (key, *(n.lower().replace("ё", "е") for n in names)):
            return key
    return None


def write_claim(root: Path, tid: str, title: str, sid: str) -> None:
    """docs/.claims/<tid>.json for this session, with where the work starts (the judge's base)."""
    d = root / CLAIMS
    branch = git(root, "branch", "--show-current").stdout.strip() if (root / ".git").exists() else ""
    head = git(root, "rev-parse", "HEAD").stdout.strip() if branch else ""
    d.mkdir(parents=True, exist_ok=True)
    ignore = d / ".gitignore"
    if not ignore.exists():
        ignore.write_text("# agentdrop claims: local to this machine, never committed\n*\n", encoding="utf-8")
    data = {"ticket": tid, "title": title, "session": sid, "agent": agent_name(),
            "started": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
            "branch": branch, "head": head, "host": platform.node()}
    (d / f"{tid}.json").write_text(json.dumps(data, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")


def drop_claim(root: Path, tid: str, sid: str | None) -> bool:
    """Remove the claim on `tid` if this session holds it (any session's when `sid` is None)."""
    f = root / CLAIMS / f"{tid}.json"
    c = load_run(f) if f.is_file() else None
    if c is None or (sid is not None and c.get("session") not in (None, sid)):
        return False
    f.unlink(missing_ok=True)
    return True


class StoreTasks:
    """A project's tasks in the store, with the interface of `MarkdownTasks`: the same records for
    the board, the tickets page and the brief, derived from the store's fields; writes go to the
    store at once, each with an event naming its author. Every read opens the store afresh.

    Beyond that interface: `record` and `show` read one task, and `take`, `set_state`, `add_comment`,
    `ask`, `handin` and `new` change it (the `agentdrop task` commands); `released` and `judged` are
    what `release` and `accept` tell it."""

    def __init__(self, root: Path, cfg: dict | None = None):
        self.root, self._cfg, self.project = root, cfg, root.name

    @property
    def cfg(self) -> dict:
        if self._cfg is None:
            self._cfg = load_config()
        return self._cfg

    # --- reading ---------------------------------------------------------------------------------

    def records(self, tid: str | None = None) -> list[dict]:
        if not store_path().is_file():
            return []
        conn = store_open()
        try:
            return store_records(conn, self.project, tid)
        finally:
            conn.close()

    def present(self) -> bool:
        """The store has this project."""
        if not store_path().is_file():
            return False
        conn = store_open()
        try:
            return conn.execute("SELECT 1 FROM projects WHERE name = ?", (self.project,)).fetchone() is not None
        finally:
            conn.close()

    def russian(self, records: list[dict] | None = None) -> bool:
        recs = self.records() if records is None else records
        sample = " ".join(f"{r['title']} {r['text']}" for r in recs if r["kind"] == "ticket")[:3000] \
            or doc(self.root, "../AGENTS.md")[:3000]
        return len(re.findall(r"[а-яё]", sample, re.I)) > len(re.findall(r"[a-z]", sample, re.I))

    def _images(self, r: dict) -> list[str]:
        return item_images(self.root, "\n".join([r["title"], r["source"], r["text"], *(c["text"] for c in r["thread"])]))

    def _board(self, r: dict, words: list[str], ru: bool, full: bool) -> dict:
        """A ticket as `MarkdownTasks.tickets` gives it: which group it is in comes from its state."""
        first = r["text"].split("\n\n", 1)[0]
        said = [c for c in r["thread"] if c["author"]]
        state, waits = r["state"], r["waits"]
        if state in ("waiting_you", "waiting_others") and not waits:
            waits = STATE_NAMES[state][ru]
        t = {
            "id": r["id"], "priority": r["priority"], "section": r["section"],
            "order": (section_rank(r["section"]), r["position"]), "title": r["title"], "why": r["source"],
            "context": "" if r["source"] else clip(first, 200), "waits": waits,
            "waits_owner": state == "waiting_you" if state in ("waiting_you", "waiting_others")
            else bool(waits and by_owner(waits, words)),
            "detail": clip(((f"{'Зачем' if ru else 'Why'}: {r['source']}. " if r["source"] else "") + first).strip(), 700),
            "images": self._images(r),
            "owner_last": bool(said and by_owner(said[-1]["author"], words)),
            "deferred": state == "deferred", "after": list(r["after"]), "mode": r["mode"],
            "last": thread_head(said[-1]) if said else "",
            "ask": r.get("ask") if state == "waiting_you" else None,   # the open question in parts
        }
        if full:
            t.update(body=r["text"], thread=[{"author": c["author"], "when": c["at"], "text": c["text"]} for c in r["thread"]],
                     doc=STORE_DOC, theme=r["theme"])
        return t

    def tickets(self, full: bool = False, records: list[dict] | None = None) -> list[dict]:
        """The open tickets (every state but done) in their order, with the board's fields."""
        recs = self.records() if records is None else records
        words, ru = owner_words(self.cfg), self.russian(recs)
        return [self._board(r, words, ru, full) for r in recs if r["kind"] == "ticket" and r["state"] != "done"]

    def ticket_text(self, tid: str) -> str:
        """The task in full, written as a markdown item (the judge reads it); "" when there is none."""
        r = self.record(tid)
        return self.render(r) if r else ""

    def render(self, r: dict) -> str:
        ru = self.russian()
        marks = {"auto": "[автономно]" if ru else "[autonomous]", "human": "[с человеком]" if ru else "[with owner]"}
        if r["kind"] == "ticket":
            head = r["id"] + (f" ({r['priority']})" if r["priority"] else "") + (f" [{r['theme']}]" if r["theme"] else "")
            head += f" {marks[r['mode']]}" if r["mode"] else ""
            first = f"**{head}. {r['title']}.**"
        else:
            first = f"**{r['title']}.**"
        if r["source"]:
            first += f" {'Зачем' if ru else 'Why'}: {r['source']}."
        if r["after"]:
            first += f" {'После' if ru else 'After'}: {', '.join(r['after'])}."
        if r["waits"]:
            first += f" {r['waits']}"
        lines = [first] + (["", r["text"]] if r["text"] else [])
        if r["thread"]:
            lines.append("")
        for c in r["thread"]:
            if not c["author"]:
                lines.append(f"_{c['text']}_")
                continue
            head, *rest = c["text"].split("\n") or [""]
            lines.append(f"> **{c['author']}" + (f", {c['at']}" if c["at"] else "") + f":** {head}")
            lines += [f"> {x}" for x in rest]
        return "\n".join(lines)

    def question_items(self, records: list[dict] | None = None) -> list[dict]:
        """Every question with its group, as `MarkdownTasks.question_items` gives them: "closed" (done),
        "people" (waits for others), "revertible", "deferred", "turn" (the agent's move) or "owner"."""
        recs = self.records() if records is None else records
        words, out = owner_words(self.cfg), []
        for r in recs:
            if r["kind"] != "question":
                continue
            said = [c for c in r["thread"] if c["author"]]
            state = r["state"]
            if state == "done":
                group = "closed"
            elif state == "waiting_others":
                group = "people"
            elif REVERT_RE.search(r["section"]) or REVERT_RE.search(r["text"][:300]):
                group = "revertible"
            elif state == "deferred":
                group = "deferred"
            elif state in ("queued", *HOLDS) or (said and by_owner(said[-1]["author"], words)):
                group = "turn"
            else:
                group = "owner"
            title = Q_PREFIX.sub("", r["title"])
            out.append({"group": group, "path": r["section"], "key": question_key(title), "title": title,
                        "text": self.render(r), "body": r["text"], "comments": [(c["author"], thread_head(c)) for c in said],
                        "id": r["id"], "record": r})
        return out

    def questions(self, full: bool = False) -> dict:
        """The owner's open questions, as `MarkdownTasks.questions` gives them."""
        recs = self.records()
        res = {"waiting": [], "your_turn": [], "revertible": 0, "people": 0, "deferred": 0}
        pages = []
        for q in self.question_items(recs):
            group, r, title = q["group"], q["record"], q["title"]
            if group in ("people", "revertible", "deferred"):
                res[group] += 1
                continue
            if group not in ("turn", "owner"):
                continue
            said = [c for c in r["thread"] if c["author"]]
            thread = [{"author": c["author"], "when": c["at"], "text": c["text"]} for c in r["thread"]]
            page = {"key": q["key"], "id": r["id"], "state": group, "title": title, "pick": "",
                    "images": self._images(r), "body": r["text"], "thread": thread, "doc": STORE_DOC,
                    "ask": r.get("ask") if group == "owner" else None}
            if group == "turn":
                res["your_turn"].append(clip(title.rstrip(". "), 90))
                pages.append(page)
                continue
            reco = RECO_RE.search(r["text"]) or RECO_RE.search("\n".join(c["text"] for c in said))
            para = re.split(r"\n\s*\n|\n\s*>", r["text"], maxsplit=1)[0]
            item = {"title": clip(title.rstrip(". "), 160), "context": clip(para, 220),
                    "pick": clip(reco.group(0), 200) if reco else "", "thread": len(said),
                    "doc": STORE_DOC, "key": f"**{q['key']}**", "detail": clip(r["text"], 700),
                    "last": thread_head(said[-1]) if said else "", "images": page["images"], "ask": page["ask"]}
            res["waiting"].append(item)
            pages.append({**page, "title": item["title"], "pick": item["pick"]})
        if full:   # the waiting ones first, then those the agent has to act on, as the markdown page lists them
            res["items"] = [p for p in pages if p["state"] == "owner"] + [p for p in pages if p["state"] == "turn"]
        return res

    def done(self) -> list[dict]:
        """Tickets done: those accepted in the store, newest first, then those imported from the log."""
        out = []
        for r in self.records():
            if r["kind"] != "ticket" or r["state"] != "done":
                continue
            m = re.match(r"LOG\.md (\S+)", r["source"])
            when = parse_time(r["updated"]) or dt.datetime.now().astimezone()
            out.append((bool(m), -when.timestamp() if not m else 0, r["position"],
                        {"id": r["id"], "title": r["title"], "day": m.group(1) if m else when.strftime("%d.%m"),
                         "text": r["text"]}))
        return [x[-1] for x in sorted(out, key=lambda x: x[:3])]

    def record(self, tid: str) -> dict | None:
        """One task by its id ("B12", "12", "q1a2b3c") or a question's key or title."""
        want = tid.strip().strip("*").strip()
        recs = self.records()
        for r in recs:
            if r["id"] in (want, ticket_id(want)):
                return r
        for r in recs:
            title = Q_PREFIX.sub("", r["title"])
            if r["kind"] == "question" and want.rstrip(". ") in (title, question_key(title), r["title"]):
                return r
        return None

    def show(self, r: dict) -> dict:
        """A task with what an agent needs to work on it: its links both ways, the files it names, its events."""
        conn = store_open()
        try:
            events = [dict(e) for e in conn.execute(
                "SELECT at, author, what, detail FROM events WHERE project = ? AND task = ? ORDER BY id",
                (self.project, r["id"]))]
            before = [x[0] for x in conn.execute("SELECT task FROM links WHERE project = ? AND after = ? ORDER BY task",
                                                 (self.project, r["id"]))]
            brief = lambda i: next(({"id": x["id"], "title": x["title"], "state": x["state"]}
                                    for x in store_records(conn, self.project, i)), {"id": i, "title": "", "state": ""})
            after, before = [brief(i) for i in r["after"]], [brief(i) for i in before]
        finally:
            conn.close()
        text = "\n".join([r["title"], r["source"], r["text"], *(c["text"] for c in r["thread"])])
        docs = []
        for name in re.findall(r"[\w./-]+\.(?:md|txt|json|csv|py|js|html)\b", text):
            for base in (self.root, self.root / "docs"):
                f = (base / name).resolve()
                if f.is_file() and self.root.resolve() in f.parents:
                    rel = f.relative_to(self.root.resolve()).as_posix()
                    if rel not in docs:
                        docs.append(rel)
                    break
        images = [Path(x).relative_to(self.root.resolve()).as_posix() for x in self._images(r)]
        return {**r, "after": after, "before": before, "docs": docs + images, "events": events}

    # --- writing ---------------------------------------------------------------------------------

    @contextlib.contextmanager
    def _write(self):
        """One transaction that holds the store's write lock from the start, so two sessions never
        decide on the same state at once."""
        conn = store_open()
        conn.isolation_level = None
        try:
            conn.execute("BEGIN IMMEDIATE")
            yield conn
            conn.execute("COMMIT")
        except BaseException:
            if conn.in_transaction:
                conn.execute("ROLLBACK")
            raise
        finally:
            conn.close()

    def _event(self, conn, tid: str, author: str, what: str, detail: dict) -> None:
        conn.execute("INSERT INTO events (at, author, project, task, what, detail) VALUES (?, ?, ?, ?, ?, ?)",
                     (dt.datetime.now().astimezone().isoformat(timespec="seconds"), author, self.project, tid, what,
                      json.dumps(detail, ensure_ascii=False)))

    def _one(self, conn, tid: str) -> dict | None:
        return next(iter(store_records(conn, self.project, tid)), None)

    def _state(self, conn, r: dict, state: str, author: str, waits: str | None = None) -> None:
        waits = r["waits"] if waits is None else waits
        if state == r["state"] and waits == r["waits"]:
            return
        conn.execute("UPDATE tasks SET state = ?, waits = ?, updated = ? WHERE project = ? AND id = ?",
                     (state, waits, dt.datetime.now().astimezone().isoformat(timespec="seconds"), self.project, r["id"]))
        detail = {"state": [r["state"], state]}
        if waits != r["waits"]:
            detail["waits"] = [r["waits"], waits]
        self._event(conn, r["id"], author, "state", detail)
        r["state"], r["waits"] = state, waits

    def _comment(self, conn, tid: str, author: str, text: str, when: str | None = None, event_author: str | None = None,
                 ask: dict | None = None) -> int:
        n = conn.execute("SELECT COALESCE(MAX(n) + 1, 0) FROM comments WHERE project = ? AND task = ?",
                         (self.project, tid)).fetchone()[0]
        c = {"author": author, "at": when or dt.datetime.now().strftime("%d.%m %H:%M"), "text": text.strip()}
        conn.execute("INSERT INTO comments (project, task, n, author, at, text, ask) VALUES (?, ?, ?, ?, ?, ?, ?)",
                     (self.project, tid, n, c["author"], c["at"], c["text"],
                      json.dumps(ask, ensure_ascii=False) if ask else ""))
        if ask:
            c["ask"] = ask
        conn.execute("UPDATE tasks SET updated = ? WHERE project = ? AND id = ?",
                     (dt.datetime.now().astimezone().isoformat(timespec="seconds"), self.project, tid))
        self._event(conn, tid, event_author or author, "comment", c)
        return n

    def _resolve(self, tid: str) -> str:
        r = self.record(tid)
        return r["id"] if r else ticket_id(tid)

    def take(self, tid: str | None, sid: str, author: str, force: bool = False) -> tuple[dict | None, str]:
        """Claim one task for this session and put it in work: `tid`, or the first one that is the agent's
        move (the owner answered) or next up. Refused when another session's claim holds it. Checked
        and written under the store's write lock, so of two sessions taking at once only one gets it."""
        stale_h = float(self.cfg.get("stale_hours", STALE_HOURS))
        with self._write() as conn:
            claims = {c.get("ticket"): c for c in read_claims(self.root)}
            held = {t for t, c in claims.items() if c.get("session") != sid}
            if tid is None:
                recs = store_records(conn, self.project)
                b = sort_tickets(self.tickets(records=recs), held)
                pick = next((t for t in b["turn"] + b["free"] if t["mode"] != "human"), None)
                if pick is None:
                    return None, "nothing to take: every open task waits for someone, for another task, or is held"
                tid = pick["id"]
            else:
                tid = self._resolve(tid)
            r = self._one(conn, tid)
            if r is None:
                return None, f"no task {tid} in {self.project}"
            if r["state"] == "done":
                return None, f"{tid} is done already"
            other = claims.get(tid)
            if other and other.get("session") not in (None, sid) and not force:
                idle = claim_activity(self.root, other)
                started = other.get("started", "?")[:16].replace("T", " ")
                note = " (stale: --force takes it over)" if idle > stale_h * 3600 else ""
                return None, (f"{tid} is held by {other.get('agent', '')} {other.get('session', '')[:8]} since {started}, "
                              f"last activity {age(idle, False)} ago{note}. Take another task.")
            write_claim(self.root, tid, r["title"], sid)
            self._state(conn, r, "running", author, "")
            self._event(conn, tid, author, "taken", {"session": sid})
        return self.record(tid), ""

    def set_state(self, tid: str, state: str, author: str, note: str = "", after: list[str] | None = None,
                  who: str | None = None) -> dict:
        """Move a task to `state`. A note says whom or what a waiting task waits for (else it goes in the thread)."""
        with self._write() as conn:
            r = self._one(conn, self._resolve(tid))
            if r is None:
                raise KeyError(tid)
            if after:
                new = [x for x in dict.fromkeys(ticket_id(a) for a in after) if x not in r["after"] and x != r["id"]]
                conn.executemany("INSERT INTO links (project, task, after) VALUES (?, ?, ?)",
                                 [(self.project, r["id"], x) for x in new])
                if new:
                    self._event(conn, r["id"], author, "links", {"after": [r["after"], sorted(r["after"] + new)]})
            waiting = state in ("waiting_you", "waiting_others")
            waits = (clip(note, 110) if note else r["waits"] or STATE_NAMES[state][self.russian()]) if waiting else ""
            if note and not waiting:
                self._comment(conn, r["id"], who or author, note, event_author=author)
            self._state(conn, r, state, author, waits)
        return self.record(r["id"])

    def add_comment(self, tid: str, author: str, text: str, event_author: str | None = None,
                    when: str | None = None) -> dict:
        """A comment in the task's thread; the owner's answer to a task that waits for them makes it the agent's move."""
        with self._write() as conn:
            r = self._one(conn, self._resolve(tid))
            if r is None:
                raise KeyError(tid)
            self._comment(conn, r["id"], author, text, when, event_author=event_author)
            if by_owner(author, owner_words(self.cfg)) and r["state"] == "waiting_you":   # answered: the agent's move
                self._state(conn, r, "queued", event_author or author, "")
        return self.record(r["id"])

    def ask(self, tid: str, author: str, ask: dict, event_author: str | None = None) -> dict:
        """A question for the owner under the task, in parts (`ask_parts`): it goes in the thread as words with
        the parts beside them, and the task waits for them."""
        text = ask_text(ask, self.russian())
        with self._write() as conn:
            r = self._one(conn, self._resolve(tid))
            if r is None:
                raise KeyError(tid)
            self._comment(conn, r["id"], author, text, event_author=event_author, ask=ask)
            self._state(conn, r, "waiting_you", event_author or author, clip(ask["q"], 110))
        return self.record(r["id"])

    def handin(self, tid: str, author: str, note: str = "", event_author: str | None = None) -> dict:
        with self._write() as conn:
            r = self._one(conn, self._resolve(tid))
            if r is None:
                raise KeyError(tid)
            if note:
                self._comment(conn, r["id"], author, note, event_author=event_author)
            self._state(conn, r, "accepting", event_author or author, "")
        return self.record(r["id"])

    def new(self, title: str, author: str, kind: str = "ticket", text: str = "", why: str = "", priority: str = "",
            theme: str = "", mode: str = "", after: list[str] | None = None, section: str = "",
            state: str | None = None, top: bool = False) -> dict:
        """File a new task: the next free B-number (never reused), or a question «Решить: …» for the owner."""
        ru = self.russian()
        after = list(dict.fromkeys(ticket_id(a) for a in after or []))
        now = dt.datetime.now().astimezone().isoformat(timespec="seconds")
        with self._write() as conn:
            conn.execute("INSERT OR IGNORE INTO projects (name, root) VALUES (?, ?)", (self.project, str(self.root)))
            ids = [x[0] for x in conn.execute("SELECT id FROM tasks WHERE project = ?", (self.project,))]
            if kind == "ticket":
                n = max([int(m.group(1)) for i in ids if (m := re.match(r"B(\d+)", i))] + [0]) + 1
                tid, priority = f"B{n}", priority or "P2"
                state = state or ("waiting_task" if after else "queued")
                if not section:
                    k = {"P0": 0, "P1": 0, "P2": 1}.get(priority, 2)
                    section = [("Now", "Сейчас"), ("Next", "Дальше"), ("Later", "Потом")][k][ru]
            else:
                title = ("Решить: " if ru else "Decide: ") + Q_PREFIX.sub("", title).rstrip(". ")
                tid, k = "q" + sha(title.encode())[:6], 1
                while tid in ids:
                    k += 1
                    tid = f"q{sha(title.encode())[:6]}-{k}"
                state = state or "waiting_you"
            pos = conn.execute(f"SELECT COALESCE({'MIN(position) - 1' if top else 'MAX(position) + 1'}, 0) FROM tasks "
                               "WHERE project = ? AND kind = ?", (self.project, kind)).fetchone()[0]
            rec = {"kind": kind, "title": clip(title.rstrip(". "), 160), "text": text.strip(), "source": why.strip(),
                   "state": state, "priority": priority if kind == "ticket" else "", "theme": theme, "mode": mode,
                   "waits": "", "section": section, "position": pos}
            conn.execute(f"INSERT INTO tasks (project, id, {', '.join(STORE_FIELDS)}, created, updated) "
                         f"VALUES (?, ?, {', '.join('?' * len(STORE_FIELDS))}, ?, ?)",
                         (self.project, tid, *(rec[f] for f in STORE_FIELDS), now, now))
            conn.executemany("INSERT INTO links (project, task, after) VALUES (?, ?, ?)", [(self.project, tid, x) for x in after])
            self._event(conn, tid, author, "created", {**rec, "after": after})
        return self.record(tid)

    def journal(self, tid: str, author: str, what: str, detail: dict) -> None:
        """An event in the task's history that changes nothing else: a run started or stopped."""
        with self._write() as conn:
            self._event(conn, self._resolve(tid), author, what, detail)

    def released(self, tid: str, author: str) -> None:
        """`agentdrop release`: a task still in work goes back to the queue when its session lets go."""
        with self._write() as conn:
            r = self._one(conn, self._resolve(tid))
            if r and r["state"] == "running":
                self._state(conn, r, "queued", author)

    def judged(self, tid: str, verdict: str, summary: str, final: bool) -> None:
        """`agentdrop accept`'s verdict: PASS is done, a reject goes back to work, the last reject or
        a judge who can't decide go to the owner. The judge's summary goes in the thread."""
        with self._write() as conn:
            r = self._one(conn, self._resolve(tid))
            if r is None:
                return
            said = f"{verdict}: {summary}"
            if summary and not (r["thread"] and r["thread"][-1]["text"] == said):   # the same verdict again: once
                self._comment(conn, r["id"], "judge", said)
            if verdict == "PASS":
                self._state(conn, r, "done", "judge", "")
            elif verdict == "REJECT" and not final:
                self._state(conn, r, "running", "judge", "")
            else:
                self._state(conn, r, "waiting_you", "judge", clip(summary, 110) if summary else None)

    # --- the owner's answers from Telegram (`MarkdownTasks.comment`) -------------------------------

    def comment(self, ref: dict, author: str, when: str, text: str) -> dict:
        """The owner's words under the task, or as a new question on top of the open ones (ref kind
        "brief" or "project", or the task is done or gone). An answer to a task that waits for the
        owner puts it back in the queue: the agent's move."""
        r = self.record(ref.get("key", "")) if ref["kind"] not in ("brief", "project") else None
        if r and r["state"] != "done":
            after = self.add_comment(r["id"], author, text, when=when)
            return {"how": "saved", "path": f"{self.root}/{r['id']}", "lines": [], "task": r["id"],
                    "n": len(after["thread"]) - 1, "was": r["state"] if after["state"] != r["state"] else "", "next": ref}
        ru = bool(ref.get("ru"))
        if ref["kind"] in ("brief", "project"):
            title = (BRIEF["about_item"][ru].format(title=clip(ref["title"], 60), when=when)
                     if ref["kind"] == "project" and ref.get("item_title") else BRIEF["brief_item"][ru].format(when=when))
            how = "noted"
        else:
            title, how = BRIEF["new_item"][ru].format(title=ref["title"]), "moved"
        q = self.new(title, author, kind="question", state="queued", top=True)   # the owner wrote last: the agent's move
        with self._write() as conn:
            n = self._comment(conn, q["id"], author, text, when)
        return {"how": how, "path": f"{self.root}/{q['id']}", "lines": [], "task": q["id"], "n": n, "created": True,
                "next": {**ref, "kind": "question", "doc": STORE_DOC, "key": f"**{q['id']}**", "code": "",
                         "title": q["title"]}}

    def take_back(self, placed: dict) -> bool:
        """Remove what `comment` added, if it is still the last word there."""
        tid, n = placed.get("task"), placed.get("n")
        if tid is None:
            return False
        with self._write() as conn:
            last = conn.execute("SELECT MAX(n) FROM comments WHERE project = ? AND task = ?", (self.project, tid)).fetchone()[0]
            if last != n:
                return False
            conn.execute("DELETE FROM comments WHERE project = ? AND task = ? AND n = ?", (self.project, tid, n))
            r = self._one(conn, tid)
            if placed.get("was") and r and r["state"] == "queued":   # the answer had made it the agent's move
                self._state(conn, r, placed["was"], "agentdrop")
            if placed.get("created") and n == 0:
                conn.execute("DELETE FROM links WHERE project = ? AND task = ?", (self.project, tid))
                conn.execute("DELETE FROM tasks WHERE project = ? AND id = ?", (self.project, tid))
            self._event(conn, tid, "agentdrop", "taken back", {"comment": n, "task_removed": bool(placed.get("created"))})
        return True


def print_task(t: dict, ru: bool) -> None:
    """A task as `agentdrop task take` and `show` print it: what an agent needs, not the backlog."""
    name = lambda s: f"{s} ({STATE_NAMES[s][ru]})" if s in STATE_NAMES else s
    head = t["id"] + (f", {t['priority']}" if t["priority"] else "") + (f", [{t['theme']}]" if t["theme"] else "")
    print(f"{t['title']} ({head})")
    print(f"state: {name(t['state'])}" + (f"; waits: {t['waits']}" if t["waits"] else "")
          + (f"; mode: {t['mode']}" if t["mode"] else ""))
    if t["source"]:
        print(f"why: {t['source']}")
    for key, word in (("after", "after (waits for)"), ("before", "before (these wait for it)")):
        if t[key]:
            print(f"{word}: " + "; ".join(f"{x['id']} {clip(x['title'], 60)} [{name(x['state'])}]" for x in t[key]))
    if t["docs"]:
        print("files it names: " + ", ".join(t["docs"]))
    if t["text"]:
        print("\n" + t["text"])
    if t["thread"]:
        print("\nthread:")
        for c in t["thread"]:
            print(f"- {c['author']}, {c['at']}: {c['text']}" if c["author"] else f"- {c['text']}")
    ev = t["events"][-8:]
    if ev:
        print("\nhistory" + (f" (last {len(ev)} of {len(t['events'])})" if len(t["events"]) > len(ev) else "") + ":")
        for e in ev:
            d = json.loads(e["detail"] or "{}")
            what = e["what"] + (f" {d['state'][0]} → {d['state'][1]}" if e["what"] == "state" else "")
            print(f"- {e['at'][:16].replace('T', ' ')} {e['author']}: {what}")


def cmd_task(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="agentdrop task",
                                description="The tasks of a project that lives in the store (`tasks.<folder> = store` "
                                            "in ~/.agentdrop/config): take one, change its state, ask the owner, hand "
                                            "it in, file a new one. Every change is journaled with its author.")
    sub = p.add_subparsers(dest="action", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--root", default=".", help="Project directory (default: the current one)")
    common.add_argument("--session", help="Session id (default: $AGENTDROP_SESSION, $CLAUDE_CODE_SESSION_ID, …)")
    common.add_argument("--as", dest="author", help="Who writes, in the thread and the journal (default: this agent)")
    common.add_argument("--json", action="store_true", help="Machine-readable output")
    sub.add_parser("where", parents=[common], help="Where this project's tasks live: the store or docs/TODO.md")
    sp = sub.add_parser("take", parents=[common], help="Take one task for this session: the one named, or the next "
                                                        "that is the agent's move; prints it with its thread, links and files")
    sp.add_argument("task", nargs="?", help="B12, or a question's id; default: the next one")
    sp.add_argument("--force", action="store_true", help="Take over another session's stale claim")
    sp = sub.add_parser("show", parents=[common], help="Print one task without taking it")
    sp.add_argument("task")
    sp = sub.add_parser("state", parents=[common], help="Move a task to another state")
    sp.add_argument("task")
    sp.add_argument("state", help="queued, running, waiting_you, waiting_task, waiting_others, accepting, done, "
                                  "deferred (or their names: «Ждёт других людей», …)")
    sp.add_argument("note", nargs="?", default="", help="For a waiting state: whom or what it waits for; else a comment")
    sp.add_argument("--after", action="append", default=[], help="With waiting_task: the task it waits for (repeatable)")
    sp = sub.add_parser("ask", parents=[common], help="A question for the owner under the task, in parts: it reads in "
                                                       "five seconds and is answered by one tap; the task then waits for "
                                                       "them (works in a markdown project too: a new item in QUESTIONS.md)",
                        epilog='example: agentdrop task ask B12 "Which layout goes to the home page?" --option "Two '
                               'columns" --option "One column" --pick 1 --details "specs/B12.md: …" --design '
                               '--pic docs/shots/two.png --pic docs/shots/one.png')
    sp.add_argument("task")
    sp.add_argument("text", metavar="question", help=f"The question itself, one line, at most {ASK_Q_MAX} characters; "
                                                     "no file paths or task codes")
    sp.add_argument("--option", action="append", default=[], help=f"An option, {ASK_OPTS[0]}–{ASK_OPTS[1]} of them, "
                                                                  f"each at most {ASK_OPT_MAX} characters")
    sp.add_argument("--pick", default="", help="The option you would take: its number (1..) or letter")
    sp.add_argument("--details", default="", help="Anything else, any length: context, numbers, file paths, task codes")
    sp.add_argument("--design", action="store_true", help="About how something looks (a screen, layout, colours): "
                                                          "needs pictures")
    sp.add_argument("--pic", action="append", default=[], help="A picture for each option, in their order "
                                                               "(a file inside the project)")
    sp.add_argument("--before", default="", help="With --after: a before/after pair instead of --pic")
    sp.add_argument("--after", default="", help="With --before: the picture of how it will be")
    sp = sub.add_parser("comment", parents=[common], help="Add to the task's thread")
    sp.add_argument("task")
    sp.add_argument("text")
    sp = sub.add_parser("handin", parents=[common], help="The work is done and committed: to acceptance "
                                                          "(then run `agentdrop accept`)")
    sp.add_argument("task")
    sp.add_argument("note", nargs="?", default="", help="What was done, for the thread")
    sp = sub.add_parser("new", parents=[common], help="File a new task (or --question for the owner); prints its id")
    sp.add_argument("title")
    sp.add_argument("--text", default="", help="The body: what exactly, the source, the numbers")
    sp.add_argument("--why", default="", help="Why, in the owner's words, quoted")
    sp.add_argument("--priority", default="", choices=["", "P0", "P1", "P2", "P3"])
    sp.add_argument("--theme", default="")
    sp.add_argument("--mode", default="", choices=["", "auto", "human"], help="auto: an unattended run may do it; "
                                                                             "human: only with the owner")
    sp.add_argument("--after", action="append", default=[], help="A task it waits for (repeatable)")
    sp.add_argument("--question", action="store_true", help="A question for the owner, not a ticket")
    a = p.parse_args(argv)
    root, cfg = find_root(Path(a.root)), load_config()
    src = tasks_of(root, cfg)
    if a.action == "where":
        store = isinstance(src, StoreTasks)
        info = {"project": root.name, "root": str(root), "tasks": "store" if store else "markdown",
                "store": str(store_path()) if store else None, "present": src.present()}
        if a.json:
            print(json.dumps(info, ensure_ascii=False))
        elif store:
            print(f"{root.name}: tasks live in the store ({store_path()}); work through `agentdrop task`, "
                  "never edit docs/TODO.md or docs/QUESTIONS.md"
                  + ("" if info["present"] else f". The store has no {root.name} yet: `agentdrop store import --force`"))
        else:
            print(f"{root.name}: tasks live in docs/TODO.md and docs/QUESTIONS.md")
        return 0 if store else 1
    if a.action == "ask":   # the form is checked the same way wherever the question goes
        ask, bad = ask_parts(root, a.text, a.option, a.pick, a.details, a.pic, a.before, a.after, a.design,
                             src.russian())
        if bad:
            print("agentdrop task ask: the question was not asked; fix and ask again:\n"
                  + "\n".join(f"- {b}" for b in bad), file=sys.stderr)
            return 2
        if not isinstance(src, StoreTasks):
            placed = src.ask(a.task, ask)
            print(f"✓ QUESTIONS.md: {placed['key'].strip('*')} [{STATE_NAMES['waiting_you'][src.russian()]}]")
            return 0
    if not isinstance(src, StoreTasks):
        print(f"agentdrop task: {root.name} keeps its tasks in docs/TODO.md (no `tasks.{root.name} = store` in the "
              f"config); use `agentdrop claim` and the docs", file=sys.stderr)
        return 2
    if not src.present():
        print(f"agentdrop task: the store {store_path()} has no project {root.name}; "
              f"`agentdrop store import --force {root}` first", file=sys.stderr)
        return 2
    sid = session_id(a.session)
    who = a.author or agent_name()
    author = who if a.author else f"{who} {sid}"   # the journal names the session; the thread, the agent
    ru = src.russian()

    def out(t: dict | None) -> int:
        full = src.show(t)
        if a.json:
            print(json.dumps(full, ensure_ascii=False, indent=1))
        else:
            print_task(full, ru)
        return 0

    try:
        if a.action == "take":
            t, why = src.take(a.task, sid, author, force=a.force)
            if t is None:
                print(f"agentdrop task take: {why}", file=sys.stderr)
                return 1
            return out(t)
        if a.action == "show":
            t = src.record(a.task)
            if t is None:
                raise KeyError(a.task)
            return out(t)
        if a.action == "new":
            t = src.new(a.title, author, kind="question" if a.question else "ticket", text=a.text, why=a.why,
                        priority=a.priority, theme=a.theme, mode=a.mode, after=a.after)
            if a.json:
                print(json.dumps(src.show(t), ensure_ascii=False, indent=1))
            else:
                print(f"✓ {t['id']}: {t['title']} [{STATE_NAMES[t['state']][ru]}]")
            return 0
        if a.action == "state":
            state = state_of(a.state)
            if state is None:
                print(f"agentdrop task state: no state «{a.state}»; one of {', '.join(STORE_STATES)}", file=sys.stderr)
                return 2
            t = src.set_state(a.task, state, author, a.note, a.after, who=who)
        elif a.action == "ask":
            t = src.ask(a.task, who, ask, event_author=author)
        elif a.action == "comment":
            t = src.add_comment(a.task, who, a.text, event_author=author)
        else:
            t = src.handin(a.task, who, a.note, event_author=author)
    except KeyError:
        print(f"agentdrop task: no task {a.task} in {root.name}", file=sys.stderr)
        return 2
    if t["state"] not in HOLDS:   # the run lets go of a task that now waits, or is done
        drop_claim(root, t["id"], sid)
    if a.json:
        print(json.dumps(src.show(t), ensure_ascii=False, indent=1))
    else:
        print(f"✓ {t['id']}: {STATE_NAMES[t['state']][ru]}" + (f" — {t['waits']}" if t["waits"] else ""))
        if a.action == "handin":
            print(f"next: `agentdrop accept {t['id']}` (checks, then a fresh judge)")
    return 0


